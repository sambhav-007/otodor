    }
  ],
  "presets": [
    {
      "name": "OTODOR Shop by Category",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "custom_title": "Digital Locks",
            "tagline": "Premium secure locks engineered for wooden frames.",
            "grid_size": "large"
          }
        },
