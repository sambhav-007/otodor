{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Smart Living Section
     Lifestyle storytelling split-screen section with counters.
  ───────────────────────────────────────────────────────── */

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 3;
    background-color: transparent;
  }

  .otodor-smart-living {
    padding-block: var(--otodor-section-py);
  }

  .otodor-smart-living__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  /* Left: Lifestyle Image */
  .otodor-smart-living__media {
    position: relative;
    border-radius: var(--otodor-radius-2xl);
    overflow: hidden;
    aspect-ratio: 4/5;
    border: 1px solid var(--otodor-glass-border);
    box-shadow: var(--otodor-shadow-lg);
  }

  .otodor-smart-living__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Right: Storytelling & Stats */
  .otodor-smart-living__content {
    display: flex;
    flex-direction: column;
    gap: var(--otodor-space-xl);
  }

  .otodor-smart-living__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--otodor-space-lg);
    border-top: 1px solid var(--otodor-hairline);
    border-bottom: 1px solid var(--otodor-hairline);
    padding-vertical: var(--otodor-space-lg);
    padding-top: var(--otodor-space-lg);
    padding-bottom: var(--otodor-space-lg);
  }

  /* ─ Responsive overrides ────────────────────────────────── */
  @media (max-width: 990px) {
    .otodor-smart-living__grid {
      grid-template-columns: 1fr;
      gap: var(--otodor-space-xl);
    }
    .otodor-smart-living__media {
      aspect-ratio: 16/10;
    }
  }

  @media (max-width: 599px) {
    .otodor-smart-living__stats {
      grid-template-columns: 1fr;
      gap: var(--otodor-space-md);
      padding-vertical: var(--otodor-space-md);
    }
  }
{%- endstyle -%}

<section
  id="otodor-smart-living-{{ section.id }}"
  class="otodor-smart-living"
  data-otodor-section="smart-living"
  aria-labelledby="otodor-smart-living-title-{{ section.id }}"
>
  <div class="otodor-container">
    <div class="otodor-smart-living__grid">
      
      {%- comment -%} Left Column: Image {%- endcomment -%}
      <div class="otodor-smart-living__media" data-otodor-reveal="scale-in" data-otodor-parallax="0.2">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image.alt | default: 'Smart Lock installed on door',
              sizes: '(min-width: 991px) 50vw, 90vw',
              widths: '400, 600, 800, 1000, 1200'
          }}
        {%- else -%}
          <img
            src="{{ 'otodor-lifestyle-placeholder.jpg' | asset_url }}"
            alt="Sleek OTODOR smart lock installed on an elegant dark oak entrance door"
            loading="lazy"
            width="800"
            height="1000"
          >
        {%- endif -%}
      </div>

      {%- comment -%} Right Column: Copy & Stats {%- endcomment -%}
      <div class="otodor-smart-living__content" data-otodor-reveal="fade-up">
        
        <div class="otodor-section-header">
          <span class="otodor-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          <h2 class="otodor-heading-2" id="otodor-smart-living-title-{{ section.id }}">
            {{ section.settings.heading | escape }}<span class="otodor-accent">{{ section.settings.heading_accent | escape }}</span>
          </h2>
          {%- if section.settings.description != blank -%}
            <p class="otodor-body-lg">{{ section.settings.description | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.quote_text != blank -%}
          <blockquote class="otodor-quote">
            {{ section.settings.quote_text | escape }}
          </blockquote>
        {%- endif -%}

        {%- comment -%} Statistics Row {%- endcomment -%}
        <div class="otodor-smart-living__stats">
          <div class="otodor-stat">
            <span
              class="otodor-stat__value"
              data-otodor-counter="500"
              data-counter-suffix="+"
            >
              500+
            </span>
            <span class="otodor-stat__label">Installations</span>
          </div>

          <div class="otodor-stat">
            <span
              class="otodor-stat__value"
              data-otodor-counter="4.9"
              data-counter-suffix="★"
            >
              4.9★
            </span>
            <span class="otodor-stat__label">Average Rating</span>
          </div>

          <div class="otodor-stat">
            <span
              class="otodor-stat__value"
              data-otodor-counter="24"
              data-counter-suffix="/7"
            >
              24/7
            </span>
            <span class="otodor-stat__label">Expert Support</span>
          </div>
        </div>

        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <div>
            <a href="{{ section.settings.cta_link }}" class="otodor-btn otodor-btn--primary">
              {{- section.settings.cta_label | escape -}}
              <span class="otodor-btn__icon" aria-hidden="true">
                {% render 'otodor-icon', name: 'arrow-right' %}
              </span>
            </a>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OTODOR Smart Living",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Modern Lifestyle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Refined living, automated "
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accented text",
      "default": "security."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every access point is a perfect statement of architectural harmony and convenience. OTODOR systems integrate seamlessly into premium homes, providing instant keyless entry and complete remote control."
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote text",
      "default": "Designed for spaces that demand the absolute best."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle Image",
      "info": "Upload a premium, high-quality photograph of an OTODOR lock installed in a modern interior."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Explore Flagships"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    }
  ],
  "presets": [
    {
      "name": "OTODOR Smart Living",
      "settings": {
        "eyebrow": "Modern Lifestyle",
        "heading": "Refined living, automated ",
        "heading_accent": "security.",
        "quote_text": "Designed for spaces that demand the absolute best."
      }
    }
  ]
}
{% endschema %}
