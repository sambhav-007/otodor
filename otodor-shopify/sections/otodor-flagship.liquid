{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Flagship Showcase
     Sticky-split product tour with moving hotspot.
     Desktop (>=1024px): pinned, product holds while spec
     chapters step through and a hotspot tracks the product.
     Mobile / reduced-motion: clean stacked layout.
  ───────────────────────────────────────────────────────── */

  #shopify-section-{{ section.id }} {
    background-color: {% if section.settings.color_scheme == 'light' %}var(--otodor-bg-light){% else %}#0B0B0B{% endif %};
  }

  .otodor-flagship {
    background-color: #0B0B0B;
    color: #ffffff;
    position: relative;
    overflow: hidden;
    padding: 5rem 1.5rem;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .otodor-flagship__inner {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    z-index: 1;
  }

  /* Single soft ambient bloom behind the product */
  .otodor-flagship__bloom {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(80vw, 640px);
    height: min(60vh, 560px);
    background: radial-gradient(ellipse at center, rgba(77, 166, 255, 0.10) 0%, transparent 68%);
    pointer-events: none;
    z-index: 0;
  }

  /* ─ Product stage ─────────────────────────────────────────── */
  .otodor-flagship__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .otodor-flagship__visual {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 26px rgba(77, 166, 255, 0.08));
  }

  .otodor-flagship__visual .flagship-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
  }

  /* When the scroll animation isn't driving (mobile / no-JS), show the intro image */
  .otodor-flagship__visual .flagship-slide[data-frame="0"] {
    opacity: 1;
  }

  /* Moving hotspot (desktop only) */
  .otodor-flagship__hotspot {
    position: absolute;
    width: 26px;
    height: 26px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(77, 166, 255, 0.7);
    border-radius: 50%;
    box-shadow: 0 0 14px rgba(77, 166, 255, 0.45);
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .otodor-flagship__hotspot::before {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: #4DA6FF;
    box-shadow: 0 0 10px rgba(77, 166, 255, 0.9);
  }

  .otodor-flagship__hotspot.is-on {
    animation: flagship-hotspot-pulse 2.1s ease-in-out infinite;
  }

  @keyframes flagship-hotspot-pulse {
    0%, 100% { box-shadow: 0 0 10px rgba(77, 166, 255, 0.35); }
    50% { box-shadow: 0 0 22px rgba(77, 166, 255, 0.65); }
  }

  /* ─ Content column ────────────────────────────────────────── */
  .otodor-flagship__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .otodor-flagship__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #4DA6FF;
  }

  .otodor-flagship__name {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(2rem, 7vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0.4rem 0 0;
  }

  .otodor-flagship__tagline {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.58);
    margin: 0.75rem 0 0;
    max-width: 46ch;
  }

  .flagship-spec {
    border-left: 2px solid rgba(77, 166, 255, 0.5);
    padding-left: 1rem;
  }

  .flagship-spec__label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #4DA6FF;
  }

  .flagship-spec__title {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0.2rem 0 0;
  }

  .flagship-spec__desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.58);
    margin: 0.3rem 0 0;
  }

  .otodor-flagship__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.8rem;
    border-radius: 99px;
    background: #ffffff;
    color: #0b0b0b;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    align-self: flex-start;
    margin-top: 1.5rem;
    transition: transform 200ms ease, background-color 200ms ease;
  }

  .otodor-flagship__cta:hover {
    background: #eaeaea;
    transform: scale(1.04);
  }

  /* Final frame's duplicate name/eyebrow only matter on desktop */
  .flagship-frame--final .otodor-flagship__eyebrow,
  .flagship-frame--final .otodor-flagship__name {
    display: none;
  }

  /* ─────────────────────────────────────────────────────────
     Desktop — pinned sticky-split (>=1024px)
     ───────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .otodor-flagship.js-animated {
      height: 100vh;
      padding: 0 clamp(2rem, 5vw, 5rem);
    }

    .otodor-flagship.js-animated .otodor-flagship__inner {
      height: 100%;
      max-width: 1360px;
      flex-direction: row;
      align-items: center;
      gap: 0;
    }

    .otodor-flagship.js-animated .otodor-flagship__stage {
      width: 54%;
      height: 100%;
      perspective: 1200px;
    }

    .otodor-flagship.js-animated .otodor-flagship__visual {
      max-width: min(40vw, 540px);
      transform-style: preserve-3d;
      will-change: transform, opacity;
    }

    .otodor-flagship.js-animated .otodor-flagship__content {
      width: 46%;
      height: 100%;
      display: block;
    }

    .otodor-flagship.js-animated .flagship-frame {
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      width: min(34vw, 460px);
      padding-right: 2rem;
      opacity: 0;
      pointer-events: none;
      will-change: transform, opacity;
    }

    .otodor-flagship.js-animated .flagship-frame--intro {
      opacity: 1;
    }

    .otodor-flagship.js-animated .flagship-spec {
      border-left: none;
      padding-left: 0;
    }

    .otodor-flagship.js-animated .flagship-spec__title {
      font-size: 1.7rem;
    }

    .otodor-flagship.js-animated .flagship-spec__desc {
      font-size: 1.02rem;
    }

    .otodor-flagship.js-animated .flagship-frame--final {
      pointer-events: auto;
    }

    .otodor-flagship.js-animated .flagship-frame--final .otodor-flagship__eyebrow,
    .otodor-flagship.js-animated .flagship-frame--final .otodor-flagship__name {
      display: block;
    }
  }

  /* ─ Reduced motion — static stack ─────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .otodor-flagship.js-animated {
      height: auto !important;
      padding: 5rem 1.5rem !important;
    }
    .otodor-flagship.js-animated .otodor-flagship__inner {
      flex-direction: column !important;
      height: auto !important;
    }
    .otodor-flagship.js-animated .flagship-frame {
      position: static !important;
      opacity: 1 !important;
      transform: none !important;
      width: auto !important;
    }
    .otodor-flagship.js-animated .otodor-flagship__hotspot {
      display: none !important;
    }
  }

  /* ─ Tablet & mobile (<1024) — clean static product layout ───
     No pin on phones: a pinned flagship fights the categories pin and
     hijacks the viewport. Stack it as a simple product page instead
     (image → name → specs → CTA), so it always sits after categories. */
  @media (max-width: 1023px) {
    .otodor-flagship__inner {
      flex-direction: column;
      gap: 2rem;
      max-width: 460px;
    }
    .otodor-flagship__visual {
      max-width: 300px;
      margin: 0 auto;
    }
    .otodor-flagship__hotspot {
      display: none;
    }
    /* Show only the intro product image in the static stack */
    .otodor-flagship__visual .flagship-slide { opacity: 0; }
    .otodor-flagship__visual .flagship-slide[data-frame="0"] { opacity: 1; }
    .otodor-flagship__content {
      align-items: center;
      text-align: center;
    }
    .flagship-frame {
      align-items: center;
      text-align: center;
    }
    .otodor-flagship__tagline {
      margin-left: auto;
      margin-right: auto;
    }
    .flagship-spec {
      border-left: none;
      padding-left: 0;
    }
    .otodor-flagship__cta {
      align-self: center;
    }
  }

  /* ─────────────────────────────────────────────────────────
     LIGHT MODE — Apple-style off-white product stage.
     The dark-lit render sits on a soft plinth with a real contact
     shadow instead of floating on flat white.
  ───────────────────────────────────────────────────────── */
  .otodor-flagship--light {
    background-color: var(--otodor-bg-light);
    color: var(--otodor-ink);
  }

  /* Soft lit floor behind the product */
  .otodor-flagship--light .otodor-flagship__bloom {
    background:
      radial-gradient(ellipse 60% 44% at 50% 64%, #ffffff 0%, rgba(255, 255, 255, 0) 70%),
      radial-gradient(ellipse 82% 64% at 50% 52%, var(--otodor-plinth) 0%, rgba(236, 234, 228, 0) 74%);
    opacity: 0.9;
  }

  /* Realistic contact shadow grounded under the product (behind slides) */
  .otodor-flagship--light .otodor-flagship__visual::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 3%;
    width: 74%;
    height: 15%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.24) 0%, rgba(0, 0, 0, 0.10) 46%, transparent 72%);
    filter: blur(7px);
    pointer-events: none;
  }

  /* Product casts a soft neutral shadow rather than a blue glow */
  .otodor-flagship--light .otodor-flagship__visual {
    filter: drop-shadow(0 20px 26px rgba(0, 0, 0, 0.16));
  }

  .otodor-flagship--light .otodor-flagship__eyebrow,
  .otodor-flagship--light .flagship-spec__label {
    color: var(--otodor-accent-on-light);
  }
  .otodor-flagship--light .otodor-flagship__name,
  .otodor-flagship--light .flagship-spec__title {
    color: var(--otodor-ink);
  }
  .otodor-flagship--light .otodor-flagship__tagline,
  .otodor-flagship--light .flagship-spec__desc {
    color: var(--otodor-ink-soft);
  }
  .otodor-flagship--light .flagship-spec {
    border-left-color: rgba(26, 120, 216, 0.45);
  }

  /* CTA inverts to ink so it pops on the light stage */
  .otodor-flagship--light .otodor-flagship__cta {
    background: var(--otodor-ink);
    color: #ffffff;
  }
  .otodor-flagship--light .otodor-flagship__cta:hover {
    background: #000000;
  }

  /* Hotspot uses the deeper accent for contrast on a light product */
  .otodor-flagship--light .otodor-flagship__hotspot {
    border-color: rgba(26, 120, 216, 0.8);
    box-shadow: 0 0 14px rgba(26, 120, 216, 0.35);
  }
  .otodor-flagship--light .otodor-flagship__hotspot::before {
    background: var(--otodor-accent-on-light);
    box-shadow: 0 0 10px rgba(26, 120, 216, 0.6);
  }
{%- endstyle -%}

<section
  id="otodor-flagship-{{ section.id }}"
  class="otodor-flagship{% if section.settings.color_scheme == 'light' %} otodor-flagship--light{% endif %}"
  data-otodor-section="flagship"
>
  <div class="otodor-flagship__bloom" aria-hidden="true"></div>

  <div class="otodor-flagship__inner">

    <!-- Product stage -->
    <div class="otodor-flagship__stage">
      <div class="otodor-flagship__visual" data-3d-slot="flagship">
        {%- comment -%} Frame 0 — intro image {%- endcomment -%}
        {%- if section.settings.product_image != blank -%}
          <img class="flagship-img flagship-slide" data-frame="0" src="{{ section.settings.product_image | image_url: width: 1000 }}" alt="{{ section.settings.flagship_name | escape }}" loading="lazy" width="1000" height="1000">
        {%- else -%}
          <img class="flagship-img flagship-slide" data-frame="0" src="{{ 'Sliding_gate_motor_45.png' | file_img_url: '1000x' }}" alt="{{ section.settings.flagship_name | escape }}" loading="lazy" width="1000" height="1000">
        {%- endif -%}

        {%- comment -%} Frames 1..N — one per spec (blank = empty, keeps previous image) {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' -%}
            {%- if block.settings.image != blank -%}
              <img class="flagship-img flagship-slide" data-frame="{{ forloop.index }}" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.flagship_name | escape }}" loading="lazy" width="1000" height="1000">
            {%- else -%}
              <span class="flagship-slide flagship-slide--empty" data-frame="{{ forloop.index }}" aria-hidden="true"></span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Final frame image {%- endcomment -%}
        {%- if section.settings.final_image != blank -%}
          <img class="flagship-img flagship-slide" data-frame="final" src="{{ section.settings.final_image | image_url: width: 1000 }}" alt="{{ section.settings.flagship_name | escape }}" loading="lazy" width="1000" height="1000">
        {%- endif -%}

        <div class="otodor-flagship__hotspot" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Content column: intro → specs → final -->
    <div class="otodor-flagship__content">

      <div class="flagship-frame flagship-frame--intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="otodor-flagship__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="otodor-flagship__name">{{ section.settings.flagship_name | escape }}</h2>
        {%- if section.settings.tagline != blank -%}
          <p class="otodor-flagship__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'spec' -%}
          <div
            class="flagship-frame flagship-spec"
            data-hx="{{ block.settings.hotspot_x }}"
            data-hy="{{ block.settings.hotspot_y }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.label != blank -%}
              <span class="flagship-spec__label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
            <h3 class="flagship-spec__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="flagship-spec__desc">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="flagship-frame flagship-frame--final">
        {%- if section.settings.eyebrow != blank -%}
          <span class="otodor-flagship__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="otodor-flagship__name">{{ section.settings.flagship_name | escape }}</h2>
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="otodor-flagship__cta">
            {{- section.settings.cta_label | escape -}}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  var section = document.getElementById('otodor-flagship-{{ section.id }}');
  if (!section) return;

  // Pinned sections break when the browser restores a mid-page scroll on
  // reload — the pin can get stuck fixed on screen, with other sections
  // scrolling over it. Reload from the top so ScrollTrigger always
  // calculates pin positions from a clean state.
  if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }

  function initFlagship() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      console.warn('[OTODOR] GSAP/ScrollTrigger not loaded — flagship uses static layout.');
      return;
    }
    // Ignore the mobile address-bar show/hide resize. Without this, the
    // changing 100vh recalculates pin positions mid-scroll and the pinned
    // flagship jumps up and overlaps the categories section.
    ScrollTrigger.config({ ignoreMobileResize: true });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Runs on all widths now — layout adapts to a vertical tour on phones via CSS.

    // Tear down any previous build (theme editor / hot reload) so a stale
    // pin never stays stuck on screen.
    ScrollTrigger.getAll().forEach(function (st) {
      if (st.trigger === section) st.kill(true);
    });
    section.classList.remove('js-animated');
    gsap.set(section.querySelectorAll(
      '.otodor-flagship__visual, .flagship-slide, .flagship-frame, ' +
      '.otodor-flagship__bloom, .otodor-flagship__hotspot'
    ), { clearProps: 'all' });

    // Mobile / tablet: no pinned scroll tour. Pinning the flagship on a
    // phone fights the categories pin and hijacks the viewport. The CSS
    // renders a clean static product layout instead.
    if (!window.matchMedia('(min-width: 1024px)').matches) return;

    section.classList.add('js-animated');

    var visual = section.querySelector('.otodor-flagship__visual');
    var slides = Array.prototype.slice.call(section.querySelectorAll('.flagship-slide'));
    var bloom = section.querySelector('.otodor-flagship__bloom');
    var hotspot = section.querySelector('.otodor-flagship__hotspot');
    var intro = section.querySelector('.flagship-frame--intro');
    var finalFrame = section.querySelector('.flagship-frame--final');
    var specs = Array.prototype.slice.call(section.querySelectorAll('.flagship-spec'));

    // ── Initial state ─────────────────────────────────────────
    gsap.set(visual, { opacity: 0, scale: 0.92, rotationY: -6 });
    // Stack of per-frame images: show the intro slide (frame 0), hide the rest
    gsap.set(slides, { opacity: 0 });
    var introSlide = section.querySelector('.flagship-slide[data-frame="0"]');
    if (introSlide) gsap.set(introSlide, { opacity: 1 });
    function showSlide(frameKey, time) {
      var target = section.querySelector('.flagship-slide[data-frame="' + frameKey + '"]');
      if (!target || target.classList.contains('flagship-slide--empty')) return; // keep current image
      slides.forEach(function (s) {
        tl.to(s, { opacity: s === target ? 1 : 0, duration: 0.6, ease: 'sine.inOut' }, time);
      });
    }
    gsap.set(bloom, { opacity: 0, scale: 0.9 });
    gsap.set(intro, { opacity: 1, y: 0 });
    gsap.set(specs, { opacity: 0, y: 24 });
    gsap.set(finalFrame, { opacity: 0, y: 24 });
    gsap.set(hotspot, { opacity: 0, left: '50%', top: '50%' });

    var tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=250%',
        scrub: 1,
        pin: true,
        anticipatePin: 1
      }
    });

    // ── Phase 1: Reveal ───────────────────────────────────────
    tl.to(bloom, { opacity: 1, scale: 1, duration: 1.0, ease: 'power3.out' }, 0);
    tl.to(visual, { opacity: 1, scale: 1, rotationY: 0, duration: 1.2, ease: 'power4.out' }, 0);

    // ── Phase 2: Tour ─────────────────────────────────────────
    var introOut = 1.6;
    tl.to(intro, { opacity: 0, y: -20, duration: 0.6, ease: 'power2.inOut' }, introOut);
    tl.to(hotspot, { opacity: 1, duration: 0.4, ease: 'power2.out' }, introOut);
    tl.call(function () { if (hotspot) hotspot.classList.add('is-on'); }, null, introOut);

    var specStart = introOut + 0.4;
    var specDur = 1.4;

    specs.forEach(function (spec, i) {
      var st = specStart + i * specDur;
      var hx = parseFloat(spec.getAttribute('data-hx'));
      var hy = parseFloat(spec.getAttribute('data-hy'));

      tl.to(spec, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, st);

      if (hotspot && !isNaN(hx) && !isNaN(hy)) {
        tl.to(hotspot, { left: hx + '%', top: hy + '%', duration: 0.7, ease: 'power3.inOut' }, st);
      }

      // Subtle product micro-rotation per chapter
      tl.to(visual, { rotationY: (i % 2 === 0 ? 4 : -4), duration: 0.9, ease: 'sine.inOut' }, st);

      // Optional angle cross-fade at the midpoint
      // Swap the product image to this spec's slide (data-frame = i + 1)
      showSlide(i + 1, st);

      // Fade this chapter out before the next (except the last)
      if (i < specs.length - 1) {
        tl.to(spec, { opacity: 0, y: -20, duration: 0.5, ease: 'power2.inOut' }, st + specDur - 0.35);
      }
    });

    // ── Phase 3: Close ────────────────────────────────────────
    var tEnd = specStart + specs.length * specDur;
    if (specs.length) {
      tl.to(specs[specs.length - 1], { opacity: 0, y: -20, duration: 0.5, ease: 'power2.inOut' }, tEnd - 0.2);
    }
    tl.to(hotspot, { opacity: 0, duration: 0.4, ease: 'power2.inOut' }, tEnd - 0.2);
    tl.call(function () { if (hotspot) hotspot.classList.remove('is-on'); }, null, tEnd);
    tl.to(visual, { rotationY: 0, scale: 1.02, duration: 0.9, ease: 'power3.out' }, tEnd);
    showSlide('final', tEnd);
    tl.to(finalFrame, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, tEnd + 0.15);
  }

  if (document.readyState === 'complete') {
    initFlagship();
  } else {
    window.addEventListener('load', initFlagship, { once: true });
  }

  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') {
      initFlagship();
    }
  });

  // Once images/fonts finish loading (which shift layout above this
  // section), recalc all pin positions so nothing ends up stuck.
  window.addEventListener('load', function () {
    if (typeof ScrollTrigger !== 'undefined') {
      requestAnimationFrame(function () { ScrollTrigger.refresh(); });
    }
  });

  // Rebuild when crossing the desktop/mobile breakpoint (desktop pins,
  // mobile is static) so a resize never leaves a stale pinned state.
  var flagshipMq = window.matchMedia('(min-width: 1024px)');
  var flagshipMqHandler = function () { initFlagship(); };
  if (flagshipMq.addEventListener) {
    flagshipMq.addEventListener('change', flagshipMqHandler);
  } else if (flagshipMq.addListener) {
    flagshipMq.addListener(flagshipMqHandler);
  }
})();
</script>

{% schema %}
{
  "name": "OTODOR Flagship",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "light",
      "options": [
        { "value": "dark", "label": "Dark" },
