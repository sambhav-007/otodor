{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Installation — trust-first vertical journey.
     Compatibility promise leads. Four stages, each with real
     photography, a duration chip, and concise copy. A progress
     line draws as the visitor scrolls.
  ───────────────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 3;
    background: var(--otodor-bg-light);
  }

  .otodor-install {
    max-width: var(--otodor-container);
    margin: 0 auto;
    padding-block: var(--otodor-section-py);
  }

  /* Header: eyebrow, heading, the two friction-killers */
  .otodor-install__header {
    max-width: 900px;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .otodor-install__eyebrow {
    display: block;
    font-family: var(--otodor-font-display);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--otodor-tracking-widest);
    color: var(--otodor-accent-on-light);
    margin-bottom: 1.1rem;
  }
  .otodor-install__heading {
    font-family: var(--otodor-font-display);
    font-size: clamp(1.9rem, 4.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--otodor-tracking-tight);
    color: var(--otodor-ink);
    margin: 0;
  }
  .otodor-install__promise {
    font-family: var(--otodor-font-body);
    font-size: var(--otodor-text-md);
    line-height: 1.65;
    color: var(--otodor-ink-soft);
    margin: 1.2rem 0 0;
    max-width: 52ch;
  }
  .otodor-install__promise strong {
    color: var(--otodor-ink);
    font-weight: 600;
  }

  /* Stages: left number rail with drawn line, right photo+copy */
  .otodor-install__stages {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding-left: clamp(3.2rem, 7vw, 5.5rem);
  }
  .otodor-install__track {
    position: absolute;
    left: clamp(0.9rem, 2vw, 1.4rem);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--otodor-hairline-light-2);
  }
  .otodor-install__track-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    transform-origin: top;
    transform: scaleY(0);
    background: linear-gradient(180deg, var(--otodor-accent-on-light) 0%, rgba(26, 120, 216, 0.35) 100%);
  }

  .otodor-install__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .otodor-install__stage:nth-child(even) .otodor-install__media { order: 2; }

  .otodor-install__num {
    position: absolute;
    left: calc(-1 * clamp(3.2rem, 7vw, 5.5rem));
    top: 0.2rem;
    width: clamp(1.9rem, 4vw, 2.9rem);
    text-align: center;
    font-family: var(--otodor-font-display);
    font-size: clamp(1.22rem, 2vw, 1.6rem);
    font-weight: 700;
    color: var(--otodor-accent-on-light);
    background: var(--otodor-bg-light);
    padding-block: 0.3rem;
  }

  .otodor-install__media {
    border-radius: var(--otodor-radius-lg);
    overflow: hidden;
    background: var(--otodor-plinth);
    aspect-ratio: 4 / 3;
  }
  .otodor-install__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .otodor-install__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--otodor-ink-faint);
    font-family: var(--otodor-font-display);
    font-size: 1.09rem;
    letter-spacing: var(--otodor-tracking-wide);
  }

  .otodor-install__stage-title {
    font-family: var(--otodor-font-display);
    font-size: clamp(1.66rem, 2.8vw, 2.43rem);
    font-weight: 700;
    letter-spacing: var(--otodor-tracking-tight);
    color: var(--otodor-ink);
    margin: 0;
  }
  .otodor-install__stage-desc {
    font-family: var(--otodor-font-body);
    font-size: 1.24rem;
    line-height: 1.65;
    color: var(--otodor-ink-soft);
    margin: 0.7rem 0 0;
    max-width: 44ch;
  }
  .otodor-install__chip {
    display: inline-block;
    font-family: var(--otodor-font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--otodor-accent-on-light);
    border: 1px solid rgba(26, 120, 216, 0.3);
    border-radius: var(--otodor-radius-pill);
    padding: 0.3rem 0.9rem;
    margin-top: 1.1rem;
  }

  /* Closing trust row */
  .otodor-install__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--otodor-hairline-light);
  }
  .otodor-install__trust span {
    font-family: var(--otodor-font-body);
    font-size: 1.13rem;
    color: var(--otodor-ink-soft);
  }

  @media (max-width: 749px) {
    .otodor-install__stage { grid-template-columns: 1fr; }
    .otodor-install__stage:nth-child(even) .otodor-install__media { order: 0; }
  }
{%- endstyle -%}

<section class="otodor-install" data-otodor-section="install" aria-labelledby="otodor-install-title-{{ section.id }}">
  <div class="otodor-install__header">
    <span class="otodor-install__eyebrow" data-otodor-reveal="fade-up">{{ section.settings.eyebrow | escape }}</span>
    <h2 class="otodor-install__heading" id="otodor-install-title-{{ section.id }}" data-otodor-reveal="fade-up">{{ section.settings.heading | escape }}</h2>
    <p class="otodor-install__promise" data-otodor-reveal="fade-up">
      <strong>{{ section.settings.promise | escape }}</strong>
      {{ section.settings.estimate | escape }}
    </p>
  </div>

  <div class="otodor-install__stages">
    <div class="otodor-install__track" aria-hidden="true">
      <div class="otodor-install__track-fill" data-install-track></div>
    </div>

    {%- for block in section.blocks -%}
      <div class="otodor-install__stage" data-otodor-reveal="fade-up" {{ block.shopify_attributes }}>
        <span class="otodor-install__num" aria-hidden="true">0{{ forloop.index }}</span>
        <div class="otodor-install__media{% if block.settings.image == blank %} otodor-install__media--empty{% endif %}">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '550,820,1100', sizes: '(min-width: 750px) 45vw, 92vw', alt: block.settings.title }}
          {%- else -%}
            <span aria-hidden="true">PHOTO</span>
          {%- endif -%}
        </div>
        <div>
          <h3 class="otodor-install__stage-title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="otodor-install__stage-desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}
          {%- if block.settings.duration != blank -%}
            <span class="otodor-install__chip">{{ block.settings.duration | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.trust_line != blank -%}
    <div class="otodor-install__trust" data-otodor-reveal="fade-up">
      {%- assign trust_parts = section.settings.trust_line | split: '·' -%}
      {%- for part in trust_parts -%}
        <span>{{ part | strip | escape }}</span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  /* Progress line draws with scroll. GSAP ScrollTrigger when present,
     static full line as fallback. */
  (function () {
    var fill = document.querySelector('#shopify-section-{{ section.id }} [data-install-track]');
    if (!fill) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function init() {
      if (reduced || !window.gsap || !window.ScrollTrigger) {
        fill.style.transform = 'scaleY(1)';
        return;
      }
      gsap.to(fill, {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: fill.closest('.otodor-install__stages'),
          start: 'top 75%',
          end: 'bottom 60%',
          scrub: 0.5
        }
      });
    }
    if (window.gsap) { init(); } else { window.addEventListener('load', init); }
  })();
</script>

{% schema %}
{
  "name": "OTODOR Installation",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Professional Installation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From order to secured." },
    { "type": "text", "id": "promise", "label": "Compatibility promise", "default": "We verify compatibility before installation." },
    { "type": "text", "id": "estimate", "label": "Estimate line", "default": "Most installations are completed within 2–4 hours." },
    { "type": "text", "id": "trust_line", "label": "Trust row (· separated)", "default": "Certified OTODOR technicians · Background-verified · 1-year workmanship guarantee" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stage",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Consultation" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "We assess your door and confirm the right fit — before you pay." },
        { "type": "text", "id": "duration", "label": "Duration chip", "default": "~30 min" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Real technician / installation photography builds the most trust." }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTODOR Installation",
      "blocks": [
        { "type": "step", "settings": { "title": "Consultation", "description": "We assess your door and confirm compatibility — before you pay.", "duration": "~30 min" } },
        { "type": "step", "settings": { "title": "Professional installation", "description": "Installed by certified OTODOR professionals, not couriers.", "duration": "1–2 hrs" } },
        { "type": "step", "settings": { "title": "Setup & training", "description": "Fingerprints enrolled, app connected, your family onboarded.", "duration": "~45 min" } },
        { "type": "step", "settings": { "title": "Ongoing support", "description": "Real humans on WhatsApp, backed by a 3-year warranty.", "duration": "Always on" } }
      ]
    }
  ]
}
{% endschema %}
