{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Product Lifestyle — one cinematic image, one
     sentence. The product in life, not in a catalog.
  ───────────────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    background: var(--otodor-bg-light);
  }
  .otodor-plife {
    position: relative;
    min-height: clamp(420px, 64vh, 640px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: linear-gradient(160deg, var(--otodor-plinth) 0%, #DDD9D0 100%);
  }
  .otodor-plife__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .otodor-plife::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, 0.55) 100%);
  }
  .otodor-plife__copy {
    position: relative;
    z-index: 2;
    max-width: var(--otodor-container);
    width: 100%;
    margin: 0 auto;
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .otodor-plife__line {
    font-family: var(--otodor-font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--otodor-tracking-tight);
    color: #FFFFFF;
    max-width: 24ch;
    margin: 0;
  }
{%- endstyle -%}

{%- liquid
  assign life_image = product.metafields.custom.lifestyle_image | default: section.settings.image
  assign life_line = product.metafields.custom.lifestyle_line.value | default: section.settings.line
-%}

{%- if life_image != blank or life_line != blank -%}
  <div class="otodor-plife" data-otodor-reveal="fade-in">
    {%- if life_image != blank -%}
      {{ life_image | image_url: width: 2200 | image_tag: class: 'otodor-plife__img', loading: 'lazy', widths: '900,1400,2200', sizes: '100vw', alt: life_line | default: product.title }}
    {%- endif -%}
    {%- if life_line != blank -%}
      <div class="otodor-plife__copy">
        <p class="otodor-plife__line">{{ life_line | escape }}</p>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "OTODOR Product Lifestyle",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Per-product override: metafield custom.lifestyle_image." },
    { "type": "text", "id": "line", "label": "Sentence", "default": "Home knows it's you." }
  ],
  "presets": [{ "name": "OTODOR Product Lifestyle" }]
}
{% endschema %}
