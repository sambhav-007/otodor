{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Hero Section
     Cinematic Vault Reveal — Apple/Tesla-style progressive unveil.
  ───────────────────────────────────────────────────────── */

  #shopify-section-{{ section.id }} {
    display: block;
    background-color: #0c0f11;
    overflow: hidden;
  }

  /* ─ Base layout: Mobile First ──────────────────────────────── */
  .otodor-hero {
    background-color: #0c0f11;
    color: #ffffff;
    padding: 5rem 1.5rem 4rem;
    position: relative;
    overflow: hidden;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .otodor-hero__viewport {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    transform-origin: center center;
    will-change: transform;
  }

  /* ─ Atmospheric Depth & Fog ────────────────────────────────── */
  .otodor-hero__ambient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .otodor-hero__glow-top {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 50%;
    background: radial-gradient(ellipse, rgba(77, 166, 255, 0.115) 0%, transparent 70%);
  }

  .otodor-hero__glow-bottom {
    position: absolute;
    bottom: -15%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    height: 50%;
    background: radial-gradient(ellipse, rgba(77, 166, 255, 0.07) 0%, transparent 70%);
  }

  .otodor-hero__glow-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(77, 166, 255, 0.07) 0%, transparent 70%);
    filter: blur(45px);
    pointer-events: none;
    z-index: 1;
    will-change: transform, opacity;
  }

  .otodor-hero__fog-cloud {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(40px);
    pointer-events: none;
  }

  .otodor-hero__fog-cloud--back {
    width: 150%;
    height: 150%;
    background: radial-gradient(ellipse at center, rgba(77, 166, 255, 0.055) 0%, transparent 65%);
    animation: fog-drift-back 35s ease-in-out infinite alternate;
    z-index: 1;
  }

  .otodor-hero__fog-cloud--front {
    width: 120%;
    height: 120%;
    background: radial-gradient(ellipse at center, rgba(77, 166, 255, 0.028) 0%, transparent 55%);
    animation: fog-drift-front 24s ease-in-out infinite alternate;
    z-index: 3;
  }

  @keyframes fog-drift-back {
    0% { transform: translate(-52%, -48%) scale(1.0); }
    100% { transform: translate(-48%, -52%) scale(1.1); }
  }

  @keyframes fog-drift-front {
    0% { transform: translate(-47%, -53%) scale(0.95); }
    100% { transform: translate(-53%, -47%) scale(1.05); }
  }

  @keyframes product-premium-float {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -7px, 0); }
  }

  @keyframes product-reflective-pass {
    0%, 72%, 100% {
      opacity: 0;
      transform: translate3d(-62%, 18%, 0) rotate(18deg);
    }
    82% {
      opacity: 0.16;
    }
    92% {
      opacity: 0;
      transform: translate3d(62%, -18%, 0) rotate(18deg);
    }
  }

  @keyframes core-energy-drift {
    0%, 100% {
      opacity: 0.18;
      transform: translate3d(0, 9%, 0) scaleY(0.82);
    }
    50% {
      opacity: 0.34;
      transform: translate3d(0, -9%, 0) scaleY(1);
    }
  }

  @keyframes core-seam-breathe {
    0%, 100% {
      opacity: 0.18;
      filter: blur(0.5px);
    }
    46%, 58% {
      opacity: 0.72;
      filter: blur(1.2px);
    }
  }

  @keyframes core-ambient-pulse {
    0%, 82%, 100% {
      opacity: 0;
      transform: translateZ(20px) scale(0.94);
    }
    90% {
      opacity: 0.16;
      transform: translateZ(20px) scale(1.04);
    }
  }

  /* Volumetric light rays */
  .otodor-hero__light-ray {
    position: absolute;
    top: -50%;
    width: 450px;
    height: 200%;
    background: linear-gradient(105deg, rgba(77, 166, 255, 0.065) 0%, transparent 60%);
    transform: rotate(-15deg);
    filter: blur(45px);
    pointer-events: none;
    z-index: 1;
    will-change: transform, opacity;
  }

  .ray--1 {
    left: 15%;
  }

  .ray--2 {
    left: 58%;
    width: 380px;
    background: linear-gradient(105deg, rgba(77, 166, 255, 0.042) 0%, transparent 50%);
    transform: rotate(-12deg);
  }

  /* ─ Floating Atmospheric Particles (20 items) ────────────────── */
  .otodor-hero__particles {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    background: rgba(77, 166, 255, 0.16);
    border-radius: 50%;
    filter: blur(0.5px);
    will-change: transform, opacity;
  }

  /* Fallback values for CSS if JS is disabled */
  .particle--1  { width: 4px;  height: 4px;  left: 12%; top: 80%; }
  .particle--2  { width: 2px;  height: 2px;  left: 32%; top: 90%; }
  .particle--3  { width: 5px;  height: 5px;  left: 52%; top: 85%; }
  .particle--4  { width: 3px;  height: 3px;  left: 72%; top: 75%; }
  .particle--5  { width: 4px;  height: 4px;  left: 88%; top: 60%; }
  .particle--6  { width: 2px;  height: 2px;  left: 22%; top: 40%; }
  .particle--7  { width: 4px;  height: 4px;  left: 42%; top: 30%; }
  .particle--8  { width: 3px;  height: 3px;  left: 62%; top: 20%; }
  .particle--9  { width: 5px;  height: 5px;  left: 92%; top: 15%; }
  .particle--10 { width: 3px;  height: 3px;  left: 8%;  top: 55%; }
  .particle--11 { width: 4px;  height: 4px;  left: 48%; top: 72%; }
  .particle--12 { width: 2px;  height: 2px;  left: 68%; top: 48%; }
  .particle--13 { width: 5px;  height: 5px;  left: 18%; top: 70%; }
  .particle--14 { width: 3px;  height: 3px;  left: 38%; top: 65%; }
  .particle--15 { width: 4px;  height: 4px;  left: 58%; top: 50%; }
  .particle--16 { width: 2px;  height: 2px;  left: 78%; top: 35%; }
  .particle--17 { width: 4px;  height: 4px;  left: 83%; top: 25%; }
  .particle--18 { width: 3px;  height: 3px;  left: 28%; top: 18%; }
  .particle--19 { width: 5px;  height: 5px;  left: 60%; top: 10%; }
  .particle--20 { width: 2px;  height: 2px;  left: 95%; top: 5%; }

  /* ─ Security Core: Symmetrical Layered Obsidian Obelisk ──────── */
  .otodor-hero__core-container {
    position: relative;
    width: 150px;
    height: 250px;
    perspective: 1000px;
    margin: 1.5rem auto;
    z-index: 10;
  }

  .centerpiece-obelisk {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transform: rotateY(-20deg) rotateX(15deg);
    will-change: transform, opacity;
  }

  .obelisk-pillar {
    position: absolute;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .pillar-face {
    position: absolute;
    background: linear-gradient(135deg, #181818 0%, #060606 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.85);
  }

  /* Symmetrical plate layering inside front face */
  .pillar-layer-back {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f0f0f 0%, #040404 100%);
    border: 1px solid rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.9);
  }

  .pillar-layer-glow {
    position: absolute;
    inset: 3px;
    background: rgba(77, 166, 255, 0.18);
    filter: blur(4px);
    opacity: 0.5;
    pointer-events: none;
    transition: background 300ms ease, opacity 300ms ease;
  }

  .pillar-layer-front {
    position: absolute;
    inset: 3px;
    background: linear-gradient(135deg, #202020 0%, #0a0a0a 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateZ(8px);
    transform-style: preserve-3d;
  }

  /* Center Pillar */
  .obelisk-pillar--center {
    width: 48px;
    height: 260px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateZ(0px);
  }

  .obelisk-pillar--center .pillar-face {
    width: 100%;
    height: 100%;
  }

  .obelisk-pillar--center .pillar-face--front {
    transform: translateZ(10px);
    border-right: 1.5px solid rgba(77, 166, 255, 0.22);
    border-top: 1.5px solid rgba(255, 255, 255, 0.12);
  }

  .obelisk-pillar--center .pillar-face--right {
    width: 20px;
    left: 100%;
    transform: rotateY(90deg) translateZ(-10px);
    transform-origin: left center;
  }

  .obelisk-pillar--center .pillar-face--left {
    width: 20px;
    right: 100%;
    transform: rotateY(-90deg) translateZ(-10px);
    transform-origin: right center;
  }

  .obelisk-pillar--center .pillar-face--top {
    height: 20px;
    bottom: 100%;
    transform: rotateX(90deg) translateZ(10px);
    transform-origin: center bottom;
    background: linear-gradient(180deg, #242424 0%, #0e0e0e 100%);
  }

  /* Center Pillar Glowing Seam split around LogoIcon */
  .obelisk-pillar--center .pillar-seam--top {
    position: absolute;
    left: 50%;
    top: 8%;
    transform: translateX(-50%);
    width: 1.5px;
    height: 32%;
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  .obelisk-pillar--center .pillar-seam--bottom {
    position: absolute;
    left: 50%;
    top: 60%;
    transform: translateX(-50%);
    width: 1.5px;
    height: 32%;
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  .pillar-logo-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(4px);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 5;
  }

  .pillar-logo-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 3px rgba(77, 166, 255, 0.3)) brightness(0.85);
    transition: filter 300ms ease, transform 300ms ease;
  }

  /* Left Wing */
  .obelisk-pillar--left-wing {
    width: 24px;
    height: 200px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateX(-48px) translateZ(-16px);
    opacity: 0.75;
  }

  .obelisk-pillar--left-wing .pillar-face {
    width: 100%;
    height: 100%;
  }

  .obelisk-pillar--left-wing .pillar-face--front {
    transform: translateZ(8px);
  }

  .obelisk-pillar--left-wing .pillar-face--right {
    width: 16px;
    left: 100%;
    transform: rotateY(90deg) translateZ(-8px);
    transform-origin: left center;
  }

  .obelisk-pillar--left-wing .pillar-face--left {
    width: 16px;
    right: 100%;
    transform: rotateY(-90deg) translateZ(-8px);
    transform-origin: right center;
  }

  /* Left Wing Glowing Seam (Horizontal) */
  .obelisk-pillar--left-wing .pillar-seam {
    position: absolute;
    left: 10%;
    top: 50%;
    width: 80%;
    height: 1.5px;
    transform: translateY(-50%);
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  /* Right Wing */
  .obelisk-pillar--right-wing {
    width: 24px;
    height: 200px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateX(48px) translateZ(-16px);
    opacity: 0.75;
  }

  .obelisk-pillar--right-wing .pillar-face {
    width: 100%;
    height: 100%;
  }

  .obelisk-pillar--right-wing .pillar-face--front {
    transform: translateZ(8px);
    border-right: 1.2px solid rgba(77, 166, 255, 0.20);
  }

  .obelisk-pillar--right-wing .pillar-face--right {
    width: 16px;
    left: 100%;
    transform: rotateY(90deg) translateZ(-8px);
    transform-origin: left center;
  }

  .obelisk-pillar--right-wing .pillar-face--left {
    width: 16px;
    right: 100%;
    transform: rotateY(-90deg) translateZ(-8px);
    transform-origin: right center;
  }

  /* Right Wing Glowing Seam (Horizontal) */
  .obelisk-pillar--right-wing .pillar-seam {
    position: absolute;
    left: 10%;
    top: 50%;
    width: 80%;
    height: 1.5px;
    transform: translateY(-50%);
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  .face-gloss {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 50%);
    pointer-events: none;
    border-radius: 4px;
  }

  /* Internal Glowing Core */
  .centerpiece-internal-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(-20px);
    width: 180px;
    height: 250px;
    background: radial-gradient(ellipse, rgba(77, 166, 255, 0.24) 0%, transparent 65%);
    filter: blur(12px);
    z-index: 1;
    pointer-events: none;
    /* keep as background fog */
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }

  .obsidian-monolith__shadow {
    position: absolute;
    width: 220px;
    height: 40px;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.95) 0%, transparent 70%);
    bottom: -25px;
    left: 50%;
    transform: translateX(-50%) rotateX(90deg);
    filter: blur(6px);
    pointer-events: none;
  }

  /* ─ Responsive Product Grid: Stacked on Mobile ───────────── */
  .otodor-hero__products-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 600px;
    z-index: 25;
    margin-left: -30px; /* pull closer to core */
    margin-right: -30px;
  }

  .otodor-hero__product-node {
    width: 100%;
    will-change: transform, opacity;
    overflow: visible;
    z-index: 35;
    transform-style: preserve-3d;
  }

  /* Mobile: Clean premium list panels */
  .otodor-hero__product-card {
    display: flex;
    align-items: center;
    gap: 3rem;
    background: rgba(18, 18, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-left: 2.5px solid #4DA6FF;
    border-radius: 12px;
    padding: 5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 300ms ease, box-shadow 300ms ease;
    z-index: 20;
    overflow: visible;
  }

  .otodor-hero__product-card:hover {
    border-color: rgba(77, 166, 255, 0.35);
    box-shadow: 0 4px 24px rgba(77, 166, 255, 0.06);
  }

  .product-card__visual {
    width: 340px;
    height: 340px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.04);
    position: relative;
    overflow: visible;
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.55)) drop-shadow(0 4px 12px rgba(77, 166, 255, 0.08));
  }

  .product-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-card__visual svg.product-icon-svg {
    width: 32px;
    height: 32px;
    color: rgba(255, 255, 255, 0.55);
    transition: color 300ms ease;
  }

  .product-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
  }

  .product-card__feature {
    font-size: 1.4rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #4DA6FF;
  }

  .product-card__title {
    font-size: 2.5rem;
    font-weight: 600;
    margin: 0;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .product-card__desc {
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0.25rem 0 0;
    line-height: 1.45;
  }

  /* ─ Typography overlay ─────────────────────────────────────── */
  .otodor-hero__text-container {
    width: 100%;
    max-width: 600px;
    text-align: center;
    z-index: 5;
  }

  .otodor-hero__text-frame {
    margin-bottom: 2rem;
    will-change: transform, opacity;
  }

  .otodor-hero__heading {
    font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
    font-size: clamp(2rem, 5.5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0;
  }

  .accent-text {
    background: linear-gradient(135deg, #4DA6FF 0%, #2E8EEE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: #4DA6FF;
  }

  .otodor-hero__subheading {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    margin: 1rem auto 0;
    max-width: 500px;
  }

  .otodor-hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  .otodor-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 99px;
    transition: transform 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .otodor-btn--primary {
    background-color: #ffffff;
    color: #0b0b0b;
  }

  .otodor-btn--primary:hover {
    background-color: #eaeaea;
    transform: scale(1.04);
  }

  .otodor-btn--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .otodor-btn--secondary:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
    transform: scale(1.04);
  }

  /* ─ Hidden / Desktop only containers by default ─────────────── */
  .otodor-hero__stage,
  .otodor-hero__vault-pedestal,
  .otodor-hero__connections-svg,
  .product-reveal-caption {
    display: none;
  }

  /* ─ Scroll guide indicator (Mobile) ────────────────────────── */
  .otodor-hero__scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 2rem auto 0;
    border: none;
    background: none;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: color 250ms ease;
  }

  .otodor-hero__scroll-indicator:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  .otodor-hero__scroll-indicator .line {
    width: 1px;
    height: 30px;
    background: currentColor;
    position: relative;
    overflow: hidden;
  }

  .otodor-hero__scroll-indicator .line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent, #4DA6FF, transparent);
    animation: scroll-pulse 1.8s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }


  /* ─────────────────────────────────────────────────────────────
     Desktop — Vault-centric cinematic reveal (>= 1024px)
     ───────────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {

    .otodor-hero.js-animated {
      height: 100vh;
      padding: 0;
      display: block;
    }

    .otodor-hero.js-animated .otodor-hero__viewport {
      height: 100%;
      position: relative;
      display: block;
      max-width: none;
      perspective: 1400px;
      transform-style: preserve-3d;
    }

    /* Concentrated stage — vault + reveal runway */
    .otodor-hero.js-animated .otodor-hero__stage {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 6;
      transform-origin: 50% 46%;
      will-change: transform;
    }

    .otodor-hero.js-animated .otodor-hero__vault-pedestal {
      display: block;
      position: absolute;
      top: 46%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(32vw, 360px);
      height: min(38vh, 420px);
      background: radial-gradient(ellipse 50% 48% at 50% 55%, rgba(77, 166, 255, 0.11) 0%, rgba(77, 166, 255, 0.04) 38%, transparent 72%);
      pointer-events: none;
      z-index: 4;
      will-change: transform, opacity;
    }

    /* Security core supports the ecosystem without owning the viewport */
    .otodor-hero.js-animated .otodor-hero__core-container {
      position: absolute;
      top: 46%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      width: min(40vw, 450px);
      height: min(54vh, 560px);
      z-index: 12;
    }

    .otodor-hero.js-animated .centerpiece-obelisk::after {
      content: '';
      position: absolute;
      inset: 8% 18%;
      border-radius: 999px;
      border: 1px solid rgba(77, 166, 255, 0.18);
      box-shadow: 0 0 28px rgba(77, 166, 255, 0.12);
      transform: translateZ(20px) scale(0.94);
      animation: core-ambient-pulse 9s ease-in-out infinite;
      pointer-events: none;
      z-index: 7;
    }

    .otodor-hero.js-animated .obelisk-pillar--center {
      width: 84px;
      height: 455px;
    }

    .otodor-hero.js-animated .obelisk-pillar--center .pillar-face--right,
    .otodor-hero.js-animated .obelisk-pillar--center .pillar-face--left {
      width: 32px;
    }

    .otodor-hero.js-animated .obelisk-pillar--center .pillar-face--top {
      height: 32px;
    }

    .otodor-hero.js-animated .pillar-logo-container {
      width: 52px;
      height: 52px;
    }

    .otodor-hero.js-animated .pillar-logo-icon {
      filter: drop-shadow(0 0 6px rgba(77, 166, 255, 0.36)) brightness(1.08);
    }

    .otodor-hero.js-animated .obelisk-pillar--left-wing {
      width: 38px;
      height: 365px;
      transform: translate(-50%, -50%) translateX(-124px) translateZ(-26px);
    }

    .otodor-hero.js-animated .obelisk-pillar--left-wing .pillar-face--right,
    .otodor-hero.js-animated .obelisk-pillar--left-wing .pillar-face--left,
    .otodor-hero.js-animated .obelisk-pillar--right-wing .pillar-face--right,
    .otodor-hero.js-animated .obelisk-pillar--right-wing .pillar-face--left {
      width: 25px;
    }

    .otodor-hero.js-animated .obelisk-pillar--right-wing {
      width: 38px;
      height: 365px;
      transform: translate(-50%, -50%) translateX(124px) translateZ(-26px);
    }

    .otodor-hero.js-animated .centerpiece-internal-glow {
      width: 300px;
      height: 410px;
      opacity: 0.45;
    }

    .otodor-hero.js-animated .centerpiece-internal-glow::before {
      content: '';
      position: absolute;
      inset: 10% 32%;
      border-radius: 999px;
      background: linear-gradient(180deg, transparent 0%, rgba(77, 166, 255, 0.36) 38%, rgba(255, 255, 255, 0.22) 50%, rgba(77, 166, 255, 0.28) 62%, transparent 100%);
      filter: blur(16px);
      opacity: 0.22;
      animation: core-energy-drift 8.8s ease-in-out infinite;
    }

    .otodor-hero.js-animated .pillar-seam::after {
      content: '';
      position: absolute;
      inset: -5px;
      border-radius: 999px;
      background: rgba(77, 166, 255, 0.42);
      box-shadow: 0 0 14px rgba(77, 166, 255, 0.34);
      opacity: 0.22;
      animation: core-seam-breathe 8.8s ease-in-out infinite;
      pointer-events: none;
    }

    .otodor-hero.js-animated .obsidian-monolith__shadow {
      width: 315px;
      height: 48px;
      bottom: -34px;
    }

    .otodor-hero.js-animated .otodor-hero__glow-core {
      width: min(44vw, 540px);
      height: min(58vh, 660px);
      top: 46%;
    }

    .otodor-hero.js-animated .otodor-hero__light-ray {
      display: block;
    }

    /* Curved ecosystem connections */
    .otodor-hero.js-animated .otodor-hero__connections-svg {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 8;
      pointer-events: none;
    }

    .ecosystem-path {
      fill: none;
      stroke: rgba(77, 166, 255, 0.12);
      stroke-width: 1.8;
      transition: stroke 600ms ease, stroke-width 600ms ease;
    }

    .ecosystem-path-active {
      stroke: rgba(77, 166, 255, 0.42);
    }

    .ecosystem-path-illuminated {
      stroke: rgba(77, 166, 255, 0.65);
      stroke-width: 2.2;
    }

    .ecosystem-pulse {
      fill: none;
      stroke: #4DA6FF;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-dasharray: 80 1200;
      stroke-dashoffset: 0;
      opacity: 0;
      pointer-events: none;
    }

    /* Product orbit — wide ring with monolith exclusion zone */
    .otodor-hero.js-animated .otodor-hero__products-grid {
      position: absolute;
      top: 46%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(94vw, 1360px);
      height: min(86vh, 980px);
      max-width: none;
      display: block;
      margin: 0;
      pointer-events: none;
      z-index: 20;
    }

    .otodor-hero.js-animated .otodor-hero__product-node {
      position: absolute;
      top: 50%;
      left: 50%;
      width: clamp(280px, 23vw, 360px);
      pointer-events: auto;
      opacity: 0;
      z-index: 26;
    }

    /* Product sizing per node — primary visual objects in the ecosystem */
    .otodor-hero.js-animated .product-node--1 .product-card__visual {
      width: clamp(260px, 22vw, 350px);
      height: clamp(260px, 22vw, 350px);
    }

    .otodor-hero.js-animated .product-node--2 .product-card__visual {
      width: clamp(250px, 21vw, 330px);
      height: clamp(250px, 21vw, 330px);
    }

    .otodor-hero.js-animated .product-node--3 .product-card__visual {
      width: clamp(245px, 20vw, 320px);
      height: clamp(245px, 20vw, 320px);
    }

    .otodor-hero.js-animated .product-node--4 .product-card__visual {
      width: clamp(260px, 22vw, 350px);
      height: clamp(260px, 22vw, 350px);
    }

    .otodor-hero.js-animated .otodor-hero__product-card {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
      position: relative;
      overflow: visible;
    }

    .otodor-hero.js-animated .product-card__visual {
      width: clamp(245px, 20vw, 330px);
      height: clamp(245px, 20vw, 330px);
      background: transparent;
      border: none;
      border-radius: 0;
      overflow: visible;
      position: relative;
      filter: drop-shadow(0 24px 46px rgba(0, 0, 0, 0.72)) drop-shadow(0 0 22px rgba(77, 166, 255, 0.14));
      animation: product-premium-float 8.5s ease-in-out infinite;
      transition: filter 700ms ease, opacity 700ms ease;
    }

    .otodor-hero.js-animated .product-node--2 .product-card__visual {
      animation-delay: -1.7s;
    }

    .otodor-hero.js-animated .product-node--3 .product-card__visual {
      animation-delay: -3.1s;
    }

    .otodor-hero.js-animated .product-node--4 .product-card__visual {
      animation-delay: -4.4s;
    }

    .otodor-hero.js-animated .product-card__visual::before,
    .otodor-hero.js-animated .product-card__visual::after {
      content: '';
      position: absolute;
      inset: 4%;
      border-radius: 14px;
      pointer-events: none;
      z-index: 2;
    }

    .otodor-hero.js-animated .product-card__visual::before {
      border: 1px solid rgba(77, 166, 255, 0.12);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 12px 0 26px rgba(77, 166, 255, 0.07), inset -10px 0 20px rgba(255, 255, 255, 0.035);
      opacity: 0.62;
      transition: opacity 700ms ease, border-color 700ms ease, box-shadow 700ms ease;
    }

    .otodor-hero.js-animated .product-card__visual::after {
      width: 34%;
      height: 130%;
      left: 33%;
      top: -15%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      filter: blur(12px);
      opacity: 0;
      animation: product-reflective-pass 7.5s ease-in-out infinite;
    }

    .otodor-hero.js-animated .product-card__visual img {
      filter: saturate(1.04) contrast(1.04);
    }

    .otodor-hero.js-animated .otodor-hero__product-node.is-ecosystem-active .product-card__visual,
    .otodor-hero.js-animated .otodor-hero__product-node.is-spotlight .product-card__visual {
      filter: drop-shadow(0 28px 52px rgba(0, 0, 0, 0.76)) drop-shadow(0 0 28px rgba(77, 166, 255, 0.2));
    }

    .otodor-hero.js-animated .otodor-hero__product-node.is-ecosystem-active .product-card__visual::before,
    .otodor-hero.js-animated .otodor-hero__product-node.is-spotlight .product-card__visual::before {
      opacity: 0.9;
      border-color: rgba(77, 166, 255, 0.22);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), inset 14px 0 28px rgba(77, 166, 255, 0.1), inset -10px 0 22px rgba(255, 255, 255, 0.05);
    }

    .otodor-hero.js-animated .product-card__visual svg.product-icon-svg {
      width: 68%;
      height: 68%;
      color: rgba(255, 255, 255, 0.78);
      filter: drop-shadow(0 16px 28px rgba(0, 0, 0, 0.65)) drop-shadow(0 0 22px rgba(77, 166, 255, 0.16));
    }

    .otodor-hero.js-animated .otodor-hero__product-card:hover .product-card__visual {
      filter: drop-shadow(0 30px 54px rgba(0, 0, 0, 0.78)) drop-shadow(0 0 30px rgba(77, 166, 255, 0.22));
    }

    .otodor-hero.js-animated .product-card__content {
      display: none;
    }

    /* Single active narrative — positioned beside/below product (animation-controlled) */
    .otodor-hero.js-animated .product-reveal-caption {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 260px;
      opacity: 0;
      will-change: transform, opacity;
      pointer-events: none;
      margin: 0;
      z-index: 46;
    }

    .otodor-hero.js-animated .product-node--1 .product-reveal-caption {
      top: auto;
      bottom: 4px;
      left: 50%;
      transform: translate(-50%, 100%);
      text-align: center;
      align-items: center;
      width: 280px;
    }

    .otodor-hero.js-animated .product-node--2 .product-reveal-caption {
      top: auto;
      bottom: 4px;
      left: 50%;
      transform: translate(-50%, 100%);
      text-align: center;
      align-items: center;
      width: 280px;
    }

    .otodor-hero.js-animated .product-node--3 .product-reveal-caption {
      top: auto;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translate(-50%, 0);
      text-align: center;
      align-items: center;
      width: 280px;
    }

    .otodor-hero.js-animated .product-node--4 .product-reveal-caption {
      top: auto;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translate(-50%, 0);
      text-align: center;
      align-items: center;
      width: 280px;
    }

    .product-reveal-caption__tag {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: #4DA6FF;
    }

    .product-reveal-caption__title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.45rem;
      font-weight: 600;
      color: #ffffff;
      margin: 5px 0 0;
      letter-spacing: -0.02em;
    }

    .product-reveal-caption__desc {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.58);
      line-height: 1.4;
      margin: 5px 0 0;
    }

    /* Intro text — top of frame, vault is hero */
    .otodor-hero.js-animated .otodor-hero__text-container {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 90%;
      max-width: 720px;
      pointer-events: none;
      z-index: 40;
    }

    .otodor-hero.js-animated .otodor-hero__text-container:first-of-type {
      top: 6%;
      bottom: auto;
      height: auto;
    }

    .otodor-hero.js-animated .otodor-hero__text-container:last-of-type {
      bottom: 7%;
      top: auto;
      height: auto;
      left: clamp(2rem, 6vw, 6rem);
      right: auto;
      transform: none;
      max-width: min(36vw, 520px);
      text-align: left;
    }

    .otodor-hero.js-animated .otodor-hero__text-frame {
      position: relative;
      inset: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      margin-bottom: 0;
    }

    .otodor-hero.js-animated .frame--intro {
      opacity: 1;
      pointer-events: auto;
    }

    .otodor-hero.js-animated .frame--final {
      pointer-events: auto;
      align-items: flex-start;
      text-align: left;
    }

    .otodor-hero.js-animated .frame--final .otodor-hero__actions {
      justify-content: flex-start;
    }

    .otodor-hero.js-animated .otodor-hero__heading {
      font-size: clamp(2.4rem, 4vw, 3.4rem);
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .otodor-hero.js-animated .frame--intro .otodor-hero__heading {
      font-size: clamp(1.8rem, 3vw, 2.6rem);
    }

    .otodor-hero.js-animated .otodor-hero__subheading {
      font-size: 1rem;
      margin-top: 0.75rem;
    }
  }

  /* ─ Reduced Motion: Deactivate desktop animations ────────── */
  @media (prefers-reduced-motion: reduce) {
    .otodor-hero.js-animated {
      height: auto !important;
      padding: 5rem 1.5rem !important;
    }
    .otodor-hero.js-animated .otodor-hero__viewport {
      display: flex !important;
      flex-direction: column !important;
      gap: 3rem !important;
      transform: none !important;
    }
    .otodor-hero.js-animated .otodor-hero__products-grid {
      position: static !important;
      display: flex !important;
      flex-direction: column !important;
      max-width: 480px !important;
      margin: 0 auto !important;
    }
    .otodor-hero.js-animated .otodor-hero__product-node {
      position: static !important;
      opacity: 1 !important;
      transform: none !important;
      width: 100% !important;
    }
    .otodor-hero.js-animated .otodor-hero__light-ray,
    .otodor-hero.js-animated .otodor-hero__stage,
    .otodor-hero.js-animated .otodor-hero__vault-pedestal,
    .otodor-hero.js-animated .otodor-hero__connections-svg {
      display: none !important;
    }
    .otodor-hero.js-animated .product-card__content {
      display: flex !important;
    }
    .otodor-hero.js-animated .product-reveal-caption {
      display: none !important;
    }
    .otodor-hero.js-animated .otodor-hero__text-container {
      position: static !important;
      transform: none !important;
      height: auto !important;
      margin: 2rem auto 0 !important;
    }
    .otodor-hero.js-animated .otodor-hero__text-frame {
      position: static !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    .otodor-hero.js-animated .frame--intro {
      display: none !important;
    }
  }
{%- endstyle -%}

<section
  id="otodor-hero-{{ section.id }}"
  class="otodor-hero"
  data-otodor-section="hero"
>
  <!-- Background ambient & depth fog layers -->
  <div class="otodor-hero__ambient">
    <div class="otodor-hero__glow-top"></div>
    <div class="otodor-hero__glow-bottom"></div>
    <div class="otodor-hero__glow-core"></div>
    <div class="otodor-hero__fog-cloud otodor-hero__fog-cloud--back"></div>
    <div class="otodor-hero__fog-cloud otodor-hero__fog-cloud--front"></div>
    <!-- Volumetric light rays (Desktop only) -->
    <div class="otodor-hero__light-ray ray--1" aria-hidden="true"></div>
    <div class="otodor-hero__light-ray ray--2" aria-hidden="true"></div>
  </div>

  <!-- Floating particles (20 items - Desktop parallax atmosphere) -->
  <div class="otodor-hero__particles" aria-hidden="true">
    <div class="particle particle--1"></div>
    <div class="particle particle--2"></div>
    <div class="particle particle--3"></div>
    <div class="particle particle--4"></div>
    <div class="particle particle--5"></div>
    <div class="particle particle--6"></div>
    <div class="particle particle--7"></div>
    <div class="particle particle--8"></div>
    <div class="particle particle--9"></div>
    <div class="particle particle--10"></div>
    <div class="particle particle--11"></div>
    <div class="particle particle--12"></div>
    <div class="particle particle--13"></div>
    <div class="particle particle--14"></div>
    <div class="particle particle--15"></div>
    <div class="particle particle--16"></div>
    <div class="particle particle--17"></div>
    <div class="particle particle--18"></div>
    <div class="particle particle--19"></div>
    <div class="particle particle--20"></div>
  </div>

  <div class="otodor-hero__viewport">
    
    <!-- Intro / Initial Headline (Always readable for SEO) -->
    <div class="otodor-hero__text-container">
      <div class="otodor-hero__text-frame frame--intro">
        <h1 class="otodor-hero__heading">
          {{- section.settings.heading | escape }}<br>
          <span class="accent-text">{{ section.settings.heading_accent | escape -}}</span>
        </h1>
        {%- if section.settings.subheading != blank -%}
          <p class="otodor-hero__subheading">{{- section.settings.subheading | escape -}}</p>
        {%- endif -%}
        
        <button type="button" class="otodor-hero__scroll-indicator" data-scroll-indicator aria-label="Scroll to explore ecosystem">
          <span class="line"></span>
          <span>Scroll</span>
        </button>
      </div>
    </div>

    <!-- Cinematic vault stage -->
    <div class="otodor-hero__stage">
    <div class="otodor-hero__vault-pedestal" aria-hidden="true"></div>

    <!-- Curved ecosystem connections -->
    <svg class="otodor-hero__connections-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
      <path class="ecosystem-path path-1" d="M 500,455 C 430,390 350,300 245,185" />
      <path class="ecosystem-path path-2" d="M 500,455 C 570,390 650,300 755,185" />
      <path class="ecosystem-path path-3" d="M 500,545 C 430,575 350,620 245,685" />
      <path class="ecosystem-path path-4" d="M 500,545 C 570,575 650,620 755,685" />
      <path class="ecosystem-pulse pulse-1" d="M 500,455 C 430,390 350,300 245,185" />
      <path class="ecosystem-pulse pulse-2" d="M 500,455 C 570,390 650,300 755,185" />
      <path class="ecosystem-pulse pulse-3" d="M 500,545 C 430,575 350,620 245,685" />
      <path class="ecosystem-pulse pulse-4" d="M 500,545 C 570,575 650,620 755,685" />
    </svg>

    <div class="otodor-hero__core-container" data-3d-slot="security-core">
      <div class="obsidian-monolith__shadow"></div>
      <div class="centerpiece-obelisk">
        <!-- Center Obelisk Slabs (Layered Geometry) -->
        <div class="obelisk-pillar obelisk-pillar--center">
          <div class="pillar-face pillar-face--front">
            <div class="pillar-layer-back"></div>
            <div class="pillar-layer-glow"></div>
            <div class="pillar-layer-front">
              <div class="face-gloss"></div>
              <div class="pillar-logo-container">
                <img class="pillar-logo-icon" src="{{ 'LogoIcon.png' | file_img_url: '80x80' }}" alt="OTODOR Logo" loading="lazy" width="80" height="80">
              </div>
              <div class="pillar-seam pillar-seam--top"></div>
              <div class="pillar-seam pillar-seam--bottom"></div>
            </div>
          </div>
          <div class="pillar-face pillar-face--right"></div>
          <div class="pillar-face pillar-face--left"></div>
          <div class="pillar-face pillar-face--top"></div>
        </div>
        <!-- Left Wing Slab (Layered Geometry) -->
        <div class="obelisk-pillar obelisk-pillar--left-wing">
          <div class="pillar-face pillar-face--front">
            <div class="pillar-layer-back"></div>
            <div class="pillar-layer-glow"></div>
            <div class="pillar-layer-front">
              <div class="face-gloss"></div>
              <div class="pillar-seam"></div>
            </div>
          </div>
          <div class="pillar-face pillar-face--right"></div>
          <div class="pillar-face pillar-face--left"></div>
        </div>
        <!-- Right Wing Slab (Layered Geometry) -->
        <div class="obelisk-pillar obelisk-pillar--right-wing">
          <div class="pillar-face pillar-face--front">
            <div class="pillar-layer-back"></div>
            <div class="pillar-layer-glow"></div>
            <div class="pillar-layer-front">
              <div class="face-gloss"></div>
              <div class="pillar-seam"></div>
            </div>
          </div>
          <div class="pillar-face pillar-face--right"></div>
          <div class="pillar-face pillar-face--left"></div>
        </div>
        <!-- Activation core light source -->
        <div class="centerpiece-internal-glow"></div>
      </div>
    </div>

    <!-- Product reveal runway -->
    <div class="otodor-hero__products-grid">
      
      <!-- Product Node 1: Smart Digital Lock -->
      <div class="otodor-hero__product-node product-node--1" data-product-id="digital-lock" data-3d-slot="product-1">
        <a href="{{ section.settings.p1_link | default: '#' }}" class="otodor-hero__product-card" id="otodor-hero-p1-card">
          <div class="product-card__visual">
            {%- if section.settings.p1_image != blank -%}
              {{ section.settings.p1_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: section.settings.p1_title }}
            {%- else -%}
              <img src="{{ 'zion_front_45.png' | file_img_url: '400x400' }}" loading="lazy" alt="{{ section.settings.p1_title | escape }}" class="product-visual-image" width="400" height="400">
            {%- endif -%}
          </div>
          <div class="product-card__content">
            <span class="product-card__feature">{{ section.settings.p1_feature | escape }}</span>
            <h3 class="product-card__title">{{ section.settings.p1_title | escape }}</h3>
            <p class="product-card__desc">{{ section.settings.p1_desc | escape }}</p>
          </div>
          
          <div class="product-reveal-caption">
            <span class="product-reveal-caption__tag">{{ section.settings.p1_feature | escape }}</span>
            <h3 class="product-reveal-caption__title">{{ section.settings.p1_title | escape }}</h3>
            <p class="product-reveal-caption__desc">{{ section.settings.p1_desc | escape }}</p>
          </div>
        </a>
      </div>

      <!-- Product Node 2: Smart Gate Lock -->
      <div class="otodor-hero__product-node product-node--2" data-product-id="gate-lock" data-3d-slot="product-2">
        <a href="{{ section.settings.p2_link | default: '#' }}" class="otodor-hero__product-card" id="otodor-hero-p2-card">
          <div class="product-card__visual">
            {%- if section.settings.p2_image != blank -%}
              {{ section.settings.p2_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: section.settings.p2_title }}
            {%- else -%}
              <!-- Gate Lock Outline wireframe -->
              <svg class="product-icon-svg" viewBox="0 0 100 100" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
                <rect x="24" y="32" width="52" height="38" rx="6" stroke-width="1.5" />
                <path d="M 36 32 L 36 21 C 36 15, 64 15, 64 21 L 64 32" stroke-width="1.5" stroke-linecap="round" />
                <circle cx="50" cy="51" r="9" stroke-dasharray="2 2" stroke-width="1.2" />
                <circle cx="50" cy="51" r="5" stroke-width="1.5" />
                <path d="M 76 46 L 86 46 L 86 56 L 76 56" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
            {%- endif -%}
          </div>
          <div class="product-card__content">
            <span class="product-card__feature">{{ section.settings.p2_feature | escape }}</span>
            <h3 class="product-card__title">{{ section.settings.p2_title | escape }}</h3>
            <p class="product-card__desc">{{ section.settings.p2_desc | escape }}</p>
          </div>
          
          <div class="product-reveal-caption">
            <span class="product-reveal-caption__tag">{{ section.settings.p2_feature | escape }}</span>
            <h3 class="product-reveal-caption__title">{{ section.settings.p2_title | escape }}</h3>
            <p class="product-reveal-caption__desc">{{ section.settings.p2_desc | escape }}</p>
          </div>
        </a>
      </div>

      <!-- Product Node 3: Fingerprint Padlock -->
      <div class="otodor-hero__product-node product-node--3" data-product-id="fingerprint-padlock" data-3d-slot="product-3">
        <a href="{{ section.settings.p3_link | default: '#' }}" class="otodor-hero__product-card" id="otodor-hero-p3-card">
          <div class="product-card__visual">
            {%- if section.settings.p3_image != blank -%}
              {{ section.settings.p3_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: section.settings.p3_title }}
            {%- else -%}
              <img src="{{ 'armour_front.png' | file_img_url: '400x400' }}" loading="lazy" alt="{{ section.settings.p3_title | escape }}" class="product-visual-image" width="400" height="400">
            {%- endif -%}
          </div>
          <div class="product-card__content">
            <span class="product-card__feature">{{ section.settings.p3_feature | escape }}</span>
            <h3 class="product-card__title">{{ section.settings.p3_title | escape }}</h3>
            <p class="product-card__desc">{{ section.settings.p3_desc | escape }}</p>
          </div>
          
          <div class="product-reveal-caption">
            <span class="product-reveal-caption__tag">{{ section.settings.p3_feature | escape }}</span>
            <h3 class="product-reveal-caption__title">{{ section.settings.p3_title | escape }}</h3>
            <p class="product-reveal-caption__desc">{{ section.settings.p3_desc | escape }}</p>
          </div>
        </a>
      </div>

      <!-- Product Node 4: Sliding Gate Motor -->
      <div class="otodor-hero__product-node product-node--4" data-product-id="sliding-gate-motor" data-3d-slot="product-4">
        <a href="{{ section.settings.p4_link | default: '#' }}" class="otodor-hero__product-card" id="otodor-hero-p4-card">
          <div class="product-card__visual">
            {%- if section.settings.p4_image != blank -%}
              {{ section.settings.p4_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: section.settings.p4_title }}
            {%- else -%}
              <img src="{{ 'sliding_gate_motor_45.png' | file_img_url: '400x400' }}" loading="lazy" alt="{{ section.settings.p4_title | escape }}" class="product-visual-image" width="400" height="400">
            {%- endif -%}
          </div>
          <div class="product-card__content">
            <span class="product-card__feature">{{ section.settings.p4_feature | escape }}</span>
            <h3 class="product-card__title">{{ section.settings.p4_title | escape }}</h3>
            <p class="product-card__desc">{{ section.settings.p4_desc | escape }}</p>
          </div>
          
          <div class="product-reveal-caption">
            <span class="product-reveal-caption__tag">{{ section.settings.p4_feature | escape }}</span>
            <h3 class="product-reveal-caption__title">{{ section.settings.p4_title | escape }}</h3>
            <p class="product-reveal-caption__desc">{{ section.settings.p4_desc | escape }}</p>
          </div>
        </a>
      </div>

    </div>
    </div><!-- /.otodor-hero__stage -->

    <!-- Final Ecosystem / CTA Screen -->
    <div class="otodor-hero__text-container">
      <div class="otodor-hero__text-frame frame--final">
        <h2 class="otodor-hero__heading">
          {{- section.settings.final_heading | escape -}}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="otodor-hero__subheading">{{- section.settings.subheading | escape -}}</p>
        {%- endif -%}
        
        <div class="otodor-hero__actions">
          {%- if section.settings.cta_primary_label != blank -%}
            <a href="{{ section.settings.cta_primary_link | default: '/collections/all' }}" class="otodor-btn otodor-btn--primary">
              {{- section.settings.cta_primary_label | escape -}}
            </a>
          {%- endif -%}
          
          {%- if section.settings.cta_secondary_label != blank -%}
            <a href="{{ section.settings.cta_secondary_link | default: '#' }}" class="otodor-btn otodor-btn--secondary">
              {{- section.settings.cta_secondary_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  'use strict';

  var section = document.getElementById('otodor-hero-{{ section.id }}');
  if (!section) return;

  /* ── Scroll Guide Indicator click ────────────────────────── */
  var scrollBtn = section.querySelector('[data-scroll-indicator]');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', function () {
      var nextSection = section.closest('.shopify-section')
        ? section.closest('.shopify-section').nextElementSibling
        : section.nextElementSibling;
      if (nextSection) {
        nextSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        window.scrollBy({ top: window.innerHeight * 0.85, behavior: 'smooth' });
      }
    });
  }

  /* ── GSAP Pinned Scroll Animation ────────────────────────── */
  function initHeroAnimation() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      console.warn('[OTODOR] GSAP/ScrollTrigger not loaded. Using static CSS layout.');
      return;
    }
    
    // Respect reduced motion settings
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    if (!isDesktop) {
      initMobileReveals();
      return;
    }

    // Active animation styling flag
    section.classList.add('js-animated');

    // Float particles randomly in an infinite loop (Volumetric atmosphere)
    var particles = section.querySelectorAll('.particle');
    particles.forEach(function (p, i) {
      // Distribute particles randomly across viewport
      var randomX = Math.random() * 100;
      var randomY = Math.random() * 100;
      gsap.set(p, {
        left: randomX + '%',
        top: randomY + '%',
        scale: 0.5 + Math.random() * 1.0,
        opacity: 0.05 + Math.random() * 0.2
      });

      // Continuous rising motion with random parameters
      gsap.to(p, {
        y: -400 - Math.random() * 200,
        x: (Math.random() > 0.5 ? 40 : -40) * Math.random(),
        opacity: 0.0,
        duration: 12 + Math.random() * 10,
        repeat: -1,
        ease: 'none',
        delay: -Math.random() * 20
      });
    });

    // Create ScrollTrigger Timeline for desktop scrubbing (scrub: 1)
    var tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=500%', // Pinned scroll track height
        scrub: 1,
        pin: true,
        anticipatePin: 1
      }
    });

    var viewport = section.querySelector('.otodor-hero__viewport');
    var stage = section.querySelector('.otodor-hero__stage');
    var centerpiece = section.querySelector('.centerpiece-obelisk');
    
    var centerPillar = section.querySelector('.obelisk-pillar--center');
    var leftWing = section.querySelector('.obelisk-pillar--left-wing');
    var rightWing = section.querySelector('.obelisk-pillar--right-wing');
    var internalGlow = section.querySelector('.centerpiece-internal-glow');
    var seams = centerpiece.querySelectorAll('.pillar-seam');
    var plateGlows = centerpiece.querySelectorAll('.pillar-layer-glow');
    
    var node1 = section.querySelector('.product-node--1');
    var node2 = section.querySelector('.product-node--2');
    var node3 = section.querySelector('.product-node--3');
    var node4 = section.querySelector('.product-node--4');
    var nodes = [node1, node2, node3, node4];

    var captions = nodes.map(function (node) {
      return node.querySelector('.product-reveal-caption');
    });

    var frameIntro = section.querySelector('.frame--intro');
    var frameFinal = section.querySelector('.frame--final');
    var vaultPedestal = section.querySelector('.otodor-hero__vault-pedestal');
    var coreContainer = section.querySelector('.otodor-hero__core-container');
    var productsGrid = section.querySelector('.otodor-hero__products-grid');

    var ray1 = section.querySelector('.ray--1');
    var ray2 = section.querySelector('.ray--2');
    var connectionsSvg = section.querySelector('.otodor-hero__connections-svg');

    var paths = [
      section.querySelector('.path-1'),
      section.querySelector('.path-2'),
      section.querySelector('.path-3'),
      section.querySelector('.path-4')
    ];
    var pulses = section.querySelectorAll('.ecosystem-pulse');

    // Wide orbit — responsive footprint with a clean central exclusion zone
    // node1/node2: upper diagonal, node3/node4: lower diagonal
    var orbitX = Math.min(Math.max(window.innerWidth * 0.28, 360), 500);
    var orbitY = Math.min(Math.max(window.innerHeight * 0.27, 250), 340);
    var finalSlots = [
      { x: -orbitX, y: -orbitY },
      { x: orbitX, y: -orbitY },
      { x: -orbitX, y: orbitY * 0.42 },
      { x: orbitX, y: orbitY * 0.42 }
    ];
    var entryVectors = [
      { x: -170, y: -90, rotation: -10 },
      { x: 170, y: -90, rotation: 12 },
      { x: -170, y: 120, rotation: -12 },
      { x: 170, y: 120, rotation: 8 }
    ];
    var spotlightScale = 1.24;
    var settledScale = 1.0;
    var lineupScale = spotlightScale;

    // ── Initial state ─────────────────────────────────────────
    gsap.set(centerPillar, { xPercent: -50, yPercent: -50, z: 0 });
    gsap.set(leftWing, { xPercent: -50, yPercent: -50, x: -124, z: -26 });
    gsap.set(rightWing, { xPercent: -50, yPercent: -50, x: 124, z: -26 });
    gsap.set(centerpiece, { transformOrigin: '50% 50%' });
    gsap.set(nodes, { xPercent: -50, yPercent: -50, opacity: 0.14, scale: 0.82, rotation: 0 });
    gsap.set(captions, { opacity: 0, x: 16 });
    gsap.set(productsGrid, { pointerEvents: 'none' });
    if (connectionsSvg) gsap.set(connectionsSvg, { opacity: 0.95 });

    if (stage) {
      tl.fromTo(stage,
        { scale: 1 },
        { scale: 1.08, duration: 8.9, ease: 'sine.inOut' },
        0
      );
    }

    if (ray1) {
      gsap.to(ray1, { opacity: 0.06, duration: 7, repeat: -1, yoyo: true, ease: 'sine.inOut' });
    }
    if (ray2) {
      gsap.to(ray2, { opacity: 0.04, duration: 9, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 2.5 });
    }

    function hideAllNarratives() {
      gsap.set(captions, { opacity: 0, x: 16 });
    }

    function revealProduct(node, caption, slotIndex, time) {
      var slot = finalSlots[slotIndex];
      var entry = entryVectors[slotIndex];
      var startX = slot.x + entry.x;
      var startY = slot.y + entry.y;

      gsap.set(node, {
        xPercent: -50,
        yPercent: -50,
        x: startX,
        y: startY,
        rotation: entry.rotation,
        opacity: 0.14,
        scale: 0.84,
        zIndex: 44
      });

      tl.call(function () {
        nodes.forEach(function (n) {
          n.classList.remove('is-spotlight');
        });
        node.classList.add('is-spotlight');
      }, null, time);

      tl.to(node, {
        opacity: 1,
        scale: spotlightScale,
        x: slot.x,
        y: slot.y,
        rotation: 0,
        duration: 1.35,
        ease: 'power4.out'
      }, time);

      tl.to(caption, {
        opacity: 1,
        x: 0,
        duration: 0.95,
        ease: 'power3.out'
      }, time + 0.45);

      if (paths[slotIndex]) {
        tl.to(paths[slotIndex], {
          stroke: 'rgba(77, 166, 255, 0.46)',
          duration: 0.85,
          ease: 'power3.out'
        }, time + 0.5);
        tl.call(function () {
          paths[slotIndex].classList.add('ecosystem-path-active');
        }, null, time + 0.5);
      }
    }

    function settleProduct(node, caption, time) {
      tl.call(function () {
        node.classList.remove('is-spotlight');
      }, null, time);

      tl.to(node, {
        opacity: 0.68,
        scale: settledScale,
        zIndex: 28,
        duration: 0.8,
        ease: 'power3.inOut'
      }, time);
      tl.to(caption, {
        opacity: 0,
        x: 10,
        duration: 0.55,
        ease: 'power3.inOut'
      }, time);
    }

    // ── Scene 1: Vault only — anticipation ────────────────────
    tl.fromTo(vaultPedestal,
      { opacity: 0.25, scale: 0.9 },
      { opacity: 1, scale: 1, duration: 2.1, ease: 'power3.out' },
      0
    );

    tl.fromTo(centerpiece,
      { scale: 0.72, opacity: 0.35, rotationY: -24, rotationX: 12 },
      { scale: 1, opacity: 1, rotationY: -12, rotationX: 10, duration: 2.1, ease: 'power4.out' },
      0
    );

    if (internalGlow) {
      tl.fromTo(internalGlow,
        { scale: 0.85, opacity: 0.18 },
        { scale: 1, opacity: 0.42, duration: 2.0, ease: 'power3.out' },
        0.2
      );
    }

    tl.fromTo('.otodor-hero__glow-core',
      { scale: 0.9, opacity: 0.22 },
      { scale: 1, opacity: 0.55, duration: 2.1, ease: 'power3.out' },
      0
    );

    tl.fromTo(frameIntro,
      { opacity: 1, y: 0, pointerEvents: 'auto' },
      { opacity: 0, y: -24, pointerEvents: 'none', duration: 1.0, ease: 'power2.inOut' },
      1.0
    );

    // ── Scene 2: Digital Lock enters from above ───────────────
    var s2 = 1.8;
    hideAllNarratives();
    revealProduct(node1, captions[0], 0, s2);
    tl.to(centerpiece, { rotationY: -10, rotationX: 9, duration: 1.0, ease: 'power1.inOut' }, s2);

    // ── Scene 3: Gate Lock enters from right ──────────────────
    var s3 = 3.2;
    settleProduct(node1, captions[0], s3 - 0.3);
    revealProduct(node2, captions[1], 1, s3);

    // ── Scene 4: Padlock enters from left ───────────────────
    var s4 = 4.6;
    settleProduct(node2, captions[1], s4 - 0.3);
    revealProduct(node3, captions[2], 2, s4);

    // ── Scene 5: Gate Motor enters from below ─────────────────
    var s5 = 6.0;
    settleProduct(node3, captions[2], s5 - 0.3);
    revealProduct(node4, captions[3], 3, s5);

    // ── Scene 6: Full ecosystem — illuminate, pulse, activate ─
    var s6 = 7.4;

    tl.to(captions[3], { opacity: 0, x: 10, duration: 0.55, ease: 'power3.inOut' }, s6 - 0.15);

    // Vault lifts and activates — orbit ring moves with core
    tl.to(coreContainer, { y: -28, duration: 1.75, ease: 'power4.out' }, s6);
    tl.to(vaultPedestal, { y: -28, duration: 1.75, ease: 'power4.out' }, s6);
    tl.to(productsGrid, { y: -28, duration: 1.75, ease: 'power4.out' }, s6);
    if (connectionsSvg) tl.to(connectionsSvg, { y: -28, duration: 1.75, ease: 'power4.out' }, s6);
    tl.to(centerpiece, {
      rotationY: 0,
      rotationX: 6,
      scale: 0.98,
      duration: 1.75,
      ease: 'power4.out'
    }, s6);
    tl.to(leftWing, { x: -112, duration: 1.65, ease: 'power4.out' }, s6);
    tl.to(rightWing, { x: 112, duration: 1.65, ease: 'power4.out' }, s6);

    if (internalGlow) {
      tl.to(internalGlow, {
        scale: 1.16,
        opacity: 0.65,
        background: 'radial-gradient(circle, rgba(77, 166, 255, 0.62) 0%, transparent 70%)',
        duration: 1.7,
        ease: 'power4.out'
      }, s6);
    }

    if (plateGlows.length) {
      tl.to(plateGlows, {
        background: 'rgba(77, 166, 255, 0.7)',
        opacity: 0.85,
        duration: 1.6,
        ease: 'power3.out'
      }, s6);
    }

    if (seams.length) {
      tl.to(seams, {
        background: 'rgba(255, 255, 255, 0.95)',
        boxShadow: '0 0 10px rgba(77, 166, 255, 0.85)',
        duration: 1.6,
        ease: 'power3.out'
      }, s6);
    }

    var logoIcon = centerpiece.querySelector('.pillar-logo-icon');
    if (logoIcon) {
      tl.to(logoIcon, {
        filter: 'drop-shadow(0 0 8px rgba(77, 166, 255, 0.8)) brightness(1.15)',
        scale: 1.08,
        duration: 1.6,
        ease: 'power3.out'
      }, s6);
    }

    tl.to(vaultPedestal, { opacity: 0.86, scale: 1.0, duration: 1.55, ease: 'power3.out' }, s6);
    tl.to('.otodor-hero__glow-core', { opacity: 0.55, scale: 1.02, duration: 1.55, ease: 'power3.out' }, s6);

    tl.call(function () {
      nodes.forEach(function (node) {
        node.classList.remove('is-spotlight');
        node.classList.add('is-ecosystem-active');
      });
    }, null, s6 + 0.18);

    // Network illuminates
    paths.forEach(function (path) {
      if (path) {
        tl.to(path, {
          stroke: 'rgba(77, 166, 255, 0.68)',
          duration: 1.25,
          ease: 'sine.inOut'
        }, s6);
        tl.call(function () {
          path.classList.add('ecosystem-path-illuminated');
        }, null, s6);
      }
    });

    // Pulse travels through all connections once
    if (pulses.length) {
      tl.set(pulses, { opacity: 1 }, s6 + 0.15);
      tl.fromTo(pulses,
        { strokeDashoffset: 0 },
        { strokeDashoffset: -560, duration: 1.3, ease: 'sine.inOut' },
        s6 + 0.15
      );
      tl.to(pulses, { opacity: 0, duration: 0.45, ease: 'sine.inOut' }, s6 + 1.35);
    }

    // All four products at full orbit presence
    nodes.forEach(function (node, i) {
      tl.to(node, {
        opacity: 1,
        scale: lineupScale,
        x: finalSlots[i].x,
        y: finalSlots[i].y,
        rotation: 0,
        zIndex: 34,
        duration: 1.25,
        ease: 'power4.out'
      }, s6 + 0.25 + i * 0.06);
    });

    tl.set(productsGrid, { pointerEvents: 'auto' }, s6 + 1.0);

    // Final headline & CTAs — payoff moment
    tl.fromTo(frameFinal,
      { opacity: 0, y: 36, pointerEvents: 'none' },
      { opacity: 1, y: 0, pointerEvents: 'auto', duration: 1.2, ease: 'power3.out' },
      s6 + 1.55
    );
  }

  /* ── GSAP Mobile Stack reveals ───────────────────────────── */
  function initMobileReveals() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    var monolith = section.querySelector('.centerpiece-obelisk');
    if (monolith) {
      gsap.fromTo(monolith,
        { scale: 0.6, opacity: 0 },
        {
          scale: 1,
          opacity: 1,
          duration: 1.2,
          scrollTrigger: {
            trigger: monolith,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    var nodes = section.querySelectorAll('.otodor-hero__product-node');
    nodes.forEach(function (node) {
      gsap.fromTo(node,
        { y: 30, opacity: 0, scale: 0.95 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          scrollTrigger: {
            trigger: node,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        }
      );
    });
  }

  // Load handler
  if (document.readyState === 'complete') {
    initHeroAnimation();
  } else {
    window.addEventListener('load', initHeroAnimation, { once: true });
  }

  // Support theme customizer edits dynamically
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') {
      initHeroAnimation();
    }
  });

})();
</script>

