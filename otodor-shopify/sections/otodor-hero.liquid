<script>
(function () {
  'use strict';

  var section = document.getElementById('otodor-hero-{{ section.id }}');
  if (!section) return;

  /* ── Scroll Guide Indicator click ────────────────────────── */
  var scrollBtn = section.querySelector('[data-scroll-indicator]');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', function () {
      var nextSection = section.closest('.shopify-section')
        ? section.closest('.shopify-section').nextElementSibling
        : section.nextElementSibling;
      if (nextSection) {
        nextSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        window.scrollBy({ top: window.innerHeight * 0.85, behavior: 'smooth' });
      }
    });
  }

  /* ── GSAP Pinned Scroll Animation ────────────────────────── */
  function initHeroAnimation() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      console.warn('[OTODOR] GSAP/ScrollTrigger not loaded. Using static CSS layout.');
      return;
    }
    
    // Respect reduced motion settings
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    if (!isDesktop) {
      initMobileReveals();
      return;
    }

    // Active animation styling flag
    section.classList.add('js-animated');

    // Float particles randomly in an infinite loop (Volumetric atmosphere)
    var particles = section.querySelectorAll('.particle');
    particles.forEach(function (p, i) {
      // Distribute particles randomly across viewport
      var randomX = Math.random() * 100;
      var randomY = Math.random() * 100;
      gsap.set(p, {
        left: randomX + '%',
        top: randomY + '%',
        scale: 0.5 + Math.random() * 1.0,
        opacity: 0.05 + Math.random() * 0.2
      });

      // Continuous rising motion with random parameters
      gsap.to(p, {
        y: -400 - Math.random() * 200,
        x: (Math.random() > 0.5 ? 40 : -40) * Math.random(),
        opacity: 0.0,
        duration: 12 + Math.random() * 10,
        repeat: -1,
        ease: 'none',
        delay: -Math.random() * 20
      });
    });

    // Create ScrollTrigger Timeline for desktop scrubbing (scrub: 1)
    var tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=500%', // Pinned scroll track height
        scrub: 1,
        pin: true,
        anticipatePin: 1
      }
    });

    var viewport = section.querySelector('.otodor-hero__viewport');
    var centerpiece = section.querySelector('.centerpiece-obelisk');
    
    var centerPillar = section.querySelector('.obelisk-pillar--center');
    var leftWing = section.querySelector('.obelisk-pillar--left-wing');
    var rightWing = section.querySelector('.obelisk-pillar--right-wing');
    var internalGlow = section.querySelector('.centerpiece-internal-glow');
    var seams = centerpiece.querySelectorAll('.pillar-seam');
    var plateGlows = centerpiece.querySelectorAll('.pillar-layer-glow');
    
    var node1 = section.querySelector('.product-node--1');
    var node2 = section.querySelector('.product-node--2');
    var node3 = section.querySelector('.product-node--3');
    var node4 = section.querySelector('.product-node--4');
    var nodes = [node1, node2, node3, node4];
    
    var callout1 = node1.querySelector('.product-callout');
    var callout2 = node2.querySelector('.product-callout');
    var callout3 = node3.querySelector('.product-callout');
    var callout4 = node4.querySelector('.product-callout');

    var pLine1 = callout1.querySelector('.product-callout__pointer-line');
    var pLine2 = callout2.querySelector('.product-callout__pointer-line');
    var pLine3 = callout3.querySelector('.product-callout__pointer-line');
    var pLine4 = callout4.querySelector('.product-callout__pointer-line');

    var pContent1 = callout1.querySelector('.product-callout__content');
    var pContent2 = callout2.querySelector('.product-callout__content');
    var pContent3 = callout3.querySelector('.product-callout__content');
    var pContent4 = callout4.querySelector('.product-callout__content');
    
    var path1 = section.querySelector('.path-1');
    var path2 = section.querySelector('.path-2');
    var path3 = section.querySelector('.path-3');
    var path4 = section.querySelector('.path-4');
    var paths = [path1, path2, path3, path4];
    
    var dot1 = section.querySelector('.dot-1');
    var dot2 = section.querySelector('.dot-2');
    var dot3 = section.querySelector('.dot-3');
    var dot4 = section.querySelector('.dot-4');
    var dots = [dot1, dot2, dot3, dot4];

    var frameIntro = section.querySelector('.frame--intro');
    var frameFinal = section.querySelector('.frame--final');

    var ray1 = section.querySelector('.ray--1');
    var ray2 = section.querySelector('.ray--2');

    // ── 0. Set Initial 3D Positions & Ambient rays ─────────────
    gsap.set(centerPillar, { xPercent: -50, yPercent: -50, z: 0 });
    gsap.set(leftWing, { xPercent: -50, yPercent: -50, x: -50, z: -16 });
    gsap.set(rightWing, { xPercent: -50, yPercent: -50, x: 50, z: -16 });

    // Slow pulse opacity of volumetric rays over time (runs independently of scroll)
    if (ray1) {
      gsap.to(ray1, {
        opacity: 0.07,
        duration: 7,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut'
      });
    }
    if (ray2) {
      gsap.to(ray2, {
        opacity: 0.05,
        duration: 9,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
        delay: 2.5
      });
    }

    // ── 1. Gradual Camera Pullback & Parallax ambient shifts ─────────────
    tl.fromTo(viewport,
      { scale: 1.15 },
      { scale: 1.00, ease: 'power1.inOut', duration: 9 },
      0
    );

    tl.fromTo('.otodor-hero__ambient',
      { y: -40, scale: 0.97 },
      { y: 40, scale: 1.03, ease: 'power1.inOut', duration: 9 },
      0
    );

    tl.fromTo('.otodor-hero__glow-core',
      { scale: 0.85 },
      { scale: 1.15, ease: 'power1.inOut', duration: 9 },
      0
    );

    // ── Scene 1: Monolith emerges & starts rotating, Intro headline fades out ───────
    tl.fromTo(centerpiece,
      { scale: 0.85, opacity: 0.5, rotationY: -35, rotationX: 18 },
      { scale: 1.0, opacity: 1.0, rotationY: -15, rotationX: 12, duration: 7.4, ease: 'none' },
      0
    );
    if (internalGlow) {
      tl.fromTo(internalGlow, { scale: 0.85, opacity: 0.15 }, { scale: 1.0, opacity: 0.7, duration: 1.5 }, 0);
    }
    
    tl.fromTo(frameIntro,
      { opacity: 1, y: 0, pointerEvents: 'auto' },
      { opacity: 0, y: -40, pointerEvents: 'none', duration: 1.0 },
      0.6
    );

    // ── Scene 2: Digital Lock slides in & connects ────────────
    tl.fromTo(node1,
      { opacity: 0, scale: 0.8, x: -60, y: -40 },
      { opacity: 0.9, scale: 1.0, x: 0, y: 0, duration: 1.2, ease: 'power2.out' },
      1.5
    );
    if (path1) {
      tl.to(path1, { stroke: 'rgba(77, 166, 255, 0.45)', duration: 0.5 }, 1.5);
      tl.call(function () { path1.classList.add('network-path-active'); }, null, 1.5);
    }
    if (dot1) {
      tl.call(function () { dot1.classList.add('network-dot-active'); }, null, 1.5);
    }
    
    // Callout diagnostic pointer reveal
    tl.to(callout1, { opacity: 1, duration: 0.4 }, 1.8);
    tl.fromTo(pLine1, { height: 0, opacity: 0 }, { height: 24, opacity: 1, duration: 0.5, ease: 'power1.out' }, 1.9);
    tl.fromTo(pContent1, { opacity: 0, y: 8 }, { opacity: 0.9, y: 0, duration: 0.6, ease: 'power2.out' }, 2.1);

    // ── Scene 3: Gate Lock slides in & connects ───────────────
    tl.fromTo(node2,
      { opacity: 0, scale: 0.8, x: 60, y: -40 },
      { opacity: 0.9, scale: 1.0, x: 0, y: 0, duration: 1.2, ease: 'power2.out' },
      3.0
    );
    if (path2) {
      tl.to(path2, { stroke: 'rgba(77, 166, 255, 0.45)', duration: 0.5 }, 3.0);
      tl.call(function () { path2.classList.add('network-path-active'); }, null, 3.0);
    }
    if (dot2) {
      tl.call(function () { dot2.classList.add('network-dot-active'); }, null, 3.0);
    }
    
    tl.to(callout2, { opacity: 1, duration: 0.4 }, 3.3);
    tl.fromTo(pLine2, { height: 0, opacity: 0 }, { height: 24, opacity: 1, duration: 0.5, ease: 'power1.out' }, 3.4);
    tl.fromTo(pContent2, { opacity: 0, y: 8 }, { opacity: 0.9, y: 0, duration: 0.6, ease: 'power2.out' }, 3.6);

    // ── Scene 4: Fingerprint Padlock slides in & connects ──────
    tl.fromTo(node3,
      { opacity: 0, scale: 0.8, x: -60, y: 40 },
      { opacity: 0.9, scale: 1.0, x: 0, y: 0, duration: 1.2, ease: 'power2.out' },
      4.5
    );
    if (path3) {
      tl.to(path3, { stroke: 'rgba(77, 166, 255, 0.45)', duration: 0.5 }, 4.5);
      tl.call(function () { path3.classList.add('network-path-active'); }, null, 4.5);
    }
    if (dot3) {
      tl.call(function () { dot3.classList.add('network-dot-active'); }, null, 4.5);
    }
    
    tl.to(callout3, { opacity: 1, duration: 0.4 }, 4.8);
    tl.fromTo(pLine3, { height: 0, opacity: 0 }, { height: 24, opacity: 1, duration: 0.5, ease: 'power1.out' }, 4.9);
    tl.fromTo(pContent3, { opacity: 0, y: 8 }, { opacity: 0.9, y: 0, duration: 0.6, ease: 'power2.out' }, 5.1);

    // ── Scene 5: Sliding Gate Motor slides in & connects ───────
    tl.fromTo(node4,
      { opacity: 0, scale: 0.8, x: 60, y: 40 },
      { opacity: 0.9, scale: 1.0, x: 0, y: 0, duration: 1.2, ease: 'power2.out' },
      6.0
    );
    if (path4) {
      tl.to(path4, { stroke: 'rgba(77, 166, 255, 0.45)', duration: 0.5 }, 6.0);
      tl.call(function () { path4.classList.add('network-path-active'); }, null, 6.0);
    }
    if (dot4) {
      tl.call(function () { dot4.classList.add('network-dot-active'); }, null, 6.0);
    }
    
    tl.to(callout4, { opacity: 1, duration: 0.4 }, 6.3);
    tl.fromTo(pLine4, { height: 0, opacity: 0 }, { height: 24, opacity: 1, duration: 0.5, ease: 'power1.out' }, 6.4);
    tl.fromTo(pContent4, { opacity: 0, y: 8 }, { opacity: 0.9, y: 0, duration: 0.6, ease: 'power2.out' }, 6.6);

    // ── Scene 6: Ecosystem Final Assembly & Power Activation ──
    var finalStart = 7.4;
    
    // 1. Rotate centerpiece obelisk to front view
    tl.to(centerpiece, { rotationY: 0, rotationX: 8, scale: 1.08, duration: 1.6, ease: 'power2.out' }, finalStart);
    
    // 2. Mechanical wing sliding shift (Left wing shifts left, Right shifts right)
    tl.to(leftWing, { x: -68, duration: 1.5, ease: 'power3.out' }, finalStart);
    tl.to(rightWing, { x: 68, duration: 1.5, ease: 'power3.out' }, finalStart);
    
    // 3. Core energy flare / activation light & glowing seams
    if (internalGlow) {
      tl.to(internalGlow, {
        scale: 2.2,
        opacity: 0.95,
        background: 'radial-gradient(circle, rgba(77, 166, 255, 0.95) 0%, transparent 70%)',
        filter: 'blur(20px)',
        duration: 1.6,
        ease: 'power3.out'
      }, finalStart);
    }

    if (plateGlows.length) {
      tl.to(plateGlows, {
        background: 'rgba(77, 166, 255, 0.9)',
        opacity: 0.95,
        filter: 'blur(8px)',
        duration: 1.5,
        ease: 'power2.out'
      }, finalStart);
    }

    if (seams.length) {
      tl.to(seams, {
        background: '#FFFFFF',
        boxShadow: '0 0 12px rgba(77, 166, 255, 1), 0 0 4px #FFFFFF',
        duration: 1.5,
        ease: 'power2.out'
      }, finalStart);
    }

    var logoIcon = centerpiece.querySelector('.pillar-logo-icon');
    if (logoIcon) {
      tl.to(logoIcon, {
        filter: 'drop-shadow(0 0 10px rgba(77, 166, 255, 0.95)) brightness(1.2)',
        scale: 1.1,
        duration: 1.5,
        ease: 'power2.out'
      }, finalStart);
    }

    // 4. Animate a bright energy pulse through all connection paths (flowing outwards)
    var pulses = section.querySelectorAll('.network-pulse');
    if (pulses.length) {
      tl.set(pulses, { opacity: 1 }, finalStart);
      tl.fromTo(pulses,
        { strokeDashoffset: 0 },
        { strokeDashoffset: -450, duration: 1.2, ease: 'power1.inOut' },
        finalStart
      );
      tl.to(pulses, { opacity: 0, duration: 0.4 }, finalStart + 1.2);
    }

    // Also intensify back network lines
    paths.forEach(function (path) {
      if (path) {
        tl.to(path, {
          stroke: 'rgba(77, 166, 255, 0.85)',
          strokeWidth: 1.5,
          duration: 1.5,
          ease: 'power2.out'
        }, finalStart);
      }
    });

    dots.forEach(function (dot) {
      if (dot) {
        tl.to(dot, {
          r: 5.0,
          opacity: 1.0,
          duration: 1.0
        }, finalStart);
      }
    });

    // 5. Coordinated node activation pulse (all nodes illuminate simultaneously when pulse arrives)
    nodes.forEach(function (node) {
      tl.to(node, {
        scale: 1.05,
        opacity: 1.0,
        duration: 1.2,
        ease: 'power3.out'
      }, finalStart + 0.8);
      
      var visual = node.querySelector('.product-card__visual');
      if (visual) {
        tl.to(visual, {
          filter: 'drop-shadow(0 0 30px rgba(77, 166, 255, 0.7))',
          duration: 1.2,
          ease: 'power3.out'
        }, finalStart + 0.8);
      }
      
      var tag = node.querySelector('.product-callout__tag');
      if (tag) {
        tl.to(tag, {
          color: '#FFFFFF',
          textShadow: '0 0 10px rgba(77, 166, 255, 0.8), 0 0 2px #FFFFFF',
          duration: 1.2,
          ease: 'power3.out'
        }, finalStart + 0.8);
      }

      var pointerLine = node.querySelector('.product-callout__pointer-line');
      if (pointerLine) {
        tl.to(pointerLine, {
          background: 'linear-gradient(180deg, rgba(77, 166, 255, 0.95), transparent)',
          duration: 1.2,
          ease: 'power3.out'
        }, finalStart + 0.8);
      }

      var calloutContent = node.querySelector('.product-callout__content');
      if (calloutContent) {
        tl.to(calloutContent, {
          opacity: 1.0,
          duration: 1.2,
          ease: 'power3.out'
        }, finalStart + 0.8);
      }
    });

    // 6. Fade in final frame typography & CTAs
    tl.fromTo(frameFinal,
      { opacity: 0, y: 45, pointerEvents: 'none' },
      { opacity: 1, y: 0, pointerEvents: 'auto', duration: 1.2, ease: 'power2.out' },
      finalStart + 0.8
    );
  }

  /* ── GSAP Mobile Stack reveals ───────────────────────────── */
  function initMobileReveals() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    var monolith = section.querySelector('.centerpiece-obelisk');
    if (monolith) {
      gsap.fromTo(monolith,
        { scale: 0.8, opacity: 0 },
        {
          scale: 1,
          opacity: 1,
          duration: 1.0,
          scrollTrigger: {
            trigger: monolith,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    var nodes = section.querySelectorAll('.otodor-hero__product-node');
    nodes.forEach(function (node) {
      gsap.fromTo(node,
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          scrollTrigger: {
            trigger: node,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        }
      );
    });
  }

  // Load handler
  if (document.readyState === 'complete') {
    initHeroAnimation();
  } else {
    window.addEventListener('load', initHeroAnimation, { once: true });
  }

  // Support theme customizer edits dynamically
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') {
      initHeroAnimation();
    }
  });

})();
</script>

