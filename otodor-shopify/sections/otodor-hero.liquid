{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Hero Section
     Dark Luxury Technology — Cinematic Ecosystem Assembly.
  ───────────────────────────────────────────────────────── */

  #shopify-section-{{ section.id }} {
    display: block;
    background-color: #0b0b0b;
    overflow: hidden;
  }

  /* ─ Base layout: Mobile First ──────────────────────────────── */
  .otodor-hero {
    background-color: #0b0b0b;
    color: #ffffff;
    padding: 5rem 1.5rem 4rem;
    position: relative;
    overflow: hidden;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .otodor-hero__viewport {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    transform-origin: center center;
    will-change: transform;
  }

  /* ─ Atmospheric Depth & Fog ────────────────────────────────── */
  .otodor-hero__ambient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .otodor-hero__glow-top {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 120%;
    height: 60%;
    background: radial-gradient(ellipse, rgba(77, 166, 255, 0.14) 0%, transparent 70%);
  }

  .otodor-hero__glow-bottom {
    position: absolute;
    bottom: -15%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    height: 50%;
    background: radial-gradient(ellipse, rgba(77, 166, 255, 0.05) 0%, transparent 70%);
  }

  .otodor-hero__glow-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(77, 166, 255, 0.07) 0%, transparent 70%);
    filter: blur(55px);
    pointer-events: none;
    z-index: 1;
    will-change: transform, opacity;
  }

  .otodor-hero__fog-cloud {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(40px);
    pointer-events: none;
  }

  .otodor-hero__fog-cloud--back {
    width: 150%;
    height: 150%;
    background: radial-gradient(ellipse at center, rgba(77, 166, 255, 0.04) 0%, transparent 65%);
    animation: fog-drift-back 35s ease-in-out infinite alternate;
    z-index: 1;
  }

  .otodor-hero__fog-cloud--front {
    width: 120%;
    height: 120%;
    background: radial-gradient(ellipse at center, rgba(77, 166, 255, 0.02) 0%, transparent 55%);
    animation: fog-drift-front 24s ease-in-out infinite alternate;
    z-index: 3;
  }

  @keyframes fog-drift-back {
    0% { transform: translate(-52%, -48%) scale(1.0); }
    100% { transform: translate(-48%, -52%) scale(1.1); }
  }

  @keyframes fog-drift-front {
    0% { transform: translate(-47%, -53%) scale(0.95); }
    100% { transform: translate(-53%, -47%) scale(1.05); }
  }

  /* Volumetric light rays */
  .otodor-hero__light-ray {
    position: absolute;
    top: -50%;
    width: 450px;
    height: 200%;
    background: linear-gradient(105deg, rgba(77, 166, 255, 0.05) 0%, transparent 60%);
    transform: rotate(-15deg);
    filter: blur(45px);
    pointer-events: none;
    z-index: 1;
    will-change: transform, opacity;
  }

  .ray--1 {
    left: 15%;
  }

  .ray--2 {
    left: 58%;
    width: 380px;
    background: linear-gradient(105deg, rgba(77, 166, 255, 0.03) 0%, transparent 50%);
    transform: rotate(-12deg);
  }

  /* ─ Floating Atmospheric Particles (20 items) ────────────────── */
  .otodor-hero__particles {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    background: rgba(77, 166, 255, 0.16);
    border-radius: 50%;
    filter: blur(0.5px);
    will-change: transform, opacity;
  }

  /* Fallback values for CSS if JS is disabled */
  .particle--1  { width: 4px;  height: 4px;  left: 12%; top: 80%; }
  .particle--2  { width: 2px;  height: 2px;  left: 32%; top: 90%; }
  .particle--3  { width: 5px;  height: 5px;  left: 52%; top: 85%; }
  .particle--4  { width: 3px;  height: 3px;  left: 72%; top: 75%; }
  .particle--5  { width: 4px;  height: 4px;  left: 88%; top: 60%; }
  .particle--6  { width: 2px;  height: 2px;  left: 22%; top: 40%; }
  .particle--7  { width: 4px;  height: 4px;  left: 42%; top: 30%; }
  .particle--8  { width: 3px;  height: 3px;  left: 62%; top: 20%; }
  .particle--9  { width: 5px;  height: 5px;  left: 92%; top: 15%; }
  .particle--10 { width: 3px;  height: 3px;  left: 8%;  top: 55%; }
  .particle--11 { width: 4px;  height: 4px;  left: 48%; top: 72%; }
  .particle--12 { width: 2px;  height: 2px;  left: 68%; top: 48%; }
  .particle--13 { width: 5px;  height: 5px;  left: 18%; top: 70%; }
  .particle--14 { width: 3px;  height: 3px;  left: 38%; top: 65%; }
  .particle--15 { width: 4px;  height: 4px;  left: 58%; top: 50%; }
  .particle--16 { width: 2px;  height: 2px;  left: 78%; top: 35%; }
  .particle--17 { width: 4px;  height: 4px;  left: 83%; top: 25%; }
  .particle--18 { width: 3px;  height: 3px;  left: 28%; top: 18%; }
  .particle--19 { width: 5px;  height: 5px;  left: 60%; top: 10%; }
  .particle--20 { width: 2px;  height: 2px;  left: 95%; top: 5%; }

  /* ─ Security Core: Symmetrical Layered Obsidian Obelisk ──────── */
  .otodor-hero__core-container {
    position: relative;
    width: 180px;
    height: 300px;
    perspective: 1000px;
    margin: 1.5rem auto;
    z-index: 5;
  }

  .centerpiece-obelisk {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transform: rotateY(-20deg) rotateX(15deg);
    will-change: transform, opacity;
  }

  .obelisk-pillar {
    position: absolute;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .pillar-face {
    position: absolute;
    background: linear-gradient(135deg, #181818 0%, #060606 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.85);
  }

  /* Symmetrical plate layering inside front face */
  .pillar-layer-back {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f0f0f 0%, #040404 100%);
    border: 1px solid rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.9);
  }

  .pillar-layer-glow {
    position: absolute;
    inset: 3px;
    background: rgba(77, 166, 255, 0.18);
    filter: blur(4px);
    opacity: 0.5;
    pointer-events: none;
    transition: background 300ms ease, opacity 300ms ease;
  }

  .pillar-layer-front {
    position: absolute;
    inset: 3px;
    background: linear-gradient(135deg, #202020 0%, #0a0a0a 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: translateZ(8px);
    transform-style: preserve-3d;
  }

  /* Center Pillar */
  .obelisk-pillar--center {
    width: 48px;
    height: 260px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateZ(0px);
  }

  .obelisk-pillar--center .pillar-face {
    width: 100%;
    height: 100%;
  }

  .obelisk-pillar--center .pillar-face--front {
    transform: translateZ(10px);
    border-right: 1.5px solid rgba(77, 166, 255, 0.22);
    border-top: 1.5px solid rgba(255, 255, 255, 0.12);
  }

  .obelisk-pillar--center .pillar-face--right {
    width: 20px;
    left: 100%;
    transform: rotateY(90deg) translateZ(-10px);
    transform-origin: left center;
  }

  .obelisk-pillar--center .pillar-face--left {
    width: 20px;
    right: 100%;
    transform: rotateY(-90deg) translateZ(-10px);
    transform-origin: right center;
  }

  .obelisk-pillar--center .pillar-face--top {
    height: 20px;
    bottom: 100%;
    transform: rotateX(90deg) translateZ(10px);
    transform-origin: center bottom;
    background: linear-gradient(180deg, #242424 0%, #0e0e0e 100%);
  }

  /* Center Pillar Glowing Seam split around LogoIcon */
  .obelisk-pillar--center .pillar-seam--top {
    position: absolute;
    left: 50%;
    top: 8%;
    transform: translateX(-50%);
    width: 1.5px;
    height: 32%;
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  .obelisk-pillar--center .pillar-seam--bottom {
    position: absolute;
    left: 50%;
    top: 60%;
    transform: translateX(-50%);
    width: 1.5px;
    height: 32%;
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  .pillar-logo-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(4px);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 5;
  }

  .pillar-logo-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 3px rgba(77, 166, 255, 0.3)) brightness(0.85);
    transition: filter 300ms ease, transform 300ms ease;
  }

  /* Left Wing */
  .obelisk-pillar--left-wing {
    width: 24px;
    height: 200px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateX(-48px) translateZ(-16px);
    opacity: 0.75;
  }

  .obelisk-pillar--left-wing .pillar-face {
    width: 100%;
    height: 100%;
  }

  .obelisk-pillar--left-wing .pillar-face--front {
    transform: translateZ(8px);
  }

  .obelisk-pillar--left-wing .pillar-face--right {
    width: 16px;
    left: 100%;
    transform: rotateY(90deg) translateZ(-8px);
    transform-origin: left center;
  }

  .obelisk-pillar--left-wing .pillar-face--left {
    width: 16px;
    right: 100%;
    transform: rotateY(-90deg) translateZ(-8px);
    transform-origin: right center;
  }

  /* Left Wing Glowing Seam (Horizontal) */
  .obelisk-pillar--left-wing .pillar-seam {
    position: absolute;
    left: 10%;
    top: 50%;
    width: 80%;
    height: 1.5px;
    transform: translateY(-50%);
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  /* Right Wing */
  .obelisk-pillar--right-wing {
    width: 24px;
    height: 200px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateX(48px) translateZ(-16px);
    opacity: 0.75;
  }

  .obelisk-pillar--right-wing .pillar-face {
    width: 100%;
    height: 100%;
  }

  .obelisk-pillar--right-wing .pillar-face--front {
    transform: translateZ(8px);
    border-right: 1.2px solid rgba(77, 166, 255, 0.20);
  }

  .obelisk-pillar--right-wing .pillar-face--right {
    width: 16px;
    left: 100%;
    transform: rotateY(90deg) translateZ(-8px);
    transform-origin: left center;
  }

  .obelisk-pillar--right-wing .pillar-face--left {
    width: 16px;
    right: 100%;
    transform: rotateY(-90deg) translateZ(-8px);
    transform-origin: right center;
  }

  /* Right Wing Glowing Seam (Horizontal) */
  .obelisk-pillar--right-wing .pillar-seam {
    position: absolute;
    left: 10%;
    top: 50%;
    width: 80%;
    height: 1.5px;
    transform: translateY(-50%);
    background: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 6px rgba(77, 166, 255, 0.45);
    transition: background 300ms, box-shadow 300ms;
  }

  .face-gloss {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 50%);
    pointer-events: none;
    border-radius: 4px;
  }

  /* Internal Glowing Core */
  .centerpiece-internal-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(-20px);
    width: 180px;
    height: 250px;
    background: radial-gradient(ellipse, rgba(77, 166, 255, 0.24) 0%, transparent 65%);
    filter: blur(12px);
    z-index: 1;
    pointer-events: none;
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }

  .obsidian-monolith__shadow {
    position: absolute;
    width: 220px;
    height: 40px;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.95) 0%, transparent 70%);
    bottom: -25px;
    left: 50%;
    transform: translateX(-50%) rotateX(90deg);
    filter: blur(6px);
    pointer-events: none;
  }

  /* ─ Responsive Product Grid: Stacked on Mobile ───────────── */
  .otodor-hero__products-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 480px;
    z-index: 5;
  }

  .otodor-hero__product-node {
    width: 100%;
    will-change: transform, opacity;
  }

  /* Mobile: Clean premium list panels */
  .otodor-hero__product-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: rgba(18, 18, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-left: 2.5px solid #4DA6FF;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 300ms ease, box-shadow 300ms ease;
  }

  .otodor-hero__product-card:hover {
    border-color: rgba(77, 166, 255, 0.35);
    box-shadow: 0 4px 24px rgba(77, 166, 255, 0.06);
  }

  .product-card__visual {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.04);
    position: relative;
    overflow: hidden;
  }

  .product-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-card__visual svg.product-icon-svg {
    width: 32px;
    height: 32px;
    color: rgba(255, 255, 255, 0.55);
    transition: color 300ms ease;
  }

  .product-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
  }

  .product-card__feature {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #4DA6FF;
  }

  .product-card__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .product-card__desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0.25rem 0 0;
    line-height: 1.45;
  }

  /* ─ Typography overlay ─────────────────────────────────────── */
  .otodor-hero__text-container {
    width: 100%;
    max-width: 600px;
    text-align: center;
    z-index: 5;
  }

  .otodor-hero__text-frame {
    margin-bottom: 2rem;
    will-change: transform, opacity;
  }

  .otodor-hero__heading {
    font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
    font-size: clamp(2rem, 5.5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0;
  }

  .accent-text {
    background: linear-gradient(135deg, #4DA6FF 0%, #2E8EEE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: #4DA6FF;
  }

  .otodor-hero__subheading {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    margin: 1rem auto 0;
    max-width: 500px;
  }

  .otodor-hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  .otodor-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 99px;
    transition: transform 200ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .otodor-btn--primary {
    background-color: #ffffff;
    color: #0b0b0b;
  }

  .otodor-btn--primary:hover {
    background-color: #eaeaea;
    transform: scale(1.04);
  }

  .otodor-btn--secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .otodor-btn--secondary:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
    transform: scale(1.04);
  }

  /* ─ Hidden / Desktop only containers by default ─────────────── */
  .otodor-hero__network-svg,
  .product-callout {
    display: none;
  }

  /* ─ Scroll guide indicator (Mobile) ────────────────────────── */
  .otodor-hero__scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 2rem auto 0;
    border: none;
    background: none;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: color 250ms ease;
  }

  .otodor-hero__scroll-indicator:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  .otodor-hero__scroll-indicator .line {
    width: 1px;
    height: 30px;
    background: currentColor;
    position: relative;
    overflow: hidden;
  }

  .otodor-hero__scroll-indicator .line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent, #4DA6FF, transparent);
    animation: scroll-pulse 1.8s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }


  /* ─────────────────────────────────────────────────────────────
     Desktop Layout & Pinned Scroll Story Setup (>= 1024px)
     ───────────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {

    .otodor-hero.js-animated {
      height: 100vh;
      padding: 0;
      display: block;
    }

    .otodor-hero.js-animated .otodor-hero__viewport {
      height: 100%;
      position: relative;
      display: block;
      max-width: none;
    }

    /* Pinned centerpiece obelisk core position */
    .otodor-hero.js-animated .otodor-hero__core-container {
      position: absolute;
      top: 45%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      width: 240px;
      height: 380px;
    }

    .otodor-hero.js-animated .obelisk-pillar--center {
      width: 60px;
      height: 320px;
    }

    .otodor-hero.js-animated .obelisk-pillar--left-wing {
      width: 28px;
      height: 240px;
      transform: translate(-50%, -50%) translateX(-50px) translateZ(-16px);
    }

    .otodor-hero.js-animated .obelisk-pillar--right-wing {
      width: 28px;
      height: 240px;
      transform: translate(-50%, -50%) translateX(50px) translateZ(-16px);
    }

    /* Desktop Volumetric Light Rays */
    .otodor-hero.js-animated .otodor-hero__light-ray {
      display: block;
    }

    /* Desktop Network SVG overlay */
    .otodor-hero.js-animated .otodor-hero__network-svg {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
    }

    .network-path {
      fill: none;
      stroke: rgba(77, 166, 255, 0.06);
      stroke-width: 1.0;
      transition: stroke 300ms ease;
    }

    .network-path-active {
      stroke: rgba(77, 166, 255, 0.35);
      stroke-dasharray: 6 6;
      animation: dash-flow 25s linear infinite;
    }

    @keyframes dash-flow {
      to { stroke-dashoffset: -1000; }
    }

    .network-pulse {
      fill: none;
      stroke: #4DA6FF;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-dasharray: 100 1000;
      stroke-dashoffset: 0;
      opacity: 0;
      pointer-events: none;
      filter: drop-shadow(0 0 5px rgba(77, 166, 255, 0.95));
      transition: opacity 200ms ease;
    }

    .network-dot {
      fill: #4DA6FF;
      opacity: 0.05;
      transition: opacity 300ms ease, r 300ms ease;
    }

    .network-dot-active {
      opacity: 0.8;
      r: 3.5;
      filter: drop-shadow(0 0 3px rgba(77, 166, 255, 0.8));
    }

    /* Product nodes positioned in 4 corners */
    .otodor-hero.js-animated .otodor-hero__products-grid {
      position: absolute;
      inset: 0;
      width: 100%;
      max-width: none;
      display: block;
      pointer-events: none;
    }

    .otodor-hero.js-animated .otodor-hero__product-node {
      position: absolute;
      width: 230px;
      pointer-events: auto;
      opacity: 0;
    }

    .otodor-hero.js-animated .product-node--1 {
      top: 10%;
      left: 10%;
    }

    .otodor-hero.js-animated .product-node--2 {
      top: 10%;
      right: 10%;
    }

    .otodor-hero.js-animated .product-node--3 {
      bottom: 20%;
      left: 10%;
    }

    .otodor-hero.js-animated .product-node--4 {
      bottom: 20%;
      right: 10%;
    }

    /* Remove cards styles entirely for a floating 3D design */
    .otodor-hero.js-animated .otodor-hero__product-card {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      padding: 0 !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
      position: relative;
    }

    .otodor-hero.js-animated .product-card__visual {
      width: 120px;
      height: 120px;
      background: transparent;
      border: none;
      border-radius: 0;
      overflow: visible;
      filter: drop-shadow(0 0 15px rgba(77, 166, 255, 0.12));
      transition: filter 300ms ease;
    }

    .otodor-hero.js-animated .otodor-hero__product-card:hover .product-card__visual {
      filter: drop-shadow(0 0 25px rgba(77, 166, 255, 0.35));
    }

    .otodor-hero.js-animated .product-card__content {
      display: none; /* Mobile content hidden, using Pointer Callouts below */
    }

    /* Pointer Callout styling */
    .otodor-hero.js-animated .product-callout {
      display: flex;
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      width: 220px;
      flex-direction: column;
      align-items: center;
      margin-top: 8px;
      opacity: 0;
      will-change: transform, opacity;
    }

    .product-callout__pointer-line {
      width: 1px;
      height: 0; /* Animated by GSAP */
      background: linear-gradient(180deg, rgba(77, 166, 255, 0.35), transparent);
      margin-bottom: 6px;
      opacity: 0;
      will-change: height, opacity;
    }

    .product-callout__content {
      opacity: 0;
      transform: translateY(8px);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      will-change: transform, opacity;
    }

    .product-callout__tag {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #4DA6FF;
      text-shadow: 0 0 8px rgba(77, 166, 255, 0.3);
    }

    .product-callout__title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: #ffffff;
      margin: 2px 0 0;
      letter-spacing: -0.01em;
    }

    .product-callout__desc {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.45);
      line-height: 1.4;
      margin: 4px 0 0;
      text-align: center;
    }

    /* Typography frames absolute overlay */
    .otodor-hero.js-animated .otodor-hero__text-container {
      position: absolute;
      bottom: 8%;
      left: 50%;
      transform: translateX(-50%);
      width: 90%;
      max-width: 720px;
      height: 180px;
      pointer-events: none;
    }

    .otodor-hero.js-animated .otodor-hero__text-frame {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      margin-bottom: 0;
    }

    .otodor-hero.js-animated .frame--intro {
      opacity: 1;
      pointer-events: auto;
    }

    .otodor-hero.js-animated .frame--final {
      pointer-events: auto;
    }

    .otodor-hero.js-animated .otodor-hero__heading {
      font-size: clamp(2.8rem, 4.5vw, 3.8rem);
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .otodor-hero.js-animated .otodor-hero__subheading {
      font-size: 1.1rem;
      margin-top: 0.85rem;
    }
  }

  /* ─ Reduced Motion: Deactivate desktop animations ────────── */
  @media (prefers-reduced-motion: reduce) {
    .otodor-hero.js-animated {
      height: auto !important;
      padding: 5rem 1.5rem !important;
    }
    .otodor-hero.js-animated .otodor-hero__viewport {
      display: flex !important;
      flex-direction: column !important;
      gap: 3rem !important;
      transform: none !important;
    }
    .otodor-hero.js-animated .otodor-hero__products-grid {
      position: static !important;
      display: flex !important;
      flex-direction: column !important;
      max-width: 480px !important;
      margin: 0 auto !important;
    }
    .otodor-hero.js-animated .otodor-hero__product-node {
      position: static !important;
      opacity: 1 !important;
      transform: none !important;
      width: 100% !important;
    }
    .otodor-hero.js-animated .otodor-hero__network-svg,
    .otodor-hero.js-animated .otodor-hero__light-ray {
      display: none !important;
    }
    .otodor-hero.js-animated .product-card__content {
      display: flex !important;
    }
    .otodor-hero.js-animated .product-callout {
      display: none !important;
    }
    .otodor-hero.js-animated .otodor-hero__text-container {
      position: static !important;
      transform: none !important;
      height: auto !important;
      margin: 2rem auto 0 !important;
    }
    .otodor-hero.js-animated .otodor-hero__text-frame {
      position: static !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    .otodor-hero.js-animated .frame--intro {
      display: none !important;
    }
  }
{%- endstyle -%}

