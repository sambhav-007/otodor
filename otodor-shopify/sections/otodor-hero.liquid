{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Hero Section
     Full-screen cinematic brand entrance.
     All content visible without JS (progressive enhancement).
  ───────────────────────────────────────────────────────── */

  #shopify-section-{{ section.id }} {
    display: block;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* ─ Root layout ─────────────────────────────────────────────── */
  .otodor-hero {
    position: relative;
    min-height: 100svh;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: transparent;
    /* Slight upward nudge for optical balance (45% vs 50%) */
    padding-bottom: 5vh;
  }

  /* ─ Background: gradient (default, no image) ─────────────── */
  .otodor-hero__gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
    pointer-events: none;
  }

  /* ─ Background: user-uploaded image ─────────────────────── */
  .otodor-hero__image {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .otodor-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  /* Dark overlay on background image */
  .otodor-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(11, 11, 11, 0.6);
  }

  /* ─ Mesh grid (depth / technology cue) ──────────────────── */
  .otodor-hero__mesh {
    position: absolute;
    inset: 0;
    z-index: 3;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.10) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.10) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black 10%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 40%, black 10%, transparent 80%);
    pointer-events: none;
  }

  /* ─ Ambient glow orb (top-center blue light source) ─────── */
  .otodor-hero__glow {
    position: absolute;
    top: -15%;
    left: 50%;
    transform: translateX(-50%);
    width: min(120%, 1400px);
    height: 80%;
    background: radial-gradient(
      ellipse,
      rgba(77, 166, 255, 0.30) 0%,
      rgba(77, 166, 255, 0.12) 35%,
      rgba(77, 166, 255, 0.04) 55%,
      transparent 70%
    );
    z-index: 4;
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* ─ Secondary bottom glow ────────────────────────────────── */
  .otodor-hero__glow-bottom {
    position: absolute;
    bottom: -8%;
    left: 50%;
    transform: translateX(-50%);
    width: min(60%, 700px);
    height: 40%;
    background: radial-gradient(ellipse, rgba(77, 166, 255, 0.05) 0%, transparent 65%);
    z-index: 3;
    pointer-events: none;
  }

  /* ─ Horizon separator line ───────────────────────────────── */
  .otodor-hero__horizon {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(77, 166, 255, 0.30) 30%,
      rgba(77, 166, 255, 0.50) 50%,
      rgba(77, 166, 255, 0.30) 70%,
      transparent 100%
    );
    z-index: 10;
  }

  /* ─ Content layer ────────────────────────────────────────── */
  .otodor-hero__inner {
    position: relative;
    z-index: 10;
    width: 100%;
    padding-inline: 1.5rem;
  }

  .otodor-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    /* Optical center: less top padding pushes content up slightly */
    padding-top: clamp(5rem, 12vh, 8rem);
    padding-bottom: clamp(8rem, 18vh, 12rem);
    max-width: 1000px;
    margin-inline: auto;
  }

  /* ─ Eyebrow badge ────────────────────────────────────────── */
  .otodor-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: clamp(0.6rem, 1.2vw, 0.7rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    width: fit-content;
  }

  .otodor-hero__badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00D26A;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(0, 210, 106, 0.3);
    animation: otodor-hero-pulse 2.4s ease-out infinite;
  }

  @keyframes otodor-hero-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(0, 210, 106, 0.4); }
    70%  { box-shadow: 0 0 0 9px rgba(0, 210, 106, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 210, 106, 0); }
  }

  /* ─ Headline ─────────────────────────────────────────────── */
  .otodor-hero__heading {
    font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
    font-size: clamp(2.8rem, 8.5vw, 6rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0;
    /* Reserve space for animation without layout shift */
    overflow: visible;
  }

  /* Blue gradient accent on suffix character(s) */
  .otodor-hero__heading-suffix {
    background: linear-gradient(135deg, #4DA6FF 0%, #2E8EEE 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    /* Fallback for browsers that don't support bg-clip */
    color: #4DA6FF;
  }

  /* Word splitting structure for GSAP entrance */
  .otodor-hero__heading .word-wrap {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    /* Tiny gap so overflow:hidden doesn't clip descenders */
    padding-bottom: 0.05em;
    margin-bottom: -0.05em;
  }

  .otodor-hero__heading .word {
    display: inline-block;
    will-change: transform, opacity;
  }

  /* ─ Subheading ───────────────────────────────────────────── */
  .otodor-hero__subheading {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 400;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    max-width: 50ch;
  }

  /* ─ CTA group ────────────────────────────────────────────── */
  .otodor-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.375rem;
  }

  /* ─ Scroll indicator ─────────────────────────────────────── */
  .otodor-hero__scroll {
    position: absolute;
    bottom: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.30);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    background: none;
    padding: 0.75rem;
    cursor: pointer;
    transition: color 280ms ease;
    will-change: opacity;
  }

  .otodor-hero__scroll:hover {
    color: rgba(255, 255, 255, 0.70);
  }

  /* Animated vertical line */
  .otodor-hero__scroll-line {
    display: block;
    width: 1px;
    height: 36px;
    position: relative;
    overflow: hidden;
  }

  .otodor-hero__scroll-line::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent 0%, currentColor 50%, transparent 100%);
    animation: otodor-scroll-slide 1.8s ease-in-out infinite;
  }

  @keyframes otodor-scroll-slide {
    0%   { transform: translateY(-100%); opacity: 0; }
    30%  { opacity: 1; }
    70%  { opacity: 1; }
    100% { transform: translateY(100%); opacity: 0; }
  }

  /* Chevron arrow */
  .otodor-hero__scroll-chevron {
    width: 14px;
    height: 8px;
    position: relative;
  }

  .otodor-hero__scroll-chevron::before,
  .otodor-hero__scroll-chevron::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: 8px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 280ms ease;
  }

  .otodor-hero__scroll-chevron::before {
    left: 0;
    transform: rotate(40deg);
    transform-origin: bottom left;
  }

  .otodor-hero__scroll-chevron::after {
    right: 0;
    transform: rotate(-40deg);
    transform-origin: bottom right;
  }

  /* ─ Mobile overrides (375px first) ──────────────────────── */
  @media (max-width: 599px) {
    .otodor-hero__content {
      padding-block: clamp(6rem, 20vh, 9rem);
    }

    .otodor-hero__heading {
      letter-spacing: -0.025em;
    }

    .otodor-hero__actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .otodor-hero__actions .otodor-btn {
      width: 100%;
    }

    .otodor-hero__scroll {
      bottom: 1.5rem;
    }

    .otodor-hero__mesh {
      background-size: 40px 40px;
    }
  }

  /* ─ Reduced motion: static fallback ─────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .otodor-hero__badge-dot {
      animation: none;
      box-shadow: 0 0 0 2px rgba(0, 210, 106, 0.3);
    }

    .otodor-hero__scroll-line::before {
      animation: none;
      transform: translateY(0);
      opacity: 0.5;
    }
  }
{%- endstyle -%}

{%- comment -%} ── HERO SECTION ───────────────────────────────────── {%- endcomment -%}
<section
  id="otodor-hero-{{ section.id }}"
  class="otodor-hero"
  data-otodor-section="hero"
  data-3d-slot="hero-bg"
  aria-label="{{ section.settings.heading | append: section.settings.heading_suffix | escape }}"
>

  {%- comment -%} Background layers {%- endcomment -%}
  <div class="otodor-hero__gradient" aria-hidden="true"></div>
  <div class="otodor-hero__glow" aria-hidden="true"></div>
  <div class="otodor-hero__glow-bottom" aria-hidden="true"></div>
  <div class="otodor-hero__mesh" aria-hidden="true"></div>

  {%- if section.settings.background_image != blank -%}
    <div class="otodor-hero__image" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: '',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000'
      }}
    </div>
    <div
      class="otodor-hero__overlay"
      style="background: rgba(11, 11, 11, {{ section.settings.overlay_opacity | divided_by: 100.0 | round: 2 }});"
      aria-hidden="true"
    ></div>
  {%- endif -%}

  {%- comment -%} Content {%- endcomment -%}
  <div class="otodor-hero__inner">
    <div class="otodor-hero__content">

      {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
        <div class="otodor-hero__badge" role="status" aria-label="{{ section.settings.badge_text | escape }}">
          <span class="otodor-hero__badge-dot" aria-hidden="true"></span>
          <span>{{- section.settings.badge_text | escape -}}</span>
        </div>
      {%- endif -%}

      <h1 class="otodor-hero__heading" data-hero-heading>
        {%- comment -%}
          The heading and suffix are rendered as separate nodes.
          JS will split the main text into .word-wrap > .word spans
          for the staggered entrance animation.
          Without JS, this renders as a plain h1 — fully accessible.
        {%- endcomment -%}
        {{- section.settings.heading | escape -}}{%- if section.settings.heading_suffix != blank -%}<span class="otodor-hero__heading-suffix" aria-hidden="false">{{- section.settings.heading_suffix | escape -}}</span>{%- endif -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="otodor-hero__subheading" data-hero-subheading>
          {{- section.settings.subheading | escape -}}
        </p>
      {%- endif -%}

      <div class="otodor-hero__actions" data-hero-actions>
        {%- if section.settings.cta_primary_label != blank -%}
          <a
            href="{{ section.settings.cta_primary_link | default: routes.all_products_collection_url }}"
            class="otodor-btn otodor-btn--primary otodor-btn--lg"
            id="otodor-hero-cta-primary-{{ section.id }}"
          >
            {{- section.settings.cta_primary_label | escape -}}
            <span class="otodor-btn__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.cta_secondary_label != blank -%}
          <a
            href="{{ section.settings.cta_secondary_link | default: routes.collections_url }}"
            class="otodor-btn otodor-btn--ghost otodor-btn--lg"
            id="otodor-hero-cta-secondary-{{ section.id }}"
          >
            {{- section.settings.cta_secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- comment -%} Horizon line separator {%- endcomment -%}
  <div class="otodor-hero__horizon" aria-hidden="true"></div>

  {%- comment -%} Scroll indicator {%- endcomment -%}
  {%- if section.settings.show_scroll_indicator -%}
    <button
      type="button"
      class="otodor-hero__scroll"
      aria-label="Scroll down to explore"
      id="otodor-hero-scroll-{{ section.id }}"
      data-hero-scroll
    >
      <span class="otodor-hero__scroll-line" aria-hidden="true"></span>
      <span class="otodor-hero__scroll-chevron" aria-hidden="true"></span>
      <span>Scroll</span>
    </button>
  {%- endif -%}

</section>

<script>
(function () {
  'use strict';

  var section = document.getElementById('otodor-hero-{{ section.id }}');
  if (!section) return;

  /* ── Scroll indicator: smooth scroll to next section ──────── */
  var scrollBtn = section.querySelector('[data-hero-scroll]');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', function () {
      var nextSection = section.closest('.shopify-section')
        ? section.closest('.shopify-section').nextElementSibling
        : section.nextElementSibling;
      if (nextSection) {
        nextSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        window.scrollBy({ top: window.innerHeight * 0.85, behavior: 'smooth' });
      }
    });
  }

  /* ── GSAP Hero Animation ───────────────────────────────────── */
  function initHeroAnimation() {
    /* Safety guards */
    if (typeof gsap === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var heading    = section.querySelector('[data-hero-heading]');
    var subheading = section.querySelector('[data-hero-subheading]');
    var badge      = section.querySelector('.otodor-hero__badge');
    var actions    = section.querySelector('[data-hero-actions]');
    var scroll     = section.querySelector('[data-hero-scroll]');
    var glow       = section.querySelector('.otodor-hero__glow');

    /* ── Split heading text into word spans ──────────────────── */
    if (heading) {
      /* Collect text content from text nodes only (not child elements) */
      var mainText = Array.from(heading.childNodes)
        .filter(function (n) { return n.nodeType === Node.TEXT_NODE; })
        .map(function (n) { return n.textContent; })
        .join('');

      /* Collect non-text children (the .otodor-hero__heading-suffix span) */
      var childEls = Array.from(heading.childNodes)
        .filter(function (n) { return n.nodeType === Node.ELEMENT_NODE; })
        .map(function (n) { return n.outerHTML; })
        .join('');

      /* Build word spans */
      var words = mainText.trim().split(/\s+/).filter(Boolean);
      var wordSpansHTML = words.map(function (word) {
        return '<span class="word-wrap"><span class="word">' + word + '</span></span>';
      }).join(' ');

      heading.innerHTML = wordSpansHTML + (childEls ? '&#32;' + childEls : '');
    }

    /* ── Build GSAP timeline ────────────────────────────────── */
    var tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      onComplete: function () {
        /* Remove will-change after animation completes (memory) */
        if (glow) glow.style.willChange = 'auto';
      }
    });

    /* Glow: expand from above */
    if (glow) {
      tl.fromTo(glow,
        { opacity: 0, scale: 0.6, y: -60 },
        { opacity: 1, scale: 1, y: 0, duration: 1.6, ease: 'power2.out' },
        0
      );
    }

    /* Badge: fade up */
    if (badge) {
      tl.fromTo(badge,
        { opacity: 0, y: 18, filter: 'blur(4px)' },
        { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.65 },
        0.25
      );
    }

    /* Heading words: stagger up from overflow-hidden container */
    var wordEls = heading ? heading.querySelectorAll('.word') : [];
    if (wordEls.length) {
      tl.fromTo(wordEls,
        { yPercent: 110, opacity: 0 },
        { yPercent: 0, opacity: 1, duration: 0.85, stagger: 0.075, ease: 'power3.out' },
        0.40
      );
    }

    /* Heading suffix: fade in slightly delayed */
    var suffix = heading ? heading.querySelector('.otodor-hero__heading-suffix') : null;
    if (suffix) {
      tl.fromTo(suffix,
        { opacity: 0, scale: 0.85 },
        { opacity: 1, scale: 1, duration: 0.5, ease: 'back.out(1.5)' },
        0.90
      );
    }

    /* Subheading: fade up */
    if (subheading) {
      tl.fromTo(subheading,
        { opacity: 0, y: 22, filter: 'blur(3px)' },
        { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.75 },
        0.85
      );
    }

    /* CTAs: fade up, staggered */
    if (actions) {
      var btns = actions.querySelectorAll('.otodor-btn');
      tl.fromTo(btns,
        { opacity: 0, y: 18 },
        { opacity: 1, y: 0, duration: 0.60, stagger: 0.12 },
        1.05
      );
    }

    /* Scroll indicator: fade in last */
    if (scroll) {
      tl.fromTo(scroll,
        { opacity: 0 },
        { opacity: 1, duration: 0.60 },
        1.45
      );
    }

    /* ── Register with global API for Phase 5 R3F integration ── */
    if (window.OtodorAnimations) {
      window.OtodorAnimations._sections = window.OtodorAnimations._sections || {};
      window.OtodorAnimations._sections.hero = tl;
    }
  }

  /* ── Wait for GSAP (loaded with defer) ──────────────────────
     'load' fires after all deferred scripts have executed.
     This guarantees GSAP is available when we init.           */
  if (document.readyState === 'complete') {
    initHeroAnimation();
  } else {
    window.addEventListener('load', initHeroAnimation, { once: true });
  }

  /* ── Shopify design mode: re-init on section editor events ── */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === '{{ section.id }}') {
      initHeroAnimation();
    }
  });

})();
</script>

{% schema %}
{
  "name": "OTODOR Hero",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Security Reimagined",
      "info": "The main headline. Keep it short and powerful."
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading accent character",
      "default": ".",
      "info": "Rendered immediately after the heading in brand blue. Typically a period or exclamation mark."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Smart Security Solutions Built For Modern Living."
    },
    {
      "type": "header",
      "content": "Status Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Now Available — Smart Locks & Gate Motors"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Button label",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Button link",
      "info": "Defaults to all products if left empty."
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Button label",
      "default": "View Collections"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Hero background image",
      "info": "Optional. If empty, uses the OTODOR dark blue gradient. Recommended: 2000×1200px dark lifestyle or studio photograph."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 30,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Image overlay darkness",
      "default": 65,
      "info": "Increase to darken the image and improve text legibility."
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "OTODOR Hero",
      "settings": {
        "heading": "Security Reimagined",
        "heading_suffix": ".",
        "subheading": "Smart Security Solutions Built For Modern Living.",
        "badge_text": "Now Available — Smart Locks & Gate Motors",
