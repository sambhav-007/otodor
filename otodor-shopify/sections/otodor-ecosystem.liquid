{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Ecosystem — premium product relationship diagram.
     Four nodes joined by a fine line that draws on scroll,
     with one slow pulse of light travelling along it.
     Apple/B&O energy: calm, certain, minimal. No HUD, no neon.
  ───────────────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 3;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(77, 166, 255, 0.06) 0%, transparent 55%),
      linear-gradient(180deg, #0D0D0D 0%, #080808 100%);
  }

  .otodor-eco {
    max-width: var(--otodor-container);
    margin: 0 auto;
    padding-block: var(--otodor-section-py);
    color: #FFFFFF;
  }
  .otodor-eco__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--otodor-header-mb);
  }
  .otodor-eco__eyebrow {
    display: block;
    font-family: var(--otodor-font-display);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--otodor-tracking-widest);
    color: var(--otodor-blue);
    margin-bottom: var(--otodor-header-gap);
  }
  .otodor-eco__heading {
    font-family: var(--otodor-font-display);
    /* One section-heading size across the page (was 40px against 50px). */
    font-size: var(--otodor-text-4xl);
    font-weight: 700;
    line-height: var(--otodor-leading-display);
    letter-spacing: var(--otodor-tracking-tight);
    margin: 0;
  }
  .otodor-eco__line {
    font-family: var(--otodor-font-body);
    font-size: var(--otodor-text-md);
    color: rgba(255, 255, 255, 0.55);
    margin: 1.1rem 0 0;
  }

  .otodor-eco__diagram {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* The connecting line sits behind the discs */
  .otodor-eco__wire {
    position: absolute;
    top: clamp(44px, 7vw, 70px);
    left: 12%;
    right: 12%;
    height: 1px;
    background: rgba(255, 255, 255, 0.10);
    overflow: visible;
  }
  .otodor-eco__wire-draw {
    position: absolute;
    inset: 0;
    background: rgba(77, 166, 255, 0.45);
    transform-origin: left;
    transform: scaleX(0);
  }
  .otodor-eco__wire-pulse {
    position: absolute;
    top: -1px;
    left: 0;
    width: 90px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent 0%, rgba(77, 166, 255, 0.7) 50%, transparent 100%);
    opacity: 0;
    animation: otodor-eco-pulse 5.5s linear infinite;
    animation-play-state: paused;
  }
  .otodor-eco--drawn .otodor-eco__wire-pulse { animation-play-state: running; }
  @keyframes otodor-eco-pulse {
    0%   { transform: translateX(-90px); opacity: 0; }
    8%   { opacity: 1; }
    60%  { transform: translateX(calc(100vw * 0.62)); opacity: 1; }
    68%, 100% { transform: translateX(calc(100vw * 0.62)); opacity: 0; }
  }

  .otodor-eco__node {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
  }
  .otodor-eco__disc {
    width: clamp(88px, 14vw, 140px);
    height: clamp(88px, 14vw, 140px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 38% 30%, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.02) 60%);
    border: 1px solid rgba(255, 255, 255, 0.10);
    transition: border-color var(--otodor-dur-base) var(--otodor-ease-out),
                transform var(--otodor-dur-base) var(--otodor-ease-spring);
  }
  .otodor-eco__node:hover .otodor-eco__disc {
    border-color: rgba(77, 166, 255, 0.45);
    transform: translateY(var(--otodor-lift));
  }
  .otodor-eco__disc img {
    width: 62%;
    height: 62%;
    object-fit: contain;
  }
  .otodor-eco__disc svg {
    width: 36%;
    height: 36%;
    color: rgba(255, 255, 255, 0.75);
  }
  /* The hub (last node) is slightly elevated and brighter */
  .otodor-eco__node--hub .otodor-eco__disc {
    border-color: rgba(77, 166, 255, 0.35);
    box-shadow: 0 0 40px rgba(77, 166, 255, 0.10);
  }

  .otodor-eco__name {
    font-family: var(--otodor-font-display);
    font-size: clamp(1.18rem, 1.6vw, 1.41rem);
    font-weight: 600;
    color: #FFFFFF;
    margin: 1.2rem 0 0;
  }
  .otodor-eco__role {
    font-family: var(--otodor-font-body);
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.48);
    margin: 0.3rem 0 0;
    max-width: 18ch;
  }
  .otodor-eco__arrow {
    display: none;
  }

  @media (max-width: 749px) {
    .otodor-eco__diagram {
      grid-template-columns: 1fr;
      gap: 0;
      justify-items: center;
    }
    .otodor-eco__wire { display: none; }
    .otodor-eco__node { padding-bottom: 0.5rem; }
    .otodor-eco__arrow {
      display: block;
      width: 1px;
      height: 44px;
      margin: 0.8rem 0;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.18) 0%, rgba(77, 166, 255, 0.3) 100%);
    }
  }
{%- endstyle -%}

<div class="otodor-eco" data-otodor-section="ecosystem" id="OtodorEco-{{ section.id }}">
  <div class="otodor-eco__header">
    <span class="otodor-eco__eyebrow" data-otodor-reveal="fade-up">{{ section.settings.eyebrow | escape }}</span>
    <h2 class="otodor-eco__heading" data-otodor-reveal="fade-up">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.line != blank -%}
      <p class="otodor-eco__line" data-otodor-reveal="fade-up">{{ section.settings.line | escape }}</p>
    {%- endif -%}
  </div>

  <div class="otodor-eco__diagram">
    <div class="otodor-eco__wire" aria-hidden="true">
      <div class="otodor-eco__wire-draw" data-eco-wire></div>
      <div class="otodor-eco__wire-pulse"></div>
    </div>

    {%- for block in section.blocks -%}
      {%- assign is_hub = false -%}
      {%- if forloop.last -%}{%- assign is_hub = true -%}{%- endif -%}
      {%- if forloop.first == false -%}
        <span class="otodor-eco__arrow" aria-hidden="true"></span>
      {%- endif -%}
      {%- assign node_tag = 'div' -%}
      {%- if block.settings.link != blank -%}{%- assign node_tag = 'a' -%}{%- endif -%}
      <{{ node_tag }}
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        class="otodor-eco__node{% if is_hub %} otodor-eco__node--hub{% endif %}"
        data-otodor-reveal="fade-up"
        {{ block.shopify_attributes }}
      >
        <div class="otodor-eco__disc">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,280,360', sizes: '140px', alt: block.settings.name }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="3"/><circle cx="12" cy="17.5" r="1.2" fill="currentColor" stroke="none"/></svg>
          {%- endif -%}
        </div>
        <p class="otodor-eco__name">{{ block.settings.name | escape }}</p>
        {%- if block.settings.role != blank -%}
          <p class="otodor-eco__role">{{ block.settings.role | escape }}</p>
        {%- endif -%}
      </{{ node_tag }}>
    {%- endfor -%}
  </div>
</div>

<script>
  /* Wire draws on scroll; the pulse starts once drawn. Static line fallback. */
  (function () {
    var root = document.getElementById('OtodorEco-{{ section.id }}');
    var wire = root && root.querySelector('[data-eco-wire]');
    if (!wire) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function done() { root.classList.add('otodor-eco--drawn'); }
    function init() {
      if (reduced || !window.gsap || !window.ScrollTrigger) {
        wire.style.transform = 'scaleX(1)';
        if (!reduced) done();
        return;
      }
      gsap.to(wire, {
        scaleX: 1,
        duration: 1.6,
        ease: 'power2.inOut',
        scrollTrigger: { trigger: root, start: 'top 65%', once: true },
        onComplete: done
      });
    }
    if (window.gsap) { init(); } else { window.addEventListener('load', init); }
  })();
</script>

{% schema %}
{
  "name": "OTODOR Ecosystem",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The OTODOR Ecosystem" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One ecosystem. Every entry point." },
    { "type": "text", "id": "line", "label": "Supporting line", "default": "Lock, gate, and access — controlled from a single app." }
  ],
  "blocks": [
    {
      "type": "node",
      "name": "Node",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Smart Lock" },
        { "type": "text", "id": "role", "label": "Role (three words)", "default": "Front door entry" },
        { "type": "image_picker", "id": "image", "label": "Product image (transparent PNG)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "OTODOR Ecosystem",
      "blocks": [
        { "type": "node", "settings": { "name": "Smart Lock", "role": "Front door entry" } },
        { "type": "node", "settings": { "name": "Access Control", "role": "Who gets in" } },
        { "type": "node", "settings": { "name": "Gate Automation", "role": "Driveway, automated" } },
        { "type": "node", "settings": { "name": "Mobile Control", "role": "Everything, anywhere" } }
      ]
    }
  ]
}
{% endschema %}
