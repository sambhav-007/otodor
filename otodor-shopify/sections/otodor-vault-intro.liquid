{%- comment -%}
  ════════════════════════════════════════════════════════════════════════
  OTODOR Vault Intro — Three.js cinematic blast-door overlay
  ────────────────────────────────────────────────────────────────────────
  A one-time, full-screen 3D intro that plays ONCE PER SESSION before the
  hero, then removes itself forever. It NEVER touches the hero — pure overlay.

  The 3D scene lives in assets/otodor-vault.js (Three.js r160, lazy-loaded).
  This section is a thin host: guards + a CSS "closed-door" poster shown while
  Three loads (so there's never a hero flash), plus the loader/fallback logic.

  Guards (each independently skips to the hero):
    prefers-reduced-motion  → CSS display:none + JS skip
    sessionStorage          → play once per browser session
    no WebGL / Three fails  → remove overlay, hero shows
    no-JS                   → overlay stays invisible (opacity:0)
  ════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- if section.settings.enabled -%}
{%- style -%}
  @media (prefers-reduced-motion: reduce) {
    .otodor-vault { display: none !important; }
  }
  html.otodor-vault-lock { overflow: hidden !important; touch-action: none; }

  .otodor-vault {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    overflow: hidden;
    opacity: 0;                 /* armed by JS on first play only */
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 42%, #0c1016 0%, #070809 55%, #050506 100%);
  }
  .otodor-vault.is-playing { opacity: 1; pointer-events: auto; }
  .otodor-vault.is-done { opacity: 0; transition: opacity 0.55s ease; pointer-events: none; }

  .otodor-vault__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Poster: a believable closed vault while Three loads (no flash) ── */
  .otodor-vault__poster {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    opacity: 1;
    transition: opacity 0.5s ease;
    background:
      linear-gradient(90deg, transparent calc(50% - 1px), rgba(77,166,255,0.35) 50%, transparent calc(50% + 1px)),
      repeating-linear-gradient(60deg, rgba(255,255,255,0.02) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(-60deg, rgba(255,255,255,0.02) 0 1px, transparent 1px 26px),
      linear-gradient(105deg, #171a1f 0%, #0c0e11 50%, #060708 100%);
  }
  .otodor-vault.is-ready .otodor-vault__poster { opacity: 0; }
  .otodor-vault__poster-core { display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }
  .otodor-vault__poster-core img { width: clamp(44px, 5vw, 60px); height: auto; opacity: 0.85; filter: drop-shadow(0 0 8px rgba(77,166,255,0.4)); }
  .otodor-vault__poster-core span {
    font-family: var(--otodor-font-body, sans-serif);
    font-size: 0.62rem; font-weight: 500; letter-spacing: 0.34em; text-transform: uppercase;
    color: rgba(150,165,180,0.55); padding-left: 0.34em;
  }
{%- endstyle -%}

<div class="otodor-vault" data-otodor-vault aria-hidden="true" role="presentation">
  <canvas class="otodor-vault__canvas" data-vault-canvas></canvas>
  <div class="otodor-vault__poster">
    <div class="otodor-vault__poster-core">
      <img src="{{ 'otodor-monogram.png' | asset_url }}" alt="" width="60" height="60" aria-hidden="true">
      <span>{{ section.settings.facility_label | escape }}</span>
    </div>
  </div>
</div>

<script>
  (function () {
    var overlay = document.querySelector('.otodor-vault[data-otodor-vault]');
    if (!overlay) return;

    var KEY = 'otodorVaultIntroPlayed';
    var VAULT_JS = {{ 'otodor-vault.js' | asset_url | json }};

    function removeOverlay() {
      try { if (overlay._vaultCleanup) overlay._vaultCleanup(); } catch (e) {}
      if (overlay && overlay.parentNode) overlay.parentNode.removeChild(overlay);
      try { document.documentElement.classList.remove('otodor-vault-lock'); } catch (e) {}
    }

    // ── Guards ──
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var played = false;
    try { played = window.sessionStorage.getItem(KEY) === '1'; } catch (e) {}

    function webglOK() {
      try {
        var c = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
      } catch (e) { return false; }
    }

    if (reduce || played || !webglOK()) { removeOverlay(); return; }
    try { window.sessionStorage.setItem(KEY, '1'); } catch (e) {}

    // Arm immediately (synchronous → poster covers the hero, no flash) + lock scroll.
    document.documentElement.classList.add('otodor-vault-lock');
    overlay.classList.add('is-playing');

    var finished = false;
    function endSequence() {
      if (finished) return;
      finished = true;
      overlay.classList.add('is-done');
      document.documentElement.classList.remove('otodor-vault-lock');
      window.setTimeout(removeOverlay, 650);
    }

    // Safety net: if Three never loads/plays, don't trap the user.
    var safety = window.setTimeout(function () { removeOverlay(); }, 9000);

    import(VAULT_JS).then(function (mod) {
      var init = mod && (mod.default || mod.initVault);
      if (typeof init !== 'function') { window.clearTimeout(safety); removeOverlay(); return; }
      init(overlay, {
        onReady: function () { overlay.classList.add('is-ready'); },   // fade the poster
        onEnd: function () { window.clearTimeout(safety); endSequence(); },
        onDone: function () { window.clearTimeout(safety); removeOverlay(); }
      });
    }).catch(function () { window.clearTimeout(safety); removeOverlay(); });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "OTODOR Vault Intro",
  "tag": "section",
  "class": "shopify-section otodor-vault-section",
  "settings": [
    { "type": "paragraph", "content": "A one-time cinematic Three.js blast-door intro that plays once per browser session before the hero, then removes itself. Never modifies the hero. Skipped for reduced-motion users and where WebGL is unavailable (hero shows instantly)." },
    { "type": "checkbox", "id": "enabled", "label": "Enable vault intro", "default": true },
    { "type": "text", "id": "status_text", "label": "Unlock status text", "default": "Access Granted" },
    { "type": "text", "id": "facility_label", "label": "Facility label", "default": "OTODOR · Secure Facility" }
  ],
  "presets": [{ "name": "OTODOR Vault Intro" }]
}
{% endschema %}
