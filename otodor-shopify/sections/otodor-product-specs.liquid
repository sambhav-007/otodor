{%- comment -%}
  ════════════════════════════════════════════════════════════════════════
  OTODOR Module: Specifications  (a CONSUMER of the Spec Rendering Engine)
  See OTODOR-SPEC-ENGINE.md. No specification names live in this file.
  ────────────────────────────────────────────────────────────────────────
  Purpose:            The product's specification ledger — the "what exactly
                      am I buying" table.
  Primary source:     product.metafields.custom.specs (curated JSON of
                      groups → rows) — an override for a hand-built table.
  Fallback order:     custom.specs → the SPEC REGISTRY resolved against this
                      product (metafield → model seed → registry default)
                      → `row` blocks → hide.
  Visibility rule:    Hidden when no source yields a single row.
  Merchant editable:  YES — heading; `row` blocks as a last-resort fallback.
                      NOT the spec list: that lives in otodor-spec-registry,
                      so adding a spec is one registry record and every
                      consumer picks it up.
  Required metafields: none
  Optional metafields: custom.specs, any specs.* the registry names
  Dependencies:       snippets/otodor-spec-registry, otodor-spec-value,
                      otodor-spec-model-seed; `.otodor-ledger` in base.css.
  Preset:             Renders from the registry as soon as a product matches
                      a published model; blocks otherwise.
  Accessibility:      Key/value rows with a group heading between sections;
                      contrast AA.
  Reusable for:       PDP; any surface needing a full spec ledger.

  WHY THE REGISTRY PATH EXISTS. This module read `custom.specs` alone, and
  that metafield is not defined yet — so every product page showed no
  specifications at all, while the comparison table on the same site showed
  a full sheet for the same models. One registry, two consumers: the ledger
  now resolves exactly what the comparison resolves, and both upgrade to
  real `specs.*` metafields on the same day.
  ════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign curated = product.metafields.custom.specs.value
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif

  assign use_model_seed = true
  if section.settings.use_model_seed == false
    assign use_model_seed = false
  endif

  # Resolve the registry against this product ONCE into `group|~|label|~|value`
  # records. Liquid has no array of structs, so this reuses the same
  # capture-and-split the registry itself uses.
  assign rows_out = ''
  assign real_n = 0
  if curated == blank
    capture reg
      render 'otodor-spec-registry'
    endcapture
    assign specs = reg | strip | split: ';;;'
    for row in specs
      assign f = row | strip | split: '|'
      if f[0] == blank
        continue
      endif
      assign mv = product.metafields[f[2]][f[3]]
      capture seed_val
        if use_model_seed
          render 'otodor-spec-model-seed', product: product, id: f[0]
        endif
      endcapture
      assign seed_val = seed_val | strip
      assign fallback = seed_val | default: f[7]
      if mv == blank and fallback == blank
        continue
      endif
      capture cell
        render 'otodor-spec-value', product: product, namespace: f[2], key: f[3], type: f[4], unit: f[5], spec_default: fallback, context: 'inline'
      endcapture
      assign cell = cell | strip
      if cell == blank
        continue
      endif
      # A row backed only by a registry DEFAULT is not evidence this product
      # has been specified — `warranty` has a default, so every product would
      # otherwise render a one-row ledger saying what the warranty module
      # already says. Count only rows with real data behind them.
      if mv != blank or seed_val != blank
        assign real_n = real_n | plus: 1
      endif
      assign rows_out = rows_out | append: f[6] | append: '|~|' | append: f[1] | append: '|~|' | append: cell | append: ';;;'
    endfor
  endif

  assign reg_rows = rows_out | strip | split: ';;;'
  assign has_registry = false
  if real_n > 0
    assign has_registry = true
  endif
-%}

{%- if curated != blank or has_registry or has_blocks -%}
  {%- style -%}
    /* ─────────────────────────────────────────────────────────
       OTODOR Product Specs — quiet definition ledger.
       Grouped hairline rows, no boxes.
    ───────────────────────────────────────────────────────── */
    #shopify-section-{{ section.id }} {
      background: var(--otodor-bg-light);
    }
    .otodor-pspecs {
      max-width: var(--otodor-container-sm);
      margin: 0 auto;
      padding: clamp(3rem, 7vw, 5.5rem) 0;
    }
    .otodor-pspecs__heading {
      font-family: var(--otodor-font-display);
      font-size: clamp(2.05rem, 3vw, 2.82rem);
      font-weight: 700;
      letter-spacing: var(--otodor-tracking-tight);
      color: var(--otodor-ink);
      margin: 0 0 1rem;
    }
  {%- endstyle -%}

  <div class="otodor-pspecs">
    <h2 class="otodor-pspecs__heading" data-otodor-reveal="blur-in">{{ section.settings.heading | escape }}</h2>
    <div class="otodor-ledger" data-otodor-stagger>
      {%- if curated != blank -%}
        {%- comment -%} Primary: a curated table wins outright. {%- endcomment -%}
        {%- for group in curated -%}
          <div class="otodor-ledger__group">{{ group[0] | escape }}</div>
          {%- for row in group[1] -%}
            <div class="otodor-ledger__row">
              <div class="otodor-ledger__key">{{ row[0] | escape }}</div>
              <div class="otodor-ledger__val">{{ row[1] | escape }}</div>
            </div>
          {%- endfor -%}
        {%- endfor -%}

      {%- elsif has_registry -%}
        {%- comment -%} Registry-driven: the same source as the comparison. {%- endcomment -%}
        {%- assign current_group = '' -%}
        {%- for r in reg_rows -%}
          {%- assign c = r | split: '|~|' -%}
          {%- if c[1] == blank -%}{%- continue -%}{%- endif -%}
          {%- if c[0] != blank and c[0] != current_group -%}
            {%- assign current_group = c[0] -%}
            <div class="otodor-ledger__group">{{ current_group | escape }}</div>
          {%- endif -%}
          <div class="otodor-ledger__row">
            <div class="otodor-ledger__key">{{ c[1] | escape }}</div>
            <div class="otodor-ledger__val">{{ c[2] }}</div>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- assign current_group = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.group != blank and block.settings.group != current_group -%}
            {%- assign current_group = block.settings.group -%}
            <div class="otodor-ledger__group">{{ current_group | escape }}</div>
          {%- endif -%}
          <div class="otodor-ledger__row" {{ block.shopify_attributes }}>
            <div class="otodor-ledger__key">{{ block.settings.key | escape }}</div>
            <div class="otodor-ledger__val">{{ block.settings.value | escape }}</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "OTODOR Product Specs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "paragraph", "content": "Rows come from the OTODOR specification registry resolved against this product — the same source the comparison table uses. A curated custom.specs metafield (JSON of groups → rows) overrides it entirely; the blocks below are the last resort." },
    { "type": "checkbox", "id": "use_model_seed", "label": "Use the published spec sheet where metafields are empty", "info": "Fills rows from snippets/otodor-spec-model-seed. The product's own specs.* metafields always win.", "default": true }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Spec row (fallback)",
      "settings": [
        { "type": "text", "id": "group", "label": "Group heading", "info": "Set on the first row of each group." },
        { "type": "text", "id": "key", "label": "Label", "default": "Unlock methods" },
        { "type": "text", "id": "value", "label": "Value", "default": "Fingerprint · PIN · App · Key" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "OTODOR Product Specs" }]
}
{% endschema %}
