{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Footer — large, modern, brand-forward.
     Dark by design (anchors the light/dark rhythm at the base).
  ───────────────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} { background-color: #060606; }

  .otodor-footer {
    position: relative;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(77, 166, 255, 0.06) 0%, transparent 55%),
      linear-gradient(180deg, #0B0B0B 0%, #060606 100%);
    color: #ffffff;
    overflow: hidden;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .otodor-footer__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
  }

  .otodor-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-top: clamp(3.5rem, 7vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ─ Brand ─────────────────────────────────────────────────── */
  .otodor-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }
  .otodor-footer__logo img {
    width: auto;
    height: 72px;
    max-width: 260px;
    object-fit: contain;
  }
  .otodor-footer__wordmark {
    font-family: var(--otodor-font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #ffffff;
  }
  .otodor-footer__signature {
    margin: 0.95rem 0 0;
    font-family: var(--otodor-font-display);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.62);
  }
  .otodor-footer__tagline {
    margin: 1rem 0 0;
    max-width: 34ch;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.52);
  }

  .otodor-footer__social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }
  .otodor-footer__social a {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.7);
    transition: color 250ms ease, border-color 250ms ease, background-color 250ms ease, transform 250ms ease;
  }
  .otodor-footer__social a:hover {
    color: #ffffff;
    border-color: rgba(77, 166, 255, 0.5);
    background-color: rgba(77, 166, 255, 0.08);
    transform: translateY(-2px);
  }
  .otodor-footer__social svg { width: 18px; height: 18px; }

  /* ─ Link columns ──────────────────────────────────────────── */
  .otodor-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
  }
  .otodor-footer__col-title {
    font-family: var(--otodor-font-display);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #4DA6FF;
    margin: 0 0 1.2rem;
  }
  .otodor-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .otodor-footer__col a {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    transition: color 200ms ease, padding-left 200ms ease;
  }
  .otodor-footer__col a:hover {
    color: #ffffff;
    padding-left: 4px;
  }
  .otodor-footer__contact {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.62);
  }
  .otodor-footer__contact a { color: rgba(255, 255, 255, 0.62); text-decoration: none; }
  .otodor-footer__contact a:hover { color: #ffffff; }

  /* ─ Giant watermark wordmark ──────────────────────────────── */
  .otodor-footer__watermark {
    font-family: var(--otodor-font-display);
    font-weight: 700;
    font-size: clamp(4.5rem, 23vw, 20rem);
    line-height: 0.78;
    letter-spacing: -0.04em;
    text-align: center;
    white-space: nowrap;
    margin-top: clamp(1rem, 3vw, 2.5rem);
    padding-inline: 1rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.085) 0%, rgba(255, 255, 255, 0.012) 70%, transparent 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    user-select: none;
    pointer-events: none;
    transform: translateY(12%);
  }

  /* ─ Bottom bar ────────────────────────────────────────────── */
  .otodor-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .otodor-footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.42);
  }
  .otodor-footer__bottom-inner a { color: rgba(255, 255, 255, 0.6); text-decoration: none; }
  .otodor-footer__bottom-inner a:hover { color: #4DA6FF; }
  .otodor-footer__bottom-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .otodor-footer__bottom-mark { opacity: 0.55; flex: none; }
  .otodor-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  @media (max-width: 900px) {
    .otodor-footer__top { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .otodor-footer__bottom-inner { flex-direction: column; align-items: flex-start; }
  }
{%- endstyle -%}

<footer class="otodor-footer" data-otodor-section="footer" role="contentinfo">
  <div class="otodor-footer__inner">
    <div class="otodor-footer__top">

      <div class="otodor-footer__brand">
        <a href="{{ routes.root_url }}" class="otodor-footer__logo" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 360 | image_tag: loading: 'lazy', alt: shop.name, widths: '120,240,360' }}
          {%- else -%}
            <img src="{{ 'otodor_log_bg_removed.png' | file_img_url: '360x' }}" alt="{{ shop.name }}" loading="lazy">
          {%- endif -%}
        </a>

        <p class="otodor-footer__signature">Secure Smart Automatic</p>

        {%- if section.settings.tagline != blank -%}
          <p class="otodor-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="otodor-footer__social">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h2.5l.5-3H13v-2c0-.6.4-1 1-1z"/></svg></a>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 3h3l-7 8 8.2 10h-6.4l-4.3-5.6L5.3 21H2.3l7.5-8.6L2 3h6.5l3.9 5.1L17.5 3zm-1.1 16h1.7L7.7 4.8H5.9L16.4 19z"/></svg></a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.2 28 28 0 0 0 2 12a28 28 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22 12a28 28 0 0 0-.4-4.8zM10 15V9l5.2 3-5.2 3z"/></svg></a>
            {%- endif -%}
            {%- if settings.social_linkedin_link != blank -%}
              <a href="{{ settings.social_linkedin_link }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.9 8.5H3.8V21h3.1V8.5zM5.3 3.5a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6zM21 13.6c0-3-1.6-4.4-3.8-4.4a3.3 3.3 0 0 0-3 1.6V8.5H11V21h3.1v-6.6c0-1.7.3-3.3 2.4-3.3s2.1 1.9 2.1 3.4V21H21v-7.4z"/></svg></a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="otodor-footer__columns">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu_column' -%}
              <div class="otodor-footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="otodor-footer__col-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul>
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- when 'contact_column' -%}
              <div class="otodor-footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="otodor-footer__col-title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                <div class="otodor-footer__contact">{{ block.settings.content }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>

  <div class="otodor-footer__watermark" aria-hidden="true">{{ section.settings.wordmark | default: 'OTODOR' | escape }}</div>

  <div class="otodor-footer__bottom">
    <div class="otodor-footer__inner otodor-footer__bottom-inner">
      <div class="otodor-footer__bottom-brand">
        {% render 'otodor-monogram', size: 20, class: 'otodor-footer__bottom-mark' %}
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.credit_text != blank %} &middot; {{ section.settings.credit_text | escape }}{%- assign credit_name = section.settings.credit_name | default: 'Viltrumate Technologies' -%}{% if section.settings.credit_link != blank %} <a href="{{ section.settings.credit_link }}">{{ credit_name | escape }}</a>{% else %} {{ credit_name | escape }}{% endif %}{% endif %}</span>
      </div>
      {%- if section.settings.show_policies -%}
        <nav class="otodor-footer__policies" aria-label="Legal">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "OTODOR Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Optional. Defaults to the brand mark." },
    { "type": "text", "id": "wordmark", "label": "Wordmark / big watermark text", "default": "OTODOR" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "A complete smart-security ecosystem — locks, gates, and automation engineered for modern homes." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "credit_text", "label": "Credit text", "default": "Powered by" },
    { "type": "text", "id": "credit_name", "label": "Credit name", "default": "Viltrumate Technologies" },
    { "type": "url", "id": "credit_link", "label": "Credit link" },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact_column",
      "name": "Contact column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>support@otodor.com<br>+91 00000 00000<br>India</p>" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "OTODOR Footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "Products" } },
        { "type": "menu_column", "settings": { "heading": "Company" } },
        { "type": "contact_column" }
      ]
    }
  ]
}
{% endschema %}
