{%- comment -%}
  ════════════════════════════════════════════════════════════════════════
  OTODOR Section: Category Selector  (aka "Door Type Selector")
  Reference implementation for the OTODOR reusable-section standard.
  ────────────────────────────────────────────────────────────────────────
  Purpose:            Generic "choose your category" chooser. Renders a grid
                      of category cards that link to collections. Used as the
                      Digital Locks door-type selector (Wooden / Glass / Metal
                      / Padlocks) and for any other category set.
  Inputs:             `category` blocks, OR — with no blocks — the category's
                      own sub-categories, discovered from Shopify Navigation or
                      from child collections. See CARD SOURCES below.
  Outputs:            Accessible links to collections (or custom URLs), plus an
                      optional "custom / ask an expert" CTA card.
  Dependencies:       snippets/otodor-category-card.liquid (the override chain),
                      snippets/otodor-icon.liquid; otodor-base.css design tokens.
                      No JS. No metaobjects. No external assets.
  Supported sources:  Collection (title, url, image, description) +
                      collection metafields custom.menu_image / menu_description
                      / menu_icon. All optional.
  Reusable for:       Homepage, collection/landing pages, PDP cross-sell —
                      Digital Locks, Gate Automation, Security, Smart Home, etc.
  Merchant editable:  YES — everything via theme-editor settings + blocks.
  Required metafields: none.
  Optional metafields: collection custom.menu_image, custom.menu_description,
                       custom.menu_icon, custom.parent_collection.

  CARD SOURCES (setting `source`, default `auto` = try each in turn):
    1. blocks     `category` blocks — the merchant names the cards explicitly.
    2. menu       Shopify Navigation (setting `menu`, default Main menu). Finds
                  the link pointing at the CURRENT collection and renders its
                  child links as cards. Navigation stays the one source of
                  truth — the same data the mega menu draws (no parallel menu).
                  Off a collection page it renders the menu's top level.
    3. children   Collections whose `custom.parent_collection` is the current
                  collection. Native fallback when the menu isn't built yet.
    → none of the above resolve: the section renders NOTHING.

  Per-field override → fallback is implemented once, in otodor-category-card:
    title / url / image / description / icon — block override wins, then the
    linked collection's metafields, then its own fields, then omitted.
  ════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign scheme = section.settings.color_scheme | default: 'light'
  assign cols = section.settings.columns_desktop | default: 4
  assign source = section.settings.source | default: 'auto'

  # ── Card Source Resolver ────────────────────────────────────────────────
  # Each branch sets `resolved` to the source it will actually render with.
  assign resolved = ''
  assign cat_blocks = section.blocks | where: 'type', 'category'

  if source == 'blocks' or source == 'auto'
    if cat_blocks.size > 0
      assign resolved = 'blocks'
    endif
  endif

  # 2. Navigation — the link whose collection IS this page, then its children.
  assign nav_children = ''
  if resolved == blank and source != 'blocks' and source != 'children'
    assign nav_menu = section.settings.menu
    if nav_menu != blank
      if collection != blank and collection != empty
        for l in nav_menu.links
          if l.links != blank
            if l.type == 'collection_link' and l.object.handle == collection.handle
              assign nav_children = l.links
              break
            endif
            if l.url == collection.url
              assign nav_children = l.links
              break
            endif
            # one level deeper: a sub-category that itself has children
            for l2 in l.links
              if l2.links != blank
                if l2.type == 'collection_link' and l2.object.handle == collection.handle
                  assign nav_children = l2.links
                  break
                endif
                if l2.url == collection.url
                  assign nav_children = l2.links
                  break
                endif
              endif
            endfor
            if nav_children != blank
              break
            endif
          endif
        endfor
      else
        # No collection context (homepage, page): show the menu's top level.
        assign nav_children = nav_menu.links
      endif
    endif
    if nav_children != blank
      assign resolved = 'menu'
    endif
  endif

  # 3. Child collections — custom.parent_collection points back at this page.
  assign child_handles = ''
  if resolved == blank and source != 'blocks' and source != 'menu'
    if collection != blank and collection != empty
      for c in collections limit: 50
        assign parent = c.metafields.custom.parent_collection.value
        if parent != blank and parent.handle == collection.handle
          assign child_handles = child_handles | append: ',' | append: c.handle
        endif
      endfor
      assign child_handles = child_handles | remove_first: ','
    endif
    if child_handles != blank
      assign resolved = 'children'
    endif
  endif
-%}

{%- style -%}
  #otodor-cat-selector-{{ section.id }} {
    padding-block: {{ section.settings.padding_top | default: 96 }}px {{ section.settings.padding_bottom | default: 96 }}px;
  }
  #otodor-cat-selector-{{ section.id }}.otodor-cats--light { background: var(--otodor-bg-light); color: var(--otodor-ink); --cats-accent: var(--otodor-accent-on-light); }
  #otodor-cat-selector-{{ section.id }}.otodor-cats--dark  { background: var(--otodor-black); color: var(--otodor-white); --cats-accent: var(--otodor-blue); }

  #otodor-cat-selector-{{ section.id }} .otodor-cats__inner {
    max-width: var(--otodor-container-wide);
    margin-inline: auto;
  }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__head {
    max-width: 48rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__eyebrow {
    display: block;
    font-family: var(--otodor-font-display);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: var(--otodor-tracking-widest);
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }
  .otodor-cats--light .otodor-cats__eyebrow { color: var(--otodor-accent-on-light); }
  .otodor-cats--dark  .otodor-cats__eyebrow { color: var(--cats-accent); }
  /* The colour MUST be declared here, not inherited from the section:
     Dawn's `h1,h2,…` rule sets `color: rgb(var(--color-foreground))`
     directly on the element, and a declared value always beats an
     inherited one — which printed this heading white on the light band. */
  #otodor-cat-selector-{{ section.id }} .otodor-cats__title {
    font-family: var(--otodor-font-display);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: var(--otodor-tracking-tight);
    margin: 0;
    color: inherit;
  }
  #otodor-cat-selector-{{ section.id }}.otodor-cats--light .otodor-cats__title { color: var(--otodor-ink); }
  #otodor-cat-selector-{{ section.id }}.otodor-cats--dark  .otodor-cats__title { color: var(--otodor-white); }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__title .accent { color: var(--cats-accent); }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__sub {
    margin: 0.9rem 0 0;
    font-size: 1.28rem;
    line-height: 1.55;
    opacity: 0.62;
  }

  #otodor-cat-selector-{{ section.id }} .otodor-cats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    gap: clamp(1rem, 1.8vw, 1.5rem);
  }
  @media (max-width: 990px) { #otodor-cat-selector-{{ section.id }} .otodor-cats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Two-up on phones too — a column of full-width category cards buries the
     later categories below the fold. The card body tightens to suit. */
  @media (max-width: 560px) {
    #otodor-cat-selector-{{ section.id }} .otodor-cats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem; }
    #otodor-cat-selector-{{ section.id }} .otodor-cats__body { padding: 1rem 1rem 1.1rem; gap: 0.35rem; }
    #otodor-cat-selector-{{ section.id }} .otodor-cats__name { font-size: var(--otodor-text-md); }
    /* Clamped to two lines so one wordy category cannot make its tile taller
       than the tile beside it and stagger the row. */
    #otodor-cat-selector-{{ section.id }} .otodor-cats__desc {
      font-size: var(--otodor-text-xs);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    #otodor-cat-selector-{{ section.id }} .otodor-cats__go { font-size: var(--otodor-text-xs); padding-top: 0.6rem; }
    #otodor-cat-selector-{{ section.id }} .otodor-cats__icon svg { width: 20px; height: 20px; }
    /* The CTA card is editorial, not a tile — it keeps the full row. */
    #otodor-cat-selector-{{ section.id }} .otodor-cats__grid > li:has(.otodor-cats__card--cta) { grid-column: 1 / -1; }
  }

  #otodor-cat-selector-{{ section.id }} .otodor-cats__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--otodor-radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: transform var(--otodor-dur-base) var(--otodor-ease-spring),
      border-color var(--otodor-dur-base) ease, box-shadow var(--otodor-dur-base) ease;
  }
  .otodor-cats--light .otodor-cats__card { background: var(--otodor-bg-light-2); border-color: var(--otodor-hairline-light); box-shadow: var(--otodor-shadow-xs); }
  .otodor-cats--dark  .otodor-cats__card { background: var(--otodor-surface); border-color: var(--otodor-hairline); }
  a.otodor-cats__card:hover { transform: translateY(-4px); }
  .otodor-cats--light a.otodor-cats__card:hover { border-color: var(--otodor-hairline-light-2); box-shadow: var(--otodor-shadow-md); }
  .otodor-cats--dark  a.otodor-cats__card:hover { border-color: var(--otodor-glass-border-h); }
  #otodor-cat-selector-{{ section.id }} a.otodor-cats__card:focus-visible { outline: 2px solid var(--cats-accent); outline-offset: 3px; }

  /* The whole image, never a crop — the same treatment the product tile
     uses (.otodor-pcard__media): a square plinth, `contain`, and padding so
     the art sits on the surface rather than bleeding to the card edge.
     `cover` on a 4:3 frame was cutting the top and bottom off every
     category photo. Square because the art is mixed portrait/landscape and
     a square frame is the only one that letterboxes both gently. */
  #otodor-cat-selector-{{ section.id }} .otodor-cats__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 50% 0%, var(--otodor-blue-glow) 0%, transparent 60%),
      linear-gradient(160deg, var(--otodor-surface-2), var(--otodor-surface));
  }
  .otodor-cats--light .otodor-cats__media { background: linear-gradient(160deg, var(--otodor-plinth), var(--otodor-bg-light)); }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__media img {
    width: 100%; height: 100%; object-fit: contain; display: block;
    padding: clamp(0.75rem, 4%, 1.5rem);
    transition: transform var(--otodor-dur-slow) var(--otodor-ease-spring);
  }
  a.otodor-cats__card:hover .otodor-cats__media img { transform: scale(1.05); }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__badge {
    position: absolute; top: 0.75rem; left: 0.75rem;
    font-size: 0.84rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.3rem 0.6rem; border-radius: var(--otodor-radius-pill);
    background: var(--cats-accent); color: #fff;
  }

  /* Card type reads off the tokens, so it follows the theme's body_scale
     from here on instead of drifting again: name 20px / desc 14px / CTA
     14px, with the padding stepped up to match — the old values were
     correct-sized but cramped, which is what read as unattractive. */
  #otodor-cat-selector-{{ section.id }} .otodor-cats__body {
    display: flex; flex-direction: column; gap: 0.55rem;
    padding: clamp(1.4rem, 2vw, 1.9rem);
    flex: 1 1 auto;
  }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__card-top { display: flex; align-items: center; gap: 0.7rem; }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__icon { display: inline-flex; color: var(--cats-accent); }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__icon svg { width: 26px; height: 26px; }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__name {
    font-family: var(--otodor-font-display); font-weight: 600;
    font-size: var(--otodor-text-lg); line-height: 1.25;
    letter-spacing: var(--otodor-tracking-tight); margin: 0;
  }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__desc {
    margin: 0; font-size: var(--otodor-text-sm); line-height: 1.55; opacity: 0.68;
  }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__go {
    margin-top: auto; display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: var(--otodor-text-sm); font-weight: 600; color: var(--cats-accent); padding-top: 0.9rem;
  }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__go svg { width: 17px; height: 17px; transition: transform var(--otodor-dur-fast) ease; }
  a.otodor-cats__card:hover .otodor-cats__go svg { transform: translateX(3px); }

  /* CTA card */
  #otodor-cat-selector-{{ section.id }} .otodor-cats__card--cta { justify-content: center; padding: clamp(1.2rem, 2vw, 1.75rem); }
  .otodor-cats--light .otodor-cats__card--cta { background: var(--otodor-ink); color: #fff; border-color: transparent; }
  .otodor-cats--dark  .otodor-cats__card--cta { background: var(--otodor-gradient-blue-subtle); }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__cta-title { font-family: var(--otodor-font-display); font-weight: 600; font-size: 1.41rem; margin: 0 0 0.4rem; }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__cta-text { font-size: 1.09rem; line-height: 1.5; opacity: 0.72; margin: 0 0 1rem; }
  #otodor-cat-selector-{{ section.id }} .otodor-cats__cta-btn {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.6rem 1.1rem; border-radius: var(--otodor-radius-pill);
    background: var(--cats-accent); color: #fff; font-weight: 600; font-size: 1.05rem; text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #otodor-cat-selector-{{ section.id }} .otodor-cats__card,
    #otodor-cat-selector-{{ section.id }} .otodor-cats__media img { transition: none; }
    a.otodor-cats__card:hover { transform: none; }
    a.otodor-cats__card:hover .otodor-cats__media img { transform: none; }
  }
{%- endstyle -%}

{%- comment -%} Section lifecycle: auto-hide when no source resolves any card. {%- endcomment -%}
{%- if resolved != blank -%}
<section
  id="otodor-cat-selector-{{ section.id }}"
  class="otodor-cats otodor-cats--{{ scheme }}"
  data-otodor-section="category-selector"
  {% if section.settings.heading != blank %}aria-labelledby="otodor-cats-title-{{ section.id }}"{% endif %}
>
  <div class="otodor-cats__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="otodor-cats__head" data-otodor-reveal="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="otodor-cats__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="otodor-cats__title" id="otodor-cats-title-{{ section.id }}">
            {{ section.settings.heading | escape }}{% if section.settings.heading_accent != blank %} <span class="accent">{{ section.settings.heading_accent | escape }}</span>{% endif %}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="otodor-cats__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="otodor-cats__grid" role="list">
      {%- comment -%}
        One card implementation (otodor-category-card), three ways of arriving
        at it. Only the resolved source renders — sources never stack.
      {%- endcomment -%}
      {%- case resolved -%}
        {%- when 'blocks' -%}
          {%- for block in cat_blocks -%}
            {%- render 'otodor-category-card',
              col: block.settings.collection,
              title: block.settings.title,
              url: block.settings.custom_url,
              image: block.settings.image,
              description: block.settings.description,
              icon: block.settings.icon,
              badge: block.settings.badge,
              link_label: section.settings.card_link_label,
              show_icons: section.settings.show_icons,
              show_descriptions: section.settings.show_descriptions,
              attrs: block.shopify_attributes
            -%}
          {%- endfor -%}

        {%- when 'menu' -%}
          {%- for childlink in nav_children -%}
            {%- liquid
              assign nav_col = nil
              if childlink.type == 'collection_link'
                assign nav_col = childlink.object
              endif
            -%}
            {%- render 'otodor-category-card',
              col: nav_col,
              title: childlink.title,
              url: childlink.url,
              link_label: section.settings.card_link_label,
              show_icons: section.settings.show_icons,
              show_descriptions: section.settings.show_descriptions
            -%}
          {%- endfor -%}

        {%- when 'children' -%}
          {%- assign child_list = child_handles | split: ',' -%}
          {%- for h in child_list -%}
            {%- render 'otodor-category-card',
              col: collections[h],
              link_label: section.settings.card_link_label,
              show_icons: section.settings.show_icons,
              show_descriptions: section.settings.show_descriptions
            -%}
          {%- endfor -%}
      {%- endcase -%}

      {%- if section.settings.show_cta -%}
        {%- assign cta_url = section.settings.cta_link | default: routes.root_url -%}
        <li>
          <div class="otodor-cats__card otodor-cats__card--cta" data-otodor-reveal="fade-up">
            {%- if section.settings.cta_title != blank -%}<p class="otodor-cats__cta-title">{{ section.settings.cta_title | escape }}</p>{%- endif -%}
            {%- if section.settings.cta_text != blank -%}<p class="otodor-cats__cta-text">{{ section.settings.cta_text | escape }}</p>{%- endif -%}
            {%- if section.settings.cta_button_label != blank -%}
              <a class="otodor-cats__cta-btn" href="{{ cta_url }}">{{ section.settings.cta_button_label | escape }}{% render 'otodor-icon', name: 'arrow-right' %}</a>
            {%- endif -%}
          </div>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "OTODOR Category Selector",
  "tag": "section",
  "class": "shopify-section otodor-section",
  "settings": [
    { "type": "paragraph", "content": "A generic, collection-driven category chooser. Add a block per category and pick a collection — title, image and description are pulled automatically. With no blocks it finds the current collection's sub-categories from your Navigation, then from child collections, and hides if neither exists. No metaobjects required." },
    { "type": "header", "content": "Cards come from" },
    {
      "type": "select", "id": "source", "label": "Source", "default": "auto",
      "info": "Auto tries each in turn: category blocks → Navigation → child collections → hide.",
      "options": [
        { "value": "auto", "label": "Auto (blocks → navigation → child collections)" },
        { "value": "blocks", "label": "Category blocks only" },
        { "value": "menu", "label": "Navigation only" },
        { "value": "children", "label": "Child collections only" }
      ]
    },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu", "info": "The section finds the link pointing at this collection and renders its child links as cards — the same data as the mega menu." },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which type of lock" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (coloured)", "default": "are you looking for?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Choose your door and we'll show the OTODOR range built for it." },
    { "type": "text", "id": "card_link_label", "label": "Card link label", "default": "Explore" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ], "default": "light" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_descriptions", "label": "Show descriptions", "default": true },
    { "type": "checkbox", "id": "show_icons", "label": "Show icons", "default": true },
    { "type": "header", "content": "\"Custom / ask an expert\" card" },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA card", "default": true },
    { "type": "text", "id": "cta_title", "label": "CTA title", "default": "Any other custom?" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Not sure or need something bespoke? Ask our OTODOR experts." },
    { "type": "text", "id": "cta_button_label", "label": "CTA button label", "default": "Ask an expert" },
    { "type": "url", "id": "cta_link", "label": "CTA button link" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Title, image and description are pulled from this collection unless overridden below." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "description", "label": "Description override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "custom_url", "label": "URL override" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "",
          "options": [
            { "value": "", "label": "None" },
            { "value": "fingerprint", "label": "Fingerprint" },
            { "value": "keypad", "label": "Keypad / PIN" },
            { "value": "key", "label": "Key" },
            { "value": "tag", "label": "RFID / Tag" },
            { "value": "wifi", "label": "Remote / Wi-Fi" },
            { "value": "mobile", "label": "App / Mobile" },
            { "value": "shield", "label": "Shield" },
            { "value": "wrench", "label": "Installation" }
          ]
        },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "e.g. New, Coming soon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTODOR Category Selector",
      "settings": { "source": "blocks" },
      "blocks": [
        { "type": "category", "settings": { "title": "Wooden Door", "description": "Smart locks engineered for wooden main and internal doors.", "icon": "fingerprint" } },
