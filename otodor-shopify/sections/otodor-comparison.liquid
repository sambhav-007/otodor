            "rfid_access": true,
            "app_control": true,
            "auto_lock": true,
            "audit_log": true,
            "warranty": "1 Year"
          }
        },
        {
          "type": "product_column",
          "settings": {
            "title": "NEXUS",
            "fingerprint": true,
            "pin_access": true,
            "rfid_access": true,
            "app_control": true,
            "auto_lock": true,
