{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Comparison Section
     Responsive, sticky-column comparison matrix.
  ───────────────────────────────────────────────────────── */

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 3;
    background-color: transparent;
  }

  .otodor-comparison {
    padding-block: var(--otodor-section-py);
  }

  .otodor-comparison__header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .otodor-comparison__table-wrapper {
    overflow-x: auto;
    border-radius: var(--otodor-radius-xl);
    border: 1px solid var(--otodor-glass-border);
    background: var(--otodor-glass);
    box-shadow: var(--otodor-shadow-md);
  }

  .otodor-comparison__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 750px;
    font-family: var(--otodor-font-body);
  }

  .otodor-comparison__table th,
  .otodor-comparison__table td {
    padding: var(--otodor-space-md) var(--otodor-space-lg);
    border-bottom: 1px solid var(--otodor-hairline);
    font-size: var(--otodor-text-sm);
  }

  .otodor-comparison__table th {
    font-family: var(--otodor-font-display);
    font-weight: 700;
    color: var(--otodor-white);
    background: rgba(18, 18, 18, 0.4);
    letter-spacing: var(--otodor-tracking-wide);
    text-transform: uppercase;
  }

  .otodor-comparison__table th:first-child,
  .otodor-comparison__table td:first-child {
    font-weight: 600;
    color: var(--otodor-white);
    width: 250px;
    position: sticky;
    left: 0;
    background: #0B0B0B;
    z-index: 2;
  }

  .otodor-comparison__table tr:hover td {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .otodor-comparison__icon-check {
    color: var(--otodor-success);
    width: 20px;
    height: 20px;
    display: inline-block;
  }

  .otodor-comparison__icon-dash {
    color: var(--otodor-faint);
    font-weight: 500;
  }

  /* ─ Responsive overrides ────────────────────────────────── */
  @media (max-width: 768px) {
    .otodor-comparison__table-wrapper {
      margin-inline: -1.5rem;
      border-radius: 0;
      border-inline: none;
    }
  }
{%- endstyle -%}

<section
  id="otodor-comparison-{{ section.id }}"
  class="otodor-comparison"
  data-otodor-section="comparison"
  aria-labelledby="otodor-comparison-title-{{ section.id }}"
>
  <div class="otodor-container">
    <div class="otodor-comparison__header otodor-section-header otodor-section-header--center">
      <span class="otodor-eyebrow" data-otodor-reveal="fade-up">{{ section.settings.eyebrow | escape }}</span>
      <h2 class="otodor-heading-2" id="otodor-comparison-title-{{ section.id }}" data-otodor-reveal="fade-up">
        {{ section.settings.heading | escape }}<span class="otodor-accent">{{ section.settings.heading_accent | escape }}</span>
      </h2>
    </div>

    <div class="otodor-comparison__table-wrapper" data-otodor-reveal="fade-up">
      <table class="otodor-comparison__table">
        <thead>
          <tr>
            <th>Specifications</th>
            {%- for block in section.blocks -%}
              <th {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Fingerprint Access</td>
            {%- for block in section.blocks -%}
              <td>
                {%- if block.settings.fingerprint -%}
                  <span class="otodor-comparison__icon-check">✓</span>
                {%- else -%}
                  <span class="otodor-comparison__icon-dash">—</span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <td>PIN Access</td>
            {%- for block in section.blocks -%}
              <td>
                {%- if block.settings.pin_access -%}
                  <span class="otodor-comparison__icon-check">✓</span>
                {%- else -%}
                  <span class="otodor-comparison__icon-dash">—</span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <td>RFID Tag Access</td>
            {%- for block in section.blocks -%}
              <td>
                {%- if block.settings.rfid_access -%}
                  <span class="otodor-comparison__icon-check">✓</span>
                {%- else -%}
                  <span class="otodor-comparison__icon-dash">—</span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <td>Mobile App Control</td>
            {%- for block in section.blocks -%}
              <td>
                {%- if block.settings.app_control -%}
                  <span class="otodor-comparison__icon-check">✓</span>
                {%- else -%}
                  <span class="otodor-comparison__icon-dash">—</span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <td>Auto-Lock Sensor</td>
            {%- for block in section.blocks -%}
              <td>
                {%- if block.settings.auto_lock -%}
                  <span class="otodor-comparison__icon-check">✓</span>
                {%- else -%}
                  <span class="otodor-comparison__icon-dash">—</span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <td>Audit Log Access</td>
            {%- for block in section.blocks -%}
              <td>
                {%- if block.settings.audit_log -%}
                  <span class="otodor-comparison__icon-check">✓</span>
                {%- else -%}
                  <span class="otodor-comparison__icon-dash">—</span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <td>Warranty Period</td>
            {%- for block in section.blocks -%}
              <td style="color: var(--otodor-white); font-weight: 500;">
                {{ block.settings.warranty | escape }}
              </td>
            {%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
