{%- comment -%}
  ════════════════════════════════════════════════════════════════════════
  OTODOR Module: Comparison Matrix  (a CONSUMER of the Spec Rendering Engine)
  See OTODOR-SPEC-ENGINE.md. This section contains NO specification names —
  it only resolves columns and asks the registry + renderer to display them.
  ────────────────────────────────────────────────────────────────────────
  Purpose:            Compare products across the OTODOR specification set.
  Primary source:     otodor-spec-registry (rows) × resolved columns (specs.*)
  Column Resolver:    `product` blocks → **model lineup** (section setting or
                      collection `custom.compare_models`) → the pool's products
                      (collection setting → current collection → PDP siblings)
                      → hide
  Cell priority:      metafield → column seed → model seed → registry default → '—'
  Visibility rule:    Hidden when < 2 columns resolve; empty spec rows are
                      dropped; **columns carrying no data at all are dropped**
                      (while ≥ 2 survive); empty groups print no header.
  Merchant editable:  YES — heading, colour scheme, and the columns (product
                      picker or a manual title/image/link + seed values).
                      NOT the spec list — that lives in the registry.
  Required metafields: none
  Optional metafields: any product specs.* the registry references
  Dependencies:       snippets/otodor-spec-registry, otodor-spec-value,
                      otodor-spec-seed, otodor-icon; otodor-base.css
                      (.otodor-spec__*).
  Preset:             Adds empty columns; renders once two columns have a
                      product or a title (auto-hides until then).
  Accessibility:      <section> landmark + aria-labelledby; <table> with <th
                      scope>; check/dash carry aria-labels; horizontal scroll
                      region is focusable (tabindex="0") so it is keyboard
                      scrollable.
  Reusable for:       PDP (current + siblings), collection/landing (blocks or
                      collection), any category — the registry drives the rows.

  ── TWO COLUMN MODES ───────────────────────────────────────────────────
  `blocks`   columns come from `product` blocks. A block may pick a product
             OR stand alone with just a title/image/link — so a range can be
             compared before those products exist in the catalogue. Blocks
             may also carry SEED values (see snippets/otodor-spec-seed):
             a `spec_id = value` list used only where the product metafield
             is empty, which means real specs.* data always overrides it and
             the seed retires on its own.
  `list`     no blocks: columns are `Title::handle` entries, either the
             MODEL LINEUP (a category pins the published order and can name
             models that are not in the catalogue yet — those get a column
             with a blank handle, filled from the model seed) or simply the
             pool's products. Cells fall back to the model seed either way.
  ════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign max_products = section.settings.max_products | default: 4
  assign scheme = section.settings.color_scheme | default: 'dark'

  # A stable link target. The section's own id is `otodor-comparison-<section.id>`,
  # which on a JSON template is the template's key for this section — a name a
  # CTA elsewhere would have to know and would silently break on rename. This
  # anchor is merchant-set and identical on every template that uses one.
  assign anchor = section.settings.anchor_id | default: 'otodor-compare' | handle

  # The published spec sheet, consulted only where a metafield is empty.
  # Defaults ON so the table is populated before admin data exists; turn it
  # off (or delete the snippet) once specs.* covers the catalogue.
  assign use_model_seed = true
  if section.settings.use_model_seed == false
    assign use_model_seed = false
  endif

  # ── Registry (comparable view) — resolved first, because the column
  #    resolver needs it to tell an empty column from a populated one.
  capture reg
    render 'otodor-spec-registry', only_comparable: true
  endcapture
  assign specs = reg | strip | split: ';;;'

  # ── Column Resolver ─────────────────────────────────────────────────
  # 1. Blocks win when any of them carries a product or a manual title.
  assign mode = ''
  assign col_count = 0
  for block in section.blocks
    if block.type != 'product'
      continue
    endif
    assign b_title = block.settings.title | default: block.settings.product.title
    if b_title != blank
      assign mode = 'blocks'
      assign col_count = col_count | plus: 1
    endif
  endfor

  # 2. Otherwise build a COLUMN LIST — entries are `Title::handle`, joined
  #    by ';;'. A blank handle is a model that has no product yet; it still
  #    gets a column, filled from the seed. One list, so the header, the
  #    rows and the action row all walk the same thing.
  assign col_entries = ''
  if mode == blank
    assign mode = 'list'

    # The pool a model name is matched against.
    assign pool = section.settings.collection.products
    if pool == blank and collection != blank and collection != empty
      assign pool = collection.products
    endif
    if pool == blank and product != blank and product != empty
      assign pool = product.collections.first.products
    endif

    # 2a. An explicit lineup — section setting, else the collection's own
    #     custom.compare_models. This is how a category pins the published
    #     model order and includes models that are not in the catalogue yet.
    assign lineup = section.settings.models
    if lineup == blank
      assign lineup = collection.metafields.custom.compare_models.value
    endif

    if lineup != blank
      assign wanted = lineup | split: ','
      for w in wanted
        assign disp = w | strip
        if disp == blank
          continue
        endif
        assign key = disp | upcase | replace: '-', '' | replace: ' ', '' | replace: '+', '' | replace: '_', ''
        assign klen = key | size
        assign found = ''
        for p in pool limit: 40
          assign ph = p.handle | upcase | replace: '-', '' | replace: ' ', '' | replace: '+', '' | replace: '_', ''
          assign pt = p.title | upcase | replace: '-', '' | replace: ' ', '' | replace: '+', '' | replace: '_', ''
          assign ha = ph | slice: 0, klen
          assign hb = pt | slice: 0, klen
          if ha == key or hb == key
            assign found = p.handle
            break
          endif
        endfor
        assign col_entries = col_entries | append: ';;' | append: disp | append: '::' | append: found
      endfor
    endif

    # 2b. No lineup → the products themselves (collection page, or the
    #     current product plus its siblings on a PDP).
    if col_entries == blank and pool != blank
      for p in pool limit: max_products
        assign col_entries = col_entries | append: ';;' | append: p.title | append: '::' | append: p.handle
      endfor
    endif
    if col_entries == blank and product != blank and product != empty
      assign col_entries = ';;' | append: product.title | append: '::' | append: product.handle
    endif

    assign cols = col_entries | remove_first: ';;' | split: ';;'
    if cols.size > max_products
      assign cols = cols | slice: 0, max_products
    endif

    # 2c. Drop columns that carry NOTHING — no metafield, no seed. A column
    #     of dashes is noise (OHM is in the range but not in the published
    #     sheet). Only applied while at least two columns survive, so a
    #     category with no data yet still gets its table.
    assign kept = ''
    assign kept_n = 0
    for e in cols
      assign parts = e | split: '::'
      assign e_handle = parts[1]
      assign e_prod = nil
      if e_handle != blank
        assign e_prod = all_products[e_handle]
      endif
      assign has_any = false
      for row in specs
        assign pf = row | strip | split: '|'
        if pf[0] == blank
          continue
        endif
        assign mv = e_prod.metafields[pf[2]][pf[3]].value
        if mv != blank
          assign has_any = true
          break
        endif
        if use_model_seed
          capture sv
            render 'otodor-spec-model-seed', product: e_prod, title: parts[0], id: pf[0]
          endcapture
          if sv != blank
            assign has_any = true
            break
          endif
        endif
      endfor
      if has_any
        assign kept = kept | append: ';;' | append: e
        assign kept_n = kept_n | plus: 1
      endif
    endfor
    if kept_n >= 2
      assign cols = kept | remove_first: ';;' | split: ';;'
    endif

    assign col_count = cols.size
  endif
-%}

{%- if col_count >= 2 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} { position: relative; z-index: 3; background-color: transparent; }
    #shopify-section-{{ section.id }} .otodor-comparison { padding-block: var(--otodor-section-py); }
    {%- comment -%} Clears the sticky header when a CTA jumps here. {%- endcomment -%}
    #shopify-section-{{ section.id }} .otodor-comparison__anchor { display: block; scroll-margin-top: 90px; }

    /* Scheme is expressed once, as local custom properties, so the table
       markup below never repeats a colour. */
    #shopify-section-{{ section.id }} .otodor-comparison--dark {
      --cmp-ink: var(--otodor-white);
      --cmp-ink-soft: var(--otodor-faint);
      --cmp-surface: var(--otodor-glass);
      --cmp-border: var(--otodor-glass-border);
      --cmp-hairline: var(--otodor-hairline);
      --cmp-sticky: #0B0B0B;
      --cmp-sticky-hover: #111111;
      --cmp-head: rgba(18, 18, 18, 0.4);
      --cmp-group: rgba(18, 18, 18, 0.6);
      --cmp-accent: var(--otodor-blue);
      --cmp-row-hover: rgba(255, 255, 255, 0.02);
      --cmp-cta-ink: #0B0B0B;
      --cmp-cta-bg: var(--otodor-white);
    }
    #shopify-section-{{ section.id }} .otodor-comparison--light {
      --cmp-ink: var(--otodor-ink);
      --cmp-ink-soft: var(--otodor-ink-soft);
      --cmp-surface: #FFFFFF;
      --cmp-border: var(--otodor-hairline-light-2);
      --cmp-hairline: var(--otodor-hairline-light);
      --cmp-sticky: #FFFFFF;
      --cmp-sticky-hover: var(--otodor-bg-light-2);
      --cmp-head: var(--otodor-bg-light-2);
      --cmp-group: var(--otodor-bg-light-2);
      --cmp-accent: var(--otodor-accent-on-light);
      --cmp-row-hover: rgba(0, 0, 0, 0.02);
      --cmp-cta-ink: #FFFFFF;
      --cmp-cta-bg: var(--otodor-ink);
    }

    #shopify-section-{{ section.id }} .otodor-comparison__header { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
    #shopify-section-{{ section.id }} .otodor-comparison__table-wrapper {
      overflow-x: auto;
      border-radius: var(--otodor-radius-xl);
      border: 1px solid var(--cmp-border);
      background: var(--cmp-surface);
      box-shadow: var(--otodor-shadow-md);
    }
    #shopify-section-{{ section.id }} .otodor-comparison__table-wrapper:focus-visible {
      outline: 2px solid var(--cmp-accent);
      outline-offset: 3px;
    }
    #shopify-section-{{ section.id }} .otodor-comparison__table {
      width: 100%; border-collapse: collapse; text-align: left;
      min-width: 800px; font-family: var(--otodor-font-body);
    }
    #shopify-section-{{ section.id }} .otodor-comparison__table th,
    #shopify-section-{{ section.id }} .otodor-comparison__table td {
      padding: var(--otodor-space-md) var(--otodor-space-lg);
      border-bottom: 1px solid var(--cmp-hairline);
      font-size: var(--otodor-text-sm);
      color: var(--cmp-ink);
      vertical-align: top;
    }
    #shopify-section-{{ section.id }} .otodor-comparison__spec {
      font-family: var(--otodor-font-display); font-weight: 600;
      color: var(--cmp-ink); width: 300px;
      position: sticky; left: 0; background: var(--cmp-sticky); z-index: 2;
    }
    #shopify-section-{{ section.id }} .otodor-comparison__group th {
      font-family: var(--otodor-font-display); font-weight: 700;
      font-size: 0.92rem; text-transform: uppercase;
      letter-spacing: var(--otodor-tracking-wider);
      color: var(--cmp-accent); background: var(--cmp-group);
    }
    #shopify-section-{{ section.id }} .otodor-comparison__prod {
      vertical-align: bottom; background: var(--cmp-head);
    }
    #shopify-section-{{ section.id }} .otodor-comparison__prod a,
    #shopify-section-{{ section.id }} .otodor-comparison__prod .otodor-comparison__name { color: var(--cmp-ink); text-decoration: none; }
    #shopify-section-{{ section.id }} .otodor-comparison__thumb {
      width: 64px; height: 64px; object-fit: contain; display: block;
      margin-bottom: 0.5rem; border-radius: var(--otodor-radius-sm);
      background: rgba(127, 127, 127, 0.06);
    }
    #shopify-section-{{ section.id }} .otodor-comparison__name {
      display: block;
      font-family: var(--otodor-font-display); font-weight: 700;
      letter-spacing: var(--otodor-tracking-wide);
    }
    #shopify-section-{{ section.id }} .otodor-comparison__price { display: block; font-size: 1rem; color: var(--cmp-ink-soft); margin-top: 0.2rem; font-weight: 500; }
    #shopify-section-{{ section.id }} .otodor-comparison__table tbody tr:hover td { background-color: var(--cmp-row-hover); }
    #shopify-section-{{ section.id }} .otodor-comparison__table tbody tr:hover .otodor-comparison__spec { background: var(--cmp-sticky-hover); }

    /* Explore CTA row — mirrors the per-model action in the reference layout. */
    #shopify-section-{{ section.id }} .otodor-comparison__table tfoot td,
    #shopify-section-{{ section.id }} .otodor-comparison__table tfoot th { border-bottom: 0; }
    #shopify-section-{{ section.id }} .otodor-comparison__explore {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.55rem 1.15rem; border-radius: var(--otodor-radius-pill);
      background: var(--cmp-cta-bg); color: var(--cmp-cta-ink);
      font-size: 1.02rem; font-weight: 600; text-decoration: none; white-space: nowrap;
      transition: transform var(--otodor-dur-fast) var(--otodor-ease-spring);
    }
    #shopify-section-{{ section.id }} .otodor-comparison__explore:hover { transform: translateY(-2px); }
    #shopify-section-{{ section.id }} .otodor-comparison__explore svg { width: 14px; height: 14px; }

    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .otodor-comparison__table-wrapper { margin-inline: -1.5rem; border-radius: 0; border-inline: none; }
      #shopify-section-{{ section.id }} .otodor-comparison__spec { width: 190px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .otodor-comparison__explore { transition: none; }
      #shopify-section-{{ section.id }} .otodor-comparison__explore:hover { transform: none; }
    }
  {%- endstyle -%}

  <section
    id="otodor-comparison-{{ section.id }}"
    class="otodor-comparison otodor-comparison--{{ scheme }}"
    data-otodor-section="comparison"
    aria-labelledby="otodor-comparison-title-{{ section.id }}"
  >
    <span id="{{ anchor }}" class="otodor-comparison__anchor" aria-hidden="true"></span>
    <div class="otodor-container">
      <div class="otodor-comparison__header otodor-section-header otodor-section-header--center">
        <span class="otodor-eyebrow" data-otodor-reveal="fade-up">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="otodor-heading-2" id="otodor-comparison-title-{{ section.id }}" data-otodor-reveal="fade-up">
          {{ section.settings.heading | escape }}<span class="otodor-accent">{{ section.settings.heading_accent | escape }}</span>
        </h2>
      </div>

      <div
        class="otodor-comparison__table-wrapper"
        data-otodor-reveal="fade-up"
        tabindex="0"
        role="region"
        aria-labelledby="otodor-comparison-title-{{ section.id }}"
      >
        <table class="otodor-comparison__table">
          <thead>
            <tr>
              <th class="otodor-comparison__spec" scope="col">{{ section.settings.spec_column_label | escape }}</th>
              {%- if mode == 'blocks' -%}
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign bp = block.settings.product
                    assign c_title = block.settings.title | default: bp.title
                    assign c_image = block.settings.image | default: bp.featured_image
                    assign c_url = block.settings.url | default: bp.url
                  -%}
                  {%- if c_title != blank -%}
                    <th class="otodor-comparison__prod" scope="col" {{ block.shopify_attributes }}>
                      {%- if c_url != blank -%}<a href="{{ c_url }}">{%- endif -%}
                        {%- if c_image != blank -%}
                          {{ c_image | image_url: width: 128 | image_tag: loading: 'lazy', class: 'otodor-comparison__thumb', widths: '64,128', alt: c_title | escape }}
                        {%- endif -%}
                        <span class="otodor-comparison__name">{{ c_title | escape }}</span>
                        {%- if bp != blank and bp.price > 0 -%}<span class="otodor-comparison__price">{{ bp.price | money }}</span>{%- endif -%}
                      {%- if c_url != blank -%}</a>{%- endif -%}
                    </th>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for e in cols -%}
                  {%- liquid
                    assign parts = e | split: '::'
                    assign c_title = parts[0]
                    assign p = nil
                    if parts[1] != blank
                      assign p = all_products[parts[1]]
                    endif
                    if p != blank and p != empty
                      assign c_title = p.title
                    else
                      assign p = nil
                    endif
                  -%}
                  <th class="otodor-comparison__prod" scope="col">
                    {%- if p -%}<a href="{{ p.url }}">{%- endif -%}
                      {%- if p.featured_image -%}
                        {{ p.featured_image | image_url: width: 128 | image_tag: loading: 'lazy', class: 'otodor-comparison__thumb', widths: '64,128', alt: c_title | escape }}
                      {%- endif -%}
                      <span class="otodor-comparison__name">{{ c_title | escape }}</span>
                      {%- if p.price > 0 -%}<span class="otodor-comparison__price">{{ p.price | money }}</span>{%- endif -%}
                    {%- if p -%}</a>{%- endif -%}
                  </th>
                {%- endfor -%}
              {%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- assign current_group = '' -%}
            {%- for row in specs -%}
              {%- assign f = row | strip | split: '|' -%}
              {%- if f[0] == blank -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign s_ns = f[2]
                assign s_key = f[3]
                assign s_default = f[7]

                # Row visibility: does ANY column carry this spec — as a
                # metafield, as a seed value, or as a registry default?
                assign row_has = false
                if s_default != blank
                  assign row_has = true
                endif
                unless row_has
                  if mode == 'blocks'
                    for block in section.blocks
                      assign mv = block.settings.product.metafields[s_ns][s_key].value
                      if mv != blank
                        assign row_has = true
                        break
                      endif
                      capture sv
                        render 'otodor-spec-seed', seed: block.settings.values, id: f[0]
                      endcapture
                      if sv == blank and use_model_seed
                        capture sv
                          render 'otodor-spec-model-seed', product: block.settings.product, title: block.settings.title, id: f[0]
                        endcapture
                      endif
                      if sv != blank
                        assign row_has = true
                        break
                      endif
                    endfor
                  else
                    for e in cols
                      assign parts = e | split: '::'
                      assign p = nil
                      if parts[1] != blank
                        assign p = all_products[parts[1]]
                      endif
                      assign mv = p.metafields[s_ns][s_key].value
                      if mv != blank
                        assign row_has = true
                        break
                      endif
                      if use_model_seed
                        capture sv
                          render 'otodor-spec-model-seed', product: p, title: parts[0], id: f[0]
                        endcapture
                        if sv != blank
                          assign row_has = true
                          break
                        endif
                      endif
                    endfor
                  endif
                endunless
              -%}
              {%- if row_has -%}
                {%- if f[6] != blank and f[6] != current_group -%}
                  {%- assign current_group = f[6] -%}
                  <tr class="otodor-comparison__group">
                    <th class="otodor-comparison__spec" scope="colgroup" colspan="{{ col_count | plus: 1 }}">{{ f[6] | escape }}</th>
                  </tr>
                {%- endif -%}
                <tr>
                  <th class="otodor-comparison__spec" scope="row">{{ f[1] | escape }}</th>
                  {%- if mode == 'blocks' -%}
                    {%- for block in section.blocks -%}
                      {%- liquid
                        assign bp = block.settings.product
                        assign c_title = block.settings.title | default: bp.title
                      -%}
                      {%- if c_title != blank -%}
                        {%- comment -%}
                          The seed is handed over as `spec_default`, which the
                          value resolver only reaches when the metafield is
                          empty — so admin data always wins. Falls back to the
                          registry default when the column has no seed line.
                        {%- endcomment -%}
                        {%- capture seed_val -%}{%- render 'otodor-spec-seed', seed: block.settings.values, id: f[0] -%}{%- endcapture -%}
                        {%- assign seed_val = seed_val | strip -%}
                        {%- if seed_val == blank and use_model_seed -%}
                          {%- capture seed_val -%}{%- render 'otodor-spec-model-seed', product: bp, title: c_title, id: f[0] -%}{%- endcapture -%}
                          {%- assign seed_val = seed_val | strip -%}
                        {%- endif -%}
                        {%- assign cell_default = seed_val | default: f[7] -%}
                        <td>{%- render 'otodor-spec-value', product: bp, namespace: f[2], key: f[3], type: f[4], unit: f[5], spec_default: cell_default, context: 'comparison' -%}</td>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- for e in cols -%}
                      {%- liquid
                        assign parts = e | split: '::'
                        assign p = nil
                        if parts[1] != blank
                          assign p = all_products[parts[1]]
                        endif
                      -%}
                      {%- capture seed_val -%}{%- if use_model_seed -%}{%- render 'otodor-spec-model-seed', product: p, title: parts[0], id: f[0] -%}{%- endif -%}{%- endcapture -%}
                      {%- assign cell_default = seed_val | strip | default: f[7] -%}
                      <td>{%- render 'otodor-spec-value', product: p, namespace: f[2], key: f[3], type: f[4], unit: f[5], spec_default: cell_default, context: 'comparison' -%}</td>
                    {%- endfor -%}
                  {%- endif -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>

          {%- if section.settings.show_explore -%}
            <tfoot>
              <tr>
                <th class="otodor-comparison__spec" scope="row"><span class="visually-hidden">{{ section.settings.explore_label | escape }}</span></th>
                {%- if mode == 'blocks' -%}
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign bp = block.settings.product
                      assign c_title = block.settings.title | default: bp.title
                      assign c_url = block.settings.url | default: bp.url
                    -%}
                    {%- if c_title != blank -%}
                      <td>
                        {%- if c_url != blank -%}
                          <a class="otodor-comparison__explore" href="{{ c_url }}">
                            {{ section.settings.explore_label | escape }}
                            <span class="visually-hidden">{{ c_title | escape }}</span>
                            {%- render 'otodor-icon', name: 'arrow-right' -%}
                          </a>
                        {%- endif -%}
                      </td>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for e in cols -%}
                    {%- liquid
                      assign parts = e | split: '::'
                      assign p = nil
                      if parts[1] != blank
                        assign p = all_products[parts[1]]
                      endif
                    -%}
                    <td>
                      {%- if p != blank and p != empty -%}
                        <a class="otodor-comparison__explore" href="{{ p.url }}">
                          {{ section.settings.explore_label | escape }}
                          <span class="visually-hidden">{{ p.title | escape }}</span>
                          {%- render 'otodor-icon', name: 'arrow-right' -%}
                        </a>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                {%- endif -%}
              </tr>
            </tfoot>
          {%- endif -%}
        </table>
      </div>
    </div>
  </section>

{%- elsif request.design_mode -%}
  <section class="otodor-comparison" style="padding-block: var(--otodor-section-py);">
    <div class="otodor-container">
      <p style="font-family: var(--otodor-font-body); color: var(--otodor-ink-soft); text-align: center;">
        <strong>Comparison Matrix</strong> — add at least two columns (pick a product, or just give a column
        a title) or pick a collection. Spec rows come from the OTODOR specification registry automatically.
      </p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "OTODOR Comparison Matrix",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 5,
  "settings": [
