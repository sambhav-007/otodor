    { "type": "text", "id": "serial_hint", "label": "Serial number hint", "default": "Printed on the inside panel and on the box label." },
    { "type": "text", "id": "label_date", "label": "Purchase / installation date label", "default": "Purchase or installation date" },
    { "type": "text", "id": "label_product", "label": "Product label", "default": "Which product?" },
    { "type": "text", "id": "product_placeholder", "label": "Product placeholder", "default": "Select your model" },
    { "type": "text", "id": "product_other", "label": "Last product option", "default": "Other / not listed", "info": "Leave blank to omit." },
    { "type": "text", "id": "label_issue", "label": "Issue label", "default": "What is the issue?" },
    { "type": "text", "id": "issue_placeholder", "label": "Issue placeholder", "default": "Select a category" },
    { "type": "text", "id": "label_message", "label": "Description label", "default": "Describe the problem" },
    { "type": "text", "id": "message_placeholder", "label": "Description placeholder", "default": "What happens, when it started, and anything you have already tried…" },
    { "type": "text", "id": "message_hint", "label": "Description hint", "default": "Photos or a short video help — our engineer will ask for them on WhatsApp." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit complaint" },
    { "type": "text", "id": "form_note", "label": "Note under the buttons", "default": "We acknowledge every complaint within one business day." },

    { "type": "header", "content": "Preferred contact" },
