        { "type": "text", "id": "title", "label": "Title", "default": "Answered in one business day" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every complaint is acknowledged by a real person." }
      ]
    },
    {
      "type": "issue",
      "name": "Issue category",
      "settings": [
        { "type": "text", "id": "label", "label": "Category label", "default": "Product not working" }
      ]
    },
    {
      "type": "model",
      "name": "Product option",
      "settings": [
        { "type": "text", "id": "label", "label": "Product label", "default": "ZEAL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTODOR Complaint Form",
      "blocks": [
        { "type": "promise", "settings": { "icon": "log", "title": "Answered in one business day", "text": "Every complaint is acknowledged by a real person, not a bot." } },
        { "type": "promise", "settings": { "icon": "warranty", "title": "3-year warranty", "text": "In-warranty faults are repaired or replaced at no cost (1-year battery)." } },
        { "type": "promise", "settings": { "icon": "installation", "title": "Engineer visit if needed", "text": "Certified OTODOR technicians across 10,000+ PIN codes." } },
        { "type": "issue", "settings": { "label": "Product not working" } },
        { "type": "issue", "settings": { "label": "Installation issue" } },
        { "type": "issue", "settings": { "label": "Fingerprint / access not recognised" } },
        { "type": "issue", "settings": { "label": "App or connectivity problem" } },
        { "type": "issue", "settings": { "label": "Damaged or wrong item delivered" } },
        { "type": "issue", "settings": { "label": "Warranty claim" } },
        { "type": "issue", "settings": { "label": "Delivery delay" } },
        { "type": "issue", "settings": { "label": "Something else" } }
      ]
    }
  ]
}
{% endschema %}
