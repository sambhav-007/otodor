    { "type": "textarea", "id": "success_text", "label": "Success text", "default": "Thank you — our service team will contact you within one business day. Need it faster? Send the same details on WhatsApp." },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
