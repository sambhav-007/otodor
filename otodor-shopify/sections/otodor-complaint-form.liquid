          "options": [
            { "value": "", "label": "None" },
            { "value": "warranty", "label": "Warranty / Shield" },
            { "value": "installation", "label": "Installation" },
            { "value": "smart", "label": "Smart / Support" },
            { "value": "log", "label": "Clock / Log" },
            { "value": "remote", "label": "Remote" },
            { "value": "star", "label": "Star" }
          ]
