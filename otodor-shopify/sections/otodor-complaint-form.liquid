    { "type": "text", "id": "label_preferred", "label": "Preferred contact label", "default": "How should we reach you?" },
    { "type": "text", "id": "preferred_options", "label": "Options (comma separated)", "default": "Phone call, WhatsApp, Email" },

    { "type": "header", "content": "Consent" },
