{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Collection Grid — light discovery surface.
     Category rail → 3-up product grid → dark consult CTA.
     Technology-first: clarity over decoration.
  ───────────────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    background: var(--otodor-bg-light);
  }
  .otodor-cgrid {
    max-width: var(--otodor-container);
    margin: 0 auto;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .otodor-cgrid__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 0.5rem 0 2rem;
  }
  .otodor-cgrid__sort {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--otodor-font-body);
    font-size: 0.85rem;
    color: var(--otodor-ink-soft);
  }
  .otodor-cgrid__sort select {
    font-family: var(--otodor-font-body);
    font-size: 0.85rem;
    color: var(--otodor-ink);
    background: transparent;
    border: 1px solid var(--otodor-hairline-light-2);
    border-radius: var(--otodor-radius-pill);
    padding: 0.4rem 1rem;
    cursor: pointer;
  }

  .otodor-cgrid__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  @media (max-width: 989px) {
    .otodor-cgrid__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .otodor-cgrid__grid { grid-template-columns: 1fr; }
  }

  .otodor-cgrid__empty {
    text-align: center;
    padding: clamp(4rem, 10vw, 7rem) 1rem;
  }
  .otodor-cgrid__empty h2 {
    font-family: var(--otodor-font-display);
    font-size: var(--otodor-text-2xl);
    color: var(--otodor-ink);
    margin: 0 0 0.8rem;
  }
  .otodor-cgrid__empty p {
    font-family: var(--otodor-font-body);
    color: var(--otodor-ink-soft);
    margin: 0;
  }

  /* Pagination — quiet text links */
  .otodor-cgrid__pagination {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-family: var(--otodor-font-body);
    font-size: 0.9rem;
  }
  .otodor-cgrid__pagination a,
  .otodor-cgrid__pagination span {
    color: var(--otodor-ink-soft);
    text-decoration: none;
    padding: 0.4rem 0.8rem;
  }
  .otodor-cgrid__pagination a:hover { color: var(--otodor-ink); }
  .otodor-cgrid__pagination .current {
    color: var(--otodor-ink);
    font-weight: 600;
    border-bottom: 2px solid var(--otodor-accent-on-light);
  }

  /* Dark consult CTA strip */
  .otodor-cgrid-cta {
    background:
      radial-gradient(ellipse 80% 70% at 50% 0%, rgba(77, 166, 255, 0.08) 0%, transparent 55%),
      linear-gradient(180deg, #0F0F0F 0%, #080808 100%);
    color: #FFFFFF;
  }
  .otodor-cgrid-cta__inner {
    max-width: var(--otodor-container);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
  }
  .otodor-cgrid-cta__title {
    font-family: var(--otodor-font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    font-weight: 600;
    letter-spacing: var(--otodor-tracking-tight);
    margin: 0;
  }
  .otodor-cgrid-cta__sub {
    font-family: var(--otodor-font-body);
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 0.4rem 0 0;
  }
  .otodor-cgrid-cta__btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--otodor-font-body);
    font-size: 0.92rem;
    font-weight: 600;
    color: #0B0B0B;
    background: #FFFFFF;
    text-decoration: none;
    border-radius: var(--otodor-radius-pill);
    padding: 0.85rem 1.8rem;
    transition: transform var(--otodor-dur-fast) var(--otodor-ease-spring),
                box-shadow var(--otodor-dur-fast) var(--otodor-ease-out);
  }
  .otodor-cgrid-cta__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.15);
  }
  .otodor-cgrid-cta__btn svg { width: 18px; height: 18px; }
{%- endstyle -%}

<div class="otodor-cgrid">

  <div class="otodor-cgrid__toolbar">
    <nav class="otodor-rail" aria-label="Categories">
      <a href="{{ routes.all_products_collection_url }}" class="otodor-rail__pill{% if collection.handle == 'all' %} otodor-rail__pill--active{% endif %}">All</a>
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <a
            href="{{ block.settings.collection.url }}"
            class="otodor-rail__pill{% if block.settings.collection.handle == collection.handle %} otodor-rail__pill--active{% endif %}"
            {{ block.shopify_attributes }}
          >{{ block.settings.label | default: block.settings.collection.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- if section.settings.show_sort -%}
      <label class="otodor-cgrid__sort">
        Sort
        <select onchange="window.location.href = '{{ collection.url }}?sort_by=' + this.value;" aria-label="Sort products">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size == 0 -%}
      <div class="otodor-cgrid__empty">
        <h2>Nothing here yet</h2>
        <p>New devices are on the way. <a href="{{ routes.all_products_collection_url }}">Browse all products</a>.</p>
      </div>
    {%- else -%}
      <div class="otodor-cgrid__grid">
        {%- for product in collection.products -%}
          {%- assign card_lazy = true -%}
          {%- if forloop.index <= 3 -%}{%- assign card_lazy = false -%}{%- endif -%}
          {% render 'otodor-card-product', card_product: product, lazy: card_lazy %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="otodor-cgrid__pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="current">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{%- if section.settings.show_cta -%}
  {%- assign wa_number = settings.otodor_whatsapp_number | default: '917206895607' -%}
  {%- assign wa_message = section.settings.cta_whatsapp_message | default: 'Hello! I need help choosing an OTODOR product.' | url_encode -%}
  <div class="otodor-cgrid-cta">
    <div class="otodor-cgrid-cta__inner">
      <div>
        <h2 class="otodor-cgrid-cta__title">{{ section.settings.cta_title | escape }}</h2>
        {%- if section.settings.cta_sub != blank -%}
          <p class="otodor-cgrid-cta__sub">{{ section.settings.cta_sub | escape }}</p>
        {%- endif -%}
      </div>
      <a class="otodor-cgrid-cta__btn" href="https://wa.me/{{ wa_number }}?text={{ wa_message }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.7 14.9L2 22l5.3-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7.1 3.9zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.4-3c-.3-.4 0-.5.2-.7l.4-.5c.1-.2.1-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.7 4.3 3.8.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.3-.2z"/></svg>
        {{ section.settings.cta_button_label | escape }}
      </a>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "OTODOR Collection Grid",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 24, "step": 3, "default": 12 },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true },
    { "type": "header", "content": "Consult CTA" },
    { "type": "checkbox", "id": "show_cta", "label": "Show consult CTA", "default": true },
    { "type": "text", "id": "cta_title", "label": "CTA title", "default": "Not sure which lock fits your door?" },
    { "type": "text", "id": "cta_sub", "label": "CTA supporting line", "default": "We verify compatibility before installation — talk to a specialist." },
    { "type": "text", "id": "cta_button_label", "label": "Button label", "default": "Talk to us" },
    { "type": "text", "id": "cta_whatsapp_message", "label": "Pre-filled WhatsApp message", "default": "Hello! I need help choosing an OTODOR product." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category pill",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "OTODOR Collection Grid" }]
}
{% endschema %}
