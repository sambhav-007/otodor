{%- style -%}
  /* ─────────────────────────────────────────────────────────
     OTODOR Features — asymmetric "bento" grid.
     Tiles vary in size (hierarchy) and each is filled with a
     restrained CSS/SVG technical motif so there is no dead space.
  ───────────────────────────────────────────────────────── */

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 3;
    background-color: transparent;
  }

  .otodor-features {
    padding-block: var(--otodor-section-py);
  }

  /* Header — left-aligned split (breaks the centered accent-word pattern) */
  .otodor-features__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--otodor-space-lg);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .otodor-features__header-text { max-width: 40ch; }

  .otodor-features__subheading {
    font-family: var(--otodor-font-body);
    font-size: var(--otodor-text-sm);
    line-height: var(--otodor-leading-base);
    color: var(--otodor-muted);
    max-width: 38ch;
    margin: 0;
    text-align: right;
  }

  /* ─ Bento grid ──────────────────────────────────────────── */
  .otodor-features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(168px, auto);
    grid-auto-flow: dense;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .otodor-feature-tile {
    position: relative;
    overflow: hidden;
    padding: clamp(1.4rem, 2.2vw, 2rem);
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    isolation: isolate;
  }

  /* Grid placement lives on the glow wrapper (the actual grid child) */
  .otodor-feature-tile-glow--large { grid-column: span 2; grid-row: span 2; }
  .otodor-feature-tile-glow--wide  { grid-column: span 2; }
  .otodor-feature-tile-glow--small { grid-column: span 1; }

  /* BorderGlow wrapper: keep only the glow layers; the inner tile carries the frame */
  .otodor-feature-tile-glow.border-glow-card {
    --border-radius: 20px;
    background: transparent;
    border: none;
    box-shadow: none;
    height: 100%;
  }
  .otodor-feature-tile-glow > .border-glow-inner { height: 100%; }
  .otodor-feature-tile-glow > .border-glow-inner > .otodor-feature-tile { height: 100%; }

  /* Large hero tile anchors its content to the bottom over the render */
  .otodor-feature-tile--large { justify-content: flex-end; }

  /* Content sits above the motif */
  .otodor-feature-tile__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 30ch;
  }

  .otodor-feature-tile__icon {
    color: var(--otodor-blue);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(77, 166, 255, 0.08);
    border: 1px solid rgba(77, 166, 255, 0.16);
    margin-bottom: 0.6rem;
  }

  .otodor-feature-tile__icon svg { width: 22px; height: 22px; }

  .otodor-feature-tile--large .otodor-feature-tile__title {
    font-size: clamp(1.92rem, 2.2vw, 2.56rem);
  }

  .otodor-feature-tile__title {
    font-family: var(--otodor-font-display);
    font-size: var(--otodor-text-lg);
    font-weight: 700;
    line-height: var(--otodor-leading-tight);
    letter-spacing: var(--otodor-tracking-tight);
    color: var(--otodor-white);
    margin: 0;
  }

  .otodor-feature-tile__desc {
    font-family: var(--otodor-font-body);
    font-size: var(--otodor-text-sm);
    line-height: var(--otodor-leading-base);
    color: var(--otodor-muted);
    margin: 0;
  }

  /* Hover: lift + intensify motif */
  .otodor-feature-tile {
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 400ms ease, box-shadow 400ms ease;
  }
  .otodor-feature-tile:hover { transform: translateY(-4px); }
  .otodor-feature-tile:hover .feat-motif { opacity: 0.9; }

  /* ─ Motif base ──────────────────────────────────────────── */
  .feat-motif {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.55;
    transition: opacity 400ms ease;
  }
  .feat-motif svg { display: block; }
  .feat-motif--stroke { stroke: var(--otodor-blue); fill: none; }

  /* Fingerprint (large) — product render + scanning sweep */
  .otodor-feature-tile--large .otodor-feature-tile__render {
    position: absolute;
    z-index: 2;
    right: 4%;
    top: 50%;
    transform: translateY(-50%);
    width: 54%;
    max-width: 425px;
    height: 84%;
    object-fit: contain;
    object-position: center right;
    filter: drop-shadow(0 24px 50px rgba(0, 0, 0, 0.6)) drop-shadow(0 0 30px rgba(77, 166, 255, 0.12));
    pointer-events: none;
  }
  .feat-fingerprint {
    left: auto; right: 2%; width: 58%;
    display: flex; align-items: center; justify-content: center;
    opacity: 0.4;
  }
  .feat-fingerprint svg { width: 78%; height: auto; color: var(--otodor-blue); }
  .feat-fingerprint::after {
    content: ""; position: absolute; left: 42%; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, rgba(77, 166, 255, 0.9), transparent);
    top: 18%;
    box-shadow: 0 0 12px rgba(77, 166, 255, 0.6);
    animation: feat-scan 3.4s ease-in-out infinite;
  }
  @keyframes feat-scan { 0%,100% { top: 22%; opacity: 0.2; } 50% { top: 74%; opacity: 1; } }

  /* Mobile app (wide) — minimal phone mock */
  .feat-app {
    display: flex; align-items: center; justify-content: flex-end;
    padding-right: 8%;
  }
  .feat-phone {
    width: 145px; height: 190px; border-radius: 22px;
    border: 1px solid rgba(255,255,255,0.14);
    background: linear-gradient(160deg, rgba(40,46,58,0.6), rgba(12,14,20,0.6));
    box-shadow: 0 18px 40px rgba(0,0,0,0.5); padding: 12px 10px;
    display: flex; flex-direction: column; gap: 7px;
  }
  .feat-phone__pill { height: 28px; border-radius: 8px; background: rgba(77,166,255,0.16); border: 1px solid rgba(77,166,255,0.3); position: relative; }
  .feat-phone__pill::after { content:""; position:absolute; right:6px; top:6px; width:16px; height:16px; border-radius:50%; background: var(--otodor-blue); box-shadow: 0 0 10px rgba(77,166,255,0.7); animation: feat-toggle 3s ease-in-out infinite; }
  @keyframes feat-toggle { 0%,45% { right:6px; } 55%,100% { right: calc(100% - 22px); } }
  .feat-phone__row { height: 9px; border-radius: 5px; background: rgba(255,255,255,0.07); }
  .feat-phone__row--short { width: 60%; }

  /* Signal (small) — concentric remote waves */
  .feat-signal { display:flex; align-items:center; justify-content:center; }
  .feat-signal span { position:absolute; width: 26px; height: 26px; border-radius:50%; border:1.5px solid rgba(77,166,255,0.5); animation: feat-ping 3s ease-out infinite; }
  .feat-signal span:nth-child(2){ animation-delay: 1s; }
  .feat-signal span:nth-child(3){ animation-delay: 2s; }
  @keyframes feat-ping { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(3.4); opacity: 0; } }

  /* RFID (small) — card + tap ripple */
  .feat-rfid { display:flex; align-items:center; justify-content:center; }
  .feat-rfid__card { width:52px; height:34px; border-radius:6px; border:1.5px solid rgba(77,166,255,0.5); position:relative; }
  .feat-rfid__card::before { content:""; position:absolute; right:6px; top:8px; width:10px; height:10px; border-radius:50%; border:1.5px solid rgba(77,166,255,0.6); }
  .feat-rfid__ripple { position:absolute; width:34px; height:34px; border-radius:50%; border:1.5px solid rgba(77,166,255,0.4); animation: feat-ping 2.6s ease-out infinite; }

  /* Keypad (wide) — anti-peep PIN grid */
  .feat-keypad { display:flex; align-items:center; justify-content:flex-end; padding-right: 9%; }
  .feat-keypad__grid { display:grid; grid-template-columns: repeat(3, 18px); grid-auto-rows: 18px; gap: 9px; }
  .feat-keypad__grid i { display:block; border-radius:50%; border:1.5px solid rgba(255,255,255,0.14); }
  .feat-keypad__grid i.lit { border-color: rgba(77,166,255,0.7); background: rgba(77,166,255,0.18); box-shadow:0 0 10px rgba(77,166,255,0.4); animation: feat-key 4s steps(1) infinite; }
  .feat-keypad__grid i:nth-child(2).lit { animation-delay: 1s; }
  .feat-keypad__grid i:nth-child(8).lit { animation-delay: 2s; }
  .feat-keypad__grid i:nth-child(6).lit { animation-delay: 3s; }
  @keyframes feat-key { 0%,20% { opacity:1; } 25%,100% { opacity:0.25; } }

  /* Log (wide) — audit feed rows */
  .feat-log { display:flex; flex-direction:column; justify-content:center; gap:7px; padding-right: 8%; align-items:flex-end; }
  .feat-log__row { display:flex; align-items:center; gap:10px; width: 190px; opacity:0.5; }
  .feat-log__row i { width:6px; height:6px; border-radius:50%; background: var(--otodor-blue); flex:0 0 auto; }
  .feat-log__row b { height:7px; border-radius:4px; background: rgba(255,255,255,0.12); flex:1; }
  .feat-log__row--active { opacity:1; animation: feat-logfeed 4s ease-in-out infinite; }
  @keyframes feat-logfeed { 0%,100% { opacity:0.35; } 50% { opacity:1; } }

  /* ─ Responsive ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .otodor-features__grid { grid-template-columns: repeat(2, 1fr); }
    .otodor-feature-tile-glow--large { grid-column: span 2; grid-row: span 1; min-height: 325px; }
    .otodor-feature-tile-glow--wide  { grid-column: span 2; }
    .otodor-feature-tile-glow--small { grid-column: span 1; }
  }

  /* ─ Phones ───────────────────────────────────────────────────
     A bento that collapses to one column stops being a bento: six
     full-width bars, three screens of scrolling, no hierarchy. It stays
     a grid — two up — with the hero tile keeping the full row because it
     carries the product render. The tile is rebuilt for ~163px rather
     than merely narrowed (same treatment as the product cards, STEP 14):
     padding roughly halves, type steps down one rung, and both title and
     description line-clamp so one long feature name can't make its tile
     taller than its neighbour and stagger the row.
  ───────────────────────────────────────────────────────────── */
  @media (max-width: 599px) {
    .otodor-features__header { flex-direction: column; align-items: flex-start; }
    .otodor-features__subheading { text-align: left; }

    .otodor-features__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(150px, auto);
      gap: 0.7rem;
    }
    .otodor-feature-tile-glow--large { grid-column: span 2; grid-row: auto; min-height: 260px; }
    .otodor-feature-tile-glow--wide,
    .otodor-feature-tile-glow--small { grid-column: span 1; grid-row: auto; }

    .otodor-feature-tile { padding: 0.9rem; border-radius: 16px; }
    .otodor-feature-tile--large { padding: 1.25rem; }

    .otodor-feature-tile__icon {
      width: 32px; height: 32px; border-radius: 9px; margin-bottom: 0.45rem;
    }
    .otodor-feature-tile__icon svg { width: 18px; height: 18px; }

    .otodor-feature-tile__content { max-width: none; gap: 0.3rem; }
    .otodor-feature-tile__title {
      font-size: var(--otodor-text-lg);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .otodor-feature-tile--large .otodor-feature-tile__title {
      font-size: var(--otodor-text-xl);
      -webkit-line-clamp: 3;
    }
    {%- comment -%}
      The description keeps its reading size and clamps at four lines, not
      three: a grid row is as tall as its tallest tile anyway, so the pair
      stays level whether the copy runs long or short — there is nothing to
      buy by cutting the sentence, only meaning to lose.
    {%- endcomment -%}
    .otodor-feature-tile__desc {
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* The motifs were drawn for a tile twice this wide, and they sit
       behind the copy. Shrink them, drop them to the bottom of the tile
       and take the opacity down so they read as texture under the text
       rather than something the text is printed on top of. */
    .otodor-feature-tile--large .otodor-feature-tile__render { width: 42%; right: 3%; height: 72%; }
    .otodor-feature-tile--wide .feat-motif,
    .otodor-feature-tile--small .feat-motif { opacity: 0.34; }

    .feat-app,
    .feat-keypad,
    .feat-log { align-items: flex-end; justify-content: flex-end; padding: 0 8% 8% 0; }
    .feat-signal,
    .feat-rfid { align-items: flex-end; padding-bottom: 14%; }

    .feat-phone {
      width: 92px; height: 120px; border-radius: 14px; padding: 8px 7px; gap: 5px;
    }
    .feat-phone__pill { height: 20px; border-radius: 6px; }
    .feat-phone__pill::after { width: 12px; height: 12px; top: 4px; }
    .feat-phone__row { height: 6px; }

    .feat-keypad__grid { grid-template-columns: repeat(3, 14px); grid-auto-rows: 14px; gap: 7px; }

    .feat-log { gap: 5px; }
    .feat-log__row { width: 104px; gap: 7px; }

    .feat-signal span { width: 20px; height: 20px; }
    .feat-rfid__card { width: 42px; height: 28px; }
    .feat-rfid__card::before { right: 5px; top: 6px; width: 8px; height: 8px; }
    .feat-rfid__ripple { width: 28px; height: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-fingerprint::after,
    .feat-phone__pill::after,
    .feat-signal span,
    .feat-rfid__ripple,
    .feat-keypad__grid i.lit,
    .feat-log__row--active { animation: none !important; }
  }
{%- endstyle -%}

{%- comment -%} Section lifecycle: auto-hide when no feature blocks exist. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section
  id="otodor-features-{{ section.id }}"
  class="otodor-features"
  data-otodor-section="features"
  aria-labelledby="otodor-features-title-{{ section.id }}"
>
  <div class="otodor-container">
    <div class="otodor-features__header">
      <div class="otodor-features__header-text">
        <span class="otodor-eyebrow" data-otodor-reveal="fade-up">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="otodor-heading-2" id="otodor-features-title-{{ section.id }}" data-otodor-reveal="fade-up">
          {{ section.settings.heading | escape }}<span class="otodor-accent">{{ section.settings.heading_accent | escape }}</span>
        </h2>
      </div>
      {%- if section.settings.subheading != blank -%}
        <p class="otodor-features__subheading" data-otodor-reveal="fade-up">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="otodor-features__grid" data-otodor-stagger>
      {%- for block in section.blocks -%}
        {%- assign size = block.settings.tile_size | default: 'small' -%}
        <div class="otodor-feature-tile-glow otodor-feature-tile-glow--{{ size }} border-glow-card" data-border-glow {{ block.shopify_attributes }}>
          <span class="edge-light"></span>
          <div class="border-glow-inner">
        <div
          class="otodor-feature-tile otodor-feature-tile--{{ size }} otodor-glass-card otodor-glass-card--raised"
        >
          {%- comment -%} Motif layer {%- endcomment -%}
          {%- case block.settings.motif -%}
            {%- when 'fingerprint' -%}
              <div class="feat-motif feat-fingerprint" aria-hidden="true">
                <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                  <path d="M50 14a36 36 0 0 0-36 36"/>
                  <path d="M50 24a26 26 0 0 0-26 26v10"/>
                  <path d="M50 34a16 16 0 0 0-16 16v18"/>
                  <path d="M50 44a6 6 0 0 0-6 6v24"/>
                  <path d="M86 50a36 36 0 0 0-18-31"/>
                  <path d="M76 56v-6a26 26 0 0 0-13-22"/>
                  <path d="M66 68V50a16 16 0 0 0-8-14"/>
                  <path d="M56 74V50a6 6 0 0 0-3-5"/>
                </svg>
              </div>
            {%- when 'app' -%}
              <div class="feat-motif feat-app" aria-hidden="true">
                <div class="feat-phone">
                  <div class="feat-phone__pill"></div>
                  <div class="feat-phone__row"></div>
                  <div class="feat-phone__row feat-phone__row--short"></div>
                  <div class="feat-phone__row"></div>
                  <div class="feat-phone__row feat-phone__row--short"></div>
                </div>
              </div>
            {%- when 'signal' -%}
              <div class="feat-motif feat-signal" aria-hidden="true"><span></span><span></span><span></span></div>
            {%- when 'rfid' -%}
              <div class="feat-motif feat-rfid" aria-hidden="true">
                <div class="feat-rfid__card"></div>
                <div class="feat-rfid__ripple"></div>
              </div>
            {%- when 'keypad' -%}
              <div class="feat-motif feat-keypad" aria-hidden="true">
                <div class="feat-keypad__grid">
                  <i></i><i class="lit"></i><i></i><i></i><i></i><i class="lit"></i><i class="lit"></i><i></i><i class="lit"></i><i></i><i></i><i></i>
                </div>
              </div>
            {%- when 'log' -%}
              <div class="feat-motif feat-log" aria-hidden="true">
                <div class="feat-log__row feat-log__row--active"><i></i><b></b></div>
                <div class="feat-log__row"><i></i><b></b></div>
                <div class="feat-log__row"><i></i><b></b></div>
                <div class="feat-log__row feat-log__row--active"><i></i><b></b></div>
              </div>
          {%- endcase -%}

          {%- if size == 'large' and block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'otodor-feature-tile__render', alt: block.settings.title }}
          {%- endif -%}

          <div class="otodor-feature-tile__content">
            <div class="otodor-icon-wrap otodor-feature-tile__icon">
              {% render 'otodor-icon', name: block.settings.icon %}
            </div>
            <h3 class="otodor-feature-tile__title">{{ block.settings.title | escape }}</h3>
            <p class="otodor-feature-tile__desc">{{ block.settings.description | escape }}</p>
          </div>
        </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "OTODOR Key Features",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Core Technology" },
    { "type": "text", "id": "heading", "label": "Heading text", "default": "Smart security for modern " },
    { "type": "text", "id": "heading_accent", "label": "Heading accented text", "default": "homes." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every access point engineered with next-generation recognition and military-grade encryption." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Point",
      "settings": [
        {
          "type": "select",
          "id": "tile_size",
          "label": "Tile size",
          "default": "small",
          "options": [
            { "value": "large", "label": "Large (2x2 — hero)" },
            { "value": "wide", "label": "Wide (2x1)" },
            { "value": "small", "label": "Small (1x1)" }
          ]
        },
        {
          "type": "select",
          "id": "motif",
          "label": "Background motif",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "fingerprint", "label": "Fingerprint scan" },
            { "value": "app", "label": "Phone app" },
            { "value": "signal", "label": "Remote signal" },
            { "value": "rfid", "label": "RFID tap" },
            { "value": "keypad", "label": "PIN keypad" },
            { "value": "log", "label": "Audit log feed" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product render (large tile only)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "fingerprint",
          "options": [
            { "value": "fingerprint", "label": "Fingerprint Scanner" },
            { "value": "mobile", "label": "Mobile App Control" },
            { "value": "wifi", "label": "WiFi / Remote" },
            { "value": "tag", "label": "RFID Tag Access" },
            { "value": "keypad", "label": "PIN Keypad" },
            { "value": "clock", "label": "Activity Logs / Clock" },
            { "value": "shield", "label": "Shield / Security" }
          ]
        },
        { "type": "text", "id": "title", "label": "Feature Title", "default": "Fingerprint Access" },
        { "type": "textarea", "id": "description", "label": "Feature Description", "default": "Unlock instantly with a single touch using advanced 3D biometric recognition." }
      ]
    }
  ],
  "presets": [
    {
      "name": "OTODOR Key Features",
      "blocks": [
        { "type": "feature", "settings": { "tile_size": "large", "motif": "fingerprint", "icon": "fingerprint", "title": "Fingerprint Access", "description": "Unlock instantly with a single touch using advanced 3D biometric recognition." } },
        { "type": "feature", "settings": { "tile_size": "wide", "motif": "app", "icon": "mobile", "title": "Mobile App Control", "description": "Control lock status, manage temporary passcodes, and monitor entry from anywhere." } },
        { "type": "feature", "settings": { "tile_size": "small", "motif": "signal", "icon": "wifi", "title": "Remote Unlock", "description": "Grant access remotely in real-time when guests arrive." } },
        { "type": "feature", "settings": { "tile_size": "small", "motif": "rfid", "icon": "tag", "title": "RFID Access", "description": "Tap key cards or smart tags to enter instantly." } },
        { "type": "feature", "settings": { "tile_size": "wide", "motif": "keypad", "icon": "keypad", "title": "PIN Access", "description": "Custom access codes with anti-peep protection." } },
        { "type": "feature", "settings": { "tile_size": "wide", "motif": "log", "icon": "clock", "title": "Audit Logs", "description": "Real-time logs of exactly who entered and when." } }
      ]
    }
  ]
}
{% endschema %}
