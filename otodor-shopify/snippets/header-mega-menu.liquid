{% comment %}
  OTODOR premium mega menu for the header (desktop / tablet).

  DATA SOURCE: Shopify Navigation (section.settings.menu) — native and
  merchant-editable in Online Store → Navigation → Main Menu. The Shopify Main
  Menu is the single source of truth. This snippet renders a 3-level menu:
  top-level item → level-2 category columns → level-3 links, plus a FEATURED
  PANEL on the right that updates to match the hovered/focused category.

  Per-category extras come from the LINKED COLLECTION (never duplicated):
    • icon        — collection metafield custom.menu_icon (otodor-icon name)
    • description — custom.menu_description → collection.description
    • image       — custom.menu_image → collection.image → first product image
    • url/title   — the navigation link / collection
  Priority per field: collection metafield → collection data → placeholder.

  Open/close, ESC and focus handling stay with Dawn's <header-menu> +
  details/summary. A tiny scoped script only swaps the active featured panel
  (no AJAX, no reload). Mobile uses Dawn's drawer (header-drawer) — untouched.

  Usage: {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span {%- if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="otodor-mega page-width" data-otodor-mega>
                  {%- comment -%} ── Left: category columns (level-2 → level-3) ── {%- endcomment -%}
                  <div class="otodor-mega__nav">
                    <ul class="otodor-mega__columns" role="list">
                      {%- for childlink in link.links -%}
                        {%- liquid
                          assign col_icon = ''
                          assign col_desc = ''
                          if childlink.type == 'collection_link' and childlink.object != blank
                            assign col_obj = childlink.object
                            assign col_icon = col_obj.metafields.custom.menu_icon.value
                            assign col_desc = col_obj.metafields.custom.menu_description.value | default: col_obj.description
                          endif
                        -%}
                        <li class="otodor-mega__col">
                          <a
                            href="{{ childlink.url }}"
                            class="otodor-mega__col-head{% if childlink.current or childlink.child_active %} is-active{% endif %}"
                            data-otodor-feature-trigger="{{ forloop.index }}"
                            {% if childlink.current %}aria-current="page"{% endif %}
                          >
                            {%- if col_icon != blank -%}
                              <span class="otodor-mega__col-icon">{% render 'otodor-icon', name: col_icon %}</span>
                            {%- endif -%}
                            <span class="otodor-mega__col-title">{{ childlink.title | escape }}</span>
                          </a>

                          {%- if childlink.links != blank -%}
                            <ul class="otodor-mega__links" role="list">
                              {%- for grandchild in childlink.links -%}
                                <li>
                                  <a
                                    href="{{ grandchild.url }}"
                                    class="otodor-mega__link{% if grandchild.current %} is-active{% endif %}"
                                    {% if grandchild.current %}aria-current="page"{% endif %}
                                  >
                                    {%- if section.settings.mega_show_thumbnails and grandchild.type == 'product_link' and grandchild.object.featured_image != blank -%}
                                      <img
                                        class="otodor-mega__thumb"
                                        src="{{ grandchild.object.featured_image | image_url: width: 96 }}"
                                        width="40"
                                        height="40"
                                        loading="lazy"
                                        alt=""
                                      >
                                    {%- endif -%}
                                    <span>{{ grandchild.title | escape }}</span>
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- elsif col_desc != blank -%}
                            <p class="otodor-mega__col-desc">{{ col_desc | strip_html | truncatewords: 12 }}</p>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>

                  {%- comment -%} ── Right: featured panel (updates to the hovered category). Decorative — mirrors the column links, so hidden from AT. ── {%- endcomment -%}
                  <div class="otodor-mega__feature-wrap" aria-hidden="true">
                    {%- for childlink in link.links -%}
                      {%- liquid
                        assign feat_image = ''
                        assign feat_desc = ''
                        if childlink.type == 'collection_link' and childlink.object != blank
                          assign fc = childlink.object
                          assign feat_image = fc.metafields.custom.menu_image.value | default: fc.image
                          if feat_image == blank and fc.products.first != blank
                            assign feat_image = fc.products.first.featured_image
                          endif
                          assign feat_desc = fc.metafields.custom.menu_description.value | default: fc.description
                        endif
                      -%}
                      <div
                        class="otodor-mega__feature{% if forloop.first %} is-active{% endif %}"
                        data-otodor-feature-panel="{{ forloop.index }}"
                      >
                        <span class="otodor-mega__feature-media">
                          {%- if feat_image != blank -%}
                            {{ feat_image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '380,570,760', sizes: '360px', alt: '', class: 'otodor-mega__feature-img' }}
                          {%- endif -%}
                        </span>
                        <div class="otodor-mega__feature-body">
                          <p class="otodor-mega__feature-title">{{ childlink.title | escape }}</p>
                          {%- if feat_desc != blank -%}
                            <p class="otodor-mega__feature-desc">{{ feat_desc | strip_html | truncatewords: 20 }}</p>
                          {%- endif -%}
                          <a href="{{ childlink.url }}" class="otodor-mega__feature-link" tabindex="-1">
                            {{ section.settings.mega_featured_label | default: 'Shop collection' | escape }}
                            {% render 'otodor-icon', name: 'arrow-right', class: 'otodor-mega__feature-arrow' %}
                          </a>
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>

                  {%- comment -%} ── Footer: persistent "Get a Custom Quote" CTA ── {%- endcomment -%}
                  {%- if section.settings.mega_show_cta -%}
                    {%- assign mega_cta_url = section.settings.mega_cta_button_link | default: routes.root_url -%}
                    <aside class="otodor-mega__cta">
                      {%- if section.settings.mega_cta_image != blank -%}
                        <span class="otodor-mega__cta-media">
                          {{ section.settings.mega_cta_image | image_url: width: 680 | image_tag: loading: 'lazy', widths: '340,680', sizes: '340px', alt: '', class: 'otodor-mega__cta-img' }}
                        </span>
                      {%- endif -%}
                      <div class="otodor-mega__cta-body">
                        {%- if section.settings.mega_cta_heading != blank -%}
                          <p class="otodor-mega__cta-heading">{{ section.settings.mega_cta_heading | escape }}</p>
                        {%- endif -%}
                        {%- if section.settings.mega_cta_text != blank -%}
                          <p class="otodor-mega__cta-text">{{ section.settings.mega_cta_text | escape }}</p>
                        {%- endif -%}
                      </div>
                      {%- if section.settings.mega_cta_button_label != blank -%}
                        <a href="{{ mega_cta_url }}" class="otodor-mega__cta-button">
                          {{ section.settings.mega_cta_button_label | escape }}
                          {% render 'otodor-icon', name: 'arrow-right', class: 'otodor-mega__cta-arrow' %}
                        </a>
                      {%- endif -%}
                    </aside>
                  {%- endif -%}
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span {%- if link.current %} class="header__active-menu-item"{% endif %}>
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

<script>
  (function () {
    if (window.otodorMegaInit) return;
    window.otodorMegaInit = true;

    var desktop = window.matchMedia('(hover: hover) and (min-width: 990px)');

    // 1) Featured panel: swap the active preview to the hovered/focused category.
    var bindFeature = function (mega) {
      if (mega.dataset.otodorFeatureBound) return;
      mega.dataset.otodorFeatureBound = '1';
      var panels = mega.querySelectorAll('[data-otodor-feature-panel]');
      if (!panels.length) return;
      var setActive = function (id) {
        for (var i = 0; i < panels.length; i++) {
          panels[i].classList.toggle('is-active', panels[i].getAttribute('data-otodor-feature-panel') === id);
        }
      };
      var triggers = mega.querySelectorAll('[data-otodor-feature-trigger]');
      for (var t = 0; t < triggers.length; t++) {
        (function (trigger) {
          var id = trigger.getAttribute('data-otodor-feature-trigger');
          trigger.addEventListener('mouseenter', function () { setActive(id); });
          trigger.addEventListener('focus', function () { setActive(id); });
        })(triggers[t]);
      }
      var nav = mega.querySelector('.otodor-mega__nav');
      if (nav) {
        nav.addEventListener('mouseleave', function () {
          setActive(triggers.length ? triggers[0].getAttribute('data-otodor-feature-trigger') : '1');
        });
      }
    };

    // 2) Hover-intent: open on hover with a short close delay (Dawn opens on
    //    click only). Keyboard focus/focusout and Esc keep working.
    var bindHover = function (menu) {
      if (menu.dataset.otodorHoverBound) return;
      menu.dataset.otodorHoverBound = '1';
      var details = menu.querySelector('details.mega-menu');
      if (!details) return;
      var summary = details.querySelector('summary');
      var timer;
      var open = function () {
        if (!desktop.matches) return;
        clearTimeout(timer);
        if (!details.open) {
          details.open = true;
          if (summary) summary.setAttribute('aria-expanded', 'true');
        }
      };
      var scheduleClose = function () {
        if (!desktop.matches) return;
        clearTimeout(timer);
        timer = setTimeout(function () {
          if (details.contains(document.activeElement)) return; // keyboard user inside
          details.open = false;
          if (summary) summary.setAttribute('aria-expanded', 'false');
        }, 200);
      };
      menu.addEventListener('mouseenter', open);
      menu.addEventListener('mouseleave', scheduleClose);
      menu.addEventListener('focusin', function () { clearTimeout(timer); });
      menu.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && details.open) {
          details.open = false;
          if (summary) { summary.setAttribute('aria-expanded', 'false'); summary.focus(); }
        }
      });
    };

    var init = function () {
      var megas = document.querySelectorAll('[data-otodor-mega]');
      for (var i = 0; i < megas.length; i++) bindFeature(megas[i]);
      var menus = document.querySelectorAll('.header__inline-menu header-menu');
      for (var j = 0; j < menus.length; j++) bindHover(menus[j]);
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
