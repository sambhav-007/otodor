{% comment %}
  OTODOR premium mega menu for the header.

  DATA SOURCE: Shopify Navigation (section.settings.menu) — native and
  merchant-editable in Online Store → Navigation → Main Menu. This snippet
  renders a 3-level menu: top-level item → level-2 columns → level-3 links.

  Per-column extras are read from the LINKED COLLECTION (never duplicated):
    • icon        — collection metafield custom.menu_icon (an otodor-icon name)
    • description — collection metafield custom.menu_description, else the
                    collection description
    • thumbnails  — product's featured image (when a link points to a product
                    and "Show product thumbnails" is enabled)

  Interaction (details/summary + <header-menu>) is Dawn's, kept intact.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="otodor-mega page-width">
                  <ul class="otodor-mega__columns" role="list">
                    {%- for childlink in link.links -%}
                      {%- liquid
                        assign col_icon = ''
                        assign col_desc = ''
                        if childlink.type == 'collection_link' and childlink.object != blank
                          assign col_obj = childlink.object
                          assign col_icon = col_obj.metafields.custom.menu_icon.value
                          assign col_desc = col_obj.metafields.custom.menu_description.value | default: col_obj.description
                        endif
                      -%}
                      <li class="otodor-mega__col">
                        <a
                          href="{{ childlink.url }}"
                          class="otodor-mega__col-head{% if childlink.current or childlink.child_active %} is-active{% endif %}"
                          {% if childlink.current %}aria-current="page"{% endif %}
                        >
                          {%- if col_icon != blank -%}
                            <span class="otodor-mega__col-icon">{% render 'otodor-icon', name: col_icon %}</span>
                          {%- endif -%}
                          <span class="otodor-mega__col-title">{{ childlink.title | escape }}</span>
                        </a>

                        {%- if col_desc != blank -%}
                          <p class="otodor-mega__col-desc">{{ col_desc | strip_html | truncatewords: 12 }}</p>
                        {%- endif -%}

                        {%- if childlink.links != blank -%}
                          <ul class="otodor-mega__links" role="list">
                            {%- for grandchild in childlink.links -%}
                              <li>
                                <a
                                  href="{{ grandchild.url }}"
                                  class="otodor-mega__link{% if grandchild.current %} is-active{% endif %}"
                                  {% if grandchild.current %}aria-current="page"{% endif %}
                                >
                                  {%- if section.settings.mega_show_thumbnails and grandchild.type == 'product_link' and grandchild.object.featured_image != blank -%}
                                    <img
                                      class="otodor-mega__thumb"
                                      src="{{ grandchild.object.featured_image | image_url: width: 96 }}"
                                      width="40"
                                      height="40"
                                      loading="lazy"
                                      alt=""
                                    >
                                  {%- endif -%}
                                  <span>{{ grandchild.title | escape }}</span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>

                  {%- if section.settings.mega_show_cta -%}
                    {%- assign mega_cta_url = section.settings.mega_cta_button_link | default: routes.root_url -%}
                    <aside class="otodor-mega__cta"{% if section.settings.mega_cta_image != blank %} style="--otodor-mega-cta-image: url('{{ section.settings.mega_cta_image | image_url: width: 720 }}')"{% endif %}>
                      {%- if section.settings.mega_cta_image != blank -%}
                        <span class="otodor-mega__cta-media" aria-hidden="true"></span>
                      {%- endif -%}
                      <div class="otodor-mega__cta-body">
                        {%- if section.settings.mega_cta_heading != blank -%}
                          <p class="otodor-mega__cta-heading">{{ section.settings.mega_cta_heading | escape }}</p>
                        {%- endif -%}
                        {%- if section.settings.mega_cta_text != blank -%}
                          <p class="otodor-mega__cta-text">{{ section.settings.mega_cta_text | escape }}</p>
                        {%- endif -%}
                        {%- if section.settings.mega_cta_button_label != blank -%}
                          <a href="{{ mega_cta_url }}" class="otodor-mega__cta-button">
                            {{ section.settings.mega_cta_button_label | escape }}
                            {% render 'otodor-icon', name: 'arrow-right', class: 'otodor-mega__cta-arrow' %}
                          </a>
                        {%- endif -%}
                      </div>
                    </aside>
                  {%- endif -%}
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
