{%- comment -%}
  OTODOR — Inline SVG Icon System
  Rendered as: {% render 'otodor-icon', name: 'icon-name', class: 'custom-class' %}
{%- endcomment -%}

{%- liquid
  assign icon_class = class | default: ''
-%}

{%- case name -%}
  {%- when 'installation' or 'wrench' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l4-4a1 1 0 0 0-1.4-1.4l-4 4a1 1 0 0 0-1.6-1.6l4-4a1 1 0 0 0-1.4-1.4l-4 4zm-9.8 9.8L3 21l5.1-1.9 6.8-6.8-3.2-3.2-6.8 6.8zm11.2-2.1l3.2 3.2c1.2 1.2.3 3.3-1.4 3.3H16c-1.1 0-2-.9-2-2v-1.1c0-.5-.2-1-.6-1.4L10.3 16l3.2-3.2 2.6 3.2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'warranty' or 'shield' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M9 11l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'app' or 'mobile' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="5" y="2" width="14" height="20" rx="3" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 18h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M9 5h6" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
    </svg>

  {%- when 'smart' or 'key' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.778-7.778zm0 0L15.5 7.5m0 0l1.5 1.5M15.5 7.5l1.5-1.5M18.5 4.5l1.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'fingerprint' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2a10 10 0 0 0-10 10m20 0a10 10 0 0 0-10-10m-3 7a5 5 0 0 1 6 0m-8.83 5.17a7 7 0 0 1 11.66 0M9.5 17a3 3 0 0 1 5 0m-7.83 2.83a9 9 0 0 1 10.66 0M6 12a6 6 0 0 1 12 0v2a4 4 0 0 1-8 0v-2a2 2 0 0 1 4 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'remote' or 'wifi' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M5 12.55a11 11 0 0 1 14 0M8.5 16.05a6 6 0 0 1 7 0M12 20h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'rfid' or 'tag' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9.5 2h5A3.5 3.5 0 0 1 18 5.5v13a3.5 3.5 0 0 1-3.5 3.5h-5A3.5 3.5 0 0 1 6 18.5v-13A3.5 3.5 0 0 1 9.5 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'pin' or 'keypad' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="3" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="15" y="3" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="3" y="15" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="15" y="15" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
    </svg>

  {%- when 'log' or 'clock' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'star' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
    </svg>

  {%- when 'chevron-right' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M5 12h14M14 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- else -%}
    {%- comment -%} Default fallback: question mark icon {%- endcomment -%}
    <svg class="{{ icon_class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
