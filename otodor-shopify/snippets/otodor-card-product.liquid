{%- comment -%}
  OTODOR product card — technology-first, light surface.
  Product on neutral plinth, name, access methods, price.

  Accepts:
  - card_product: {Object} Product object
  - lazy:         {Boolean} lazy-load images (default true)

  Access-method line resolution order:
  1. product.metafields.custom.access_methods (single-line text, e.g. "Fingerprint · PIN · App")
  2. product.type
{%- endcomment -%}

{%- liquid
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign access_line = card_product.metafields.custom.access_methods.value | default: card_product.type

  # ── Is this product actually discounted? ────────────────────────────
  # Shopify's own definition: a compare-at price above the selling price.
  # Set both on the product in admin and the card does the rest — the
  # struck price, the badge and the saving are all derived, never typed.
  assign on_sale = false
  if card_product.compare_at_price > card_product.price and card_product.price > 0
    assign on_sale = true
    assign save_amount = card_product.compare_at_price | minus: card_product.price
    # Prices are in paise, so the ratio is unaffected by the unit.
    assign save_pct = save_amount | times: 100 | divided_by: card_product.compare_at_price
  endif
-%}

<a href="{{ card_product.url }}" class="otodor-pcard" aria-label="{{ card_product.title | escape }}">
  <div class="otodor-pcard__media">
    {%- if card_product.featured_media -%}
      {{
        card_product.featured_media
        | image_url: width: 720
        | image_tag:
          class: 'otodor-pcard__img otodor-pcard__img--primary',
          loading: loading,
          widths: '360,540,720',
          sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
          alt: card_product.featured_media.alt
      }}
      {%- if card_product.media[1] != blank and card_product.media[1].media_type == 'image' -%}
        {{
          card_product.media[1]
          | image_url: width: 720
          | image_tag:
            class: 'otodor-pcard__img otodor-pcard__img--alt',
            loading: 'lazy',
            widths: '360,540,720',
            sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
            alt: card_product.media[1].alt
        }}
      {%- endif -%}
    {%- else -%}
      <span class="otodor-pcard__placeholder" aria-hidden="true">OTODOR</span>
    {%- endif -%}

    {%- comment -%}
      Sold out outranks a saving — there is no point advertising a discount
      on something that cannot be bought.
    {%- endcomment -%}
    {%- unless card_product.available -%}
      <span class="otodor-pcard__badge">Sold out</span>
    {%- else -%}
      {%- if on_sale and save_pct > 0 -%}
        <span class="otodor-pcard__badge otodor-pcard__badge--save">{{ save_pct }}% off</span>
      {%- endif -%}
    {%- endunless -%}
  </div>

  <div class="otodor-pcard__info">
    <h3 class="otodor-pcard__title">{{ card_product.title | escape }}</h3>
    {%- if access_line != blank -%}
      <p class="otodor-pcard__meta">{{ access_line | escape }}</p>
    {%- endif -%}
    {%- if card_product.price == 0 -%}
      <p class="otodor-pcard__price otodor-pcard__price--contact">Contact for pricing</p>
    {%- else -%}
      {%- comment -%}
        Selling price first and loudest, the old price struck after it. The
        eye should land on what the thing costs today, not on the number it
        no longer costs.
      {%- endcomment -%}
      <p class="otodor-pcard__price">
        <span class="otodor-pcard__price-now">{{ card_product.price | money }}</span>
        {%- if on_sale -%}
          <s class="otodor-pcard__price-was">{{ card_product.compare_at_price | money }}</s>
        {%- endif -%}
      </p>

      {%- comment -%}
        Delivery and EMI come from Theme settings → OTODOR Offers, Pricing &
        EMI, so the card, the popup, the promo strip and the product page all
        quote one policy. Switch either off in settings and it leaves every
        card at once.
      {%- endcomment -%}
      {%- if settings.otodor_free_delivery or settings.otodor_emi_enabled -%}
        <p class="otodor-pcard__perks">
          {%- if settings.otodor_free_delivery and settings.otodor_free_delivery_label != blank -%}
            <span>{{ settings.otodor_free_delivery_label | escape }}</span>
          {%- endif -%}
          {%- if settings.otodor_emi_enabled -%}
            <span>EMI available</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</a>
