    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which doors are OTODOR digital locks compatible with?",
            "row_content": "<p>Wooden, glass and metal doors, plus smart padlocks. Each range is engineered for its door type — tell us your door and we'll confirm compatibility before installation.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What access methods are supported?",
            "row_content": "<p>Face recognition, fingerprint, RFID card, PIN, physical key and the OTODOR app — depending on the model.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What warranty and support do I get?",
            "row_content": "<p>A 3-year warranty on the lock and 1-year on the battery, with PAN-India professional installation across 10,000+ PIN codes and 24/7 support.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is there an installation clearance requirement?",
            "row_content": "<p>Yes — keep a minimum 85 mm (3.35&quot;) gap between the safety door and the main door so the lock never contacts the safety door.</p>"
          }
        }
      },
