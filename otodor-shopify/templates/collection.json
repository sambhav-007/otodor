/*
 * ------------------------------------------------------------
 * OTODOR generic collection framework (category-agnostic).
 * Inherited by every collection. Empty slots (selector/features/
 * why) auto-hide, so a plain collection degrades to hero -> grid.
 * The selector runs in `auto` mode: any parent collection shows its
 * sub-categories straight from Navigation (or from child collections
 * via custom.parent_collection) with no per-collection template.
 * Category landings (e.g. collection.digital-locks.json) reuse this
 * same composition with data — see OTODOR-COLLECTION-TEMPLATE.md.
 * The theme editor / Shopify admin may rewrite this file.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "hero": {
      "type": "otodor-collection-hero",
      "settings": {
        "eyebrow": "OTODOR",
        "fallback_line": "Smart security engineered for modern homes.",
        "show_count": true,
        "moment_line": "Security designed around how people actually live.",
        "moment_sub": "Every OTODOR device is engineered, installed, and supported by us."
      }
    },
    "selector": {
      "type": "otodor-category-selector",
      "settings": {
        "source": "auto",
        "menu": "main-menu",
        "eyebrow": "Find your fit",
        "heading": "Choose your",
        "heading_accent": "category.",
        "subheading": "",
        "color_scheme": "light",
        "show_cta": false
      }
    },
    "product-grid": {
      "type": "otodor-collection-grid",
      "settings": {
        "products_per_page": 12,
        "show_sort": true,
        "show_cta": true,
        "cta_title": "Not sure which fits your door?",
        "cta_sub": "We verify compatibility before installation — talk to a specialist.",
        "cta_button_label": "Talk to us"
      }
    },
    "comparison": {
      "type": "otodor-comparison",
      "settings": {
        "eyebrow": "Compare the range",
        "heading": "Every model, ",
        "heading_accent": "side by side.",
        "max_products": 5
      }
    },
    "features": {
      "type": "otodor-features",
      "settings": {
        "eyebrow": "Core Technology",
        "heading": "Built for",
        "heading_accent": "everyday security.",
        "subheading": ""
      }
    },
    "why": {
      "type": "otodor-why",
      "settings": {
        "eyebrow": "Why OTODOR"
      }
    }
  },
  "order": [
    "hero",
    "selector",
    "product-grid",
    "comparison",
    "features",
    "why"
  ]
}
